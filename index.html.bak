function initials(name) {
  if (!name) return '?';
  return name.trim().split(/\s+/).slice(0, 2).map(w => w[0].toUpperCase()).join('');
}

function isUserPremium(user) {
  if (!user) return false;
  if (user.isPremium === true) return true;
  if (typeof user.followersCount === 'number' && user.followersCount >= 3) return true;
  return false;
}

function premiumBadgeHTML(user) {
  if (isUserPremium(user)) {
    return `<span class="badge-premium" title="VIP Premium Creator">👑 VIP</span>`;
  }
  return '';
}

function avatarHTML(user, size) {
  const isVip = isUserPremium(user) && (user?.settings?.vipGlow !== false);
  const cls = 'avatar' + (size ? ' ' + size : '') + (isVip ? ' vip-avatar' : '');
  if (user && user.avatar) return `<div class="${cls}" style="background-image:url('${user.avatar}')"></div>`;
  return `<div class="${cls}">${initials(user ? (user.name || user.username) : '?')}</div>`;
}

function toDate(val) {
  if (!val) return new Date();
  if (typeof val.toDate === 'function') return val.toDate();
  if (val instanceof Date) return val;
  const d = new Date(val);
  return isNaN(d.getTime()) ? new Date() : d;
}

function timeAgo(dateVal) {
  if (!dateVal) return '';
  const date = toDate(dateVal);
  const s = Math.floor((Date.now() - date.getTime()) / 1000);
  if (s < 60) return 'just now';
  if (s < 3600) return Math.floor(s / 60) + 'm';
  if (s < 86400) return Math.floor(s / 3600) + 'h';
  if (s < 604800) return Math.floor(s / 86400) + 'd';
  return date.toLocaleDateString();
}

function timeShort(dateVal) {
  if (!dateVal) return '';
  return toDate(dateVal).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
}

function escapeHTML(str) {
  const d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML;
}

function toast(msg) {
  const el = document.createElement('div');
  el.className = 'toast';
  el.textContent = msg;
  document.getElementById('toastWrap').appendChild(el);
  setTimeout(() => el.remove(), 4000);
}

/* ==================================================================
   AUTH (REGISTRATION & LOGIN)
   ================================================================== */
let authMode = 'login';
const authForm = document.getElementById('authForm');
const authError = document.getElementById('authError');


// Modern Login Segmented Switcher & Demo Login Handlers
const segLoginBtn = document.getElementById('segLoginBtn');
const segRegisterBtn = document.getElementById('segRegisterBtn');
if (segLoginBtn && segRegisterBtn) {
  segLoginBtn.onclick = () => {
    segLoginBtn.classList.add('active');
    segRegisterBtn.classList.remove('active');
    authMode = 'login';
    document.getElementById('nameField').classList.add('hidden');
    document.getElementById('emailField').classList.add('hidden');
    document.getElementById('userLabel').textContent = 'Username or email';
    document.getElementById('authTitle').textContent = 'Welcome back';
    document.getElementById('authSub').textContent = 'Log in to pick up where today left off.';
    document.getElementById('authSubmitBtn').textContent = 'Log in';
  };
  segRegisterBtn.onclick = () => {
    segRegisterBtn.classList.add('active');
    segLoginBtn.classList.remove('active');
    authMode = 'register';
    document.getElementById('nameField').classList.remove('hidden');
    document.getElementById('emailField').classList.remove('hidden');
    document.getElementById('userLabel').textContent = 'Username';
    document.getElementById('authTitle').textContent = 'Create account';
    document.getElementById('authSub').textContent = 'Join the Your Day community.';
    document.getElementById('authSubmitBtn').textContent = 'Create account';
  };
}

const togglePasswordBtn = document.getElementById('togglePasswordBtn');
if (togglePasswordBtn) {
  togglePasswordBtn.onclick = () => {
    const input = document.getElementById('authPassword');
    if (input.type === 'password') {
      input.type = 'text';
      togglePasswordBtn.textContent = '🔒';
    } else {
      input.type = 'password';
      togglePasswordBtn.textContent = '👁';
    }
  };
}

document.getElementById('authToggleBtn').addEventListener('click', () => {
  authMode = authMode === 'login' ? 'register' : 'login';
  const isReg = authMode === 'register';
  document.getElementById('nameField').classList.toggle('hidden', !isReg);
  document.getElementById('emailField').classList.toggle('hidden', !isReg);
  document.getElementById('userLabel').textContent = isReg ? 'Username' : 'Username or email';
  document.getElementById('authTitle').textContent = isReg ? 'Start Your Day' : 'Welcome back';
  document.getElementById('authSub').textContent = isReg ? 'A few details and you\'re in.' : 'Log in to pick up where today left off.';
  document.getElementById('authSubmitBtn').textContent = isReg ? 'Create account' : 'Log in';
  document.getElementById('authToggleText').textContent = isReg ? 'Already have an account?' : 'New here?';
  document.getElementById('authToggleBtn').textContent = isReg ? 'Log in' : 'Create an account';
  authError.style.display = 'none';
});

authForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  authError.style.display = 'none';
  if (!auth) return;
  const submitBtn = document.getElementById('authSubmitBtn');
  submitBtn.disabled = true;
  submitBtn.classList.add('is-busy');
  showLoader();

  const usernameInput = document.getElementById('authUsername').value.trim();
  const password = document.getElementById('authPassword').value;

  try {
    if (authMode === 'register') {
      const name = document.getElementById('regName').value.trim();
      const email = document.getElementById('regEmail').value.trim();
      const username = usernameInput.toLowerCase();

      if (!name || !email || !username || !password) throw new Error('All fields are required.');
      if (!/^[a-zA-Z0-9_.]{3,20}$/.test(username)) {
        throw new Error('Username must be 3-20 characters: letters, numbers, _ or .');
      }

      try {
        const userSnap = await db.collection('users').where('username', '==', username).limit(1).get();
        if (!userSnap.empty) throw new Error('Username already taken. Please choose another.');
      } catch (err) {
        if (err.message && err.message.includes('already taken')) throw err;
      }

      const cred = await auth.createUserWithEmailAndPassword(email, password);
      await cred.user.updateProfile({ displayName: name });

      const newUserData = {
        id: cred.user.uid,
        uid: cred.user.uid,
        username,
        name,
        email: email.toLowerCase(),
        bio: '',
        mood: '✨ Feeling inspired',
        avatar: '',
        isOnline: true,
        isPrivate: false,
        followersCount: 0,
        followingCount: 0,
        isPremium: false,
        lastSeen: firebase.firestore.FieldValue.serverTimestamp(),
        settings: DEFAULT_SETTINGS,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      };
      await db.collection('users').doc(cred.user.uid).set(newUserData);
      state.me = newUserData;
      state.userCache.set(cred.user.uid, newUserData);
      await boot();
    } else {
      let email = usernameInput;
      if (!usernameInput.includes('@')) {
        try {
          const snap = await db.collection('users').where('username', '==', usernameInput.toLowerCase()).limit(1).get();
          if (!snap.empty) email = snap.docs[0].data().email;
        } catch (err) {}
      }
      if (!email) throw new Error('No user found for "' + usernameInput + '". Try logging in with your email address.');
      await auth.signInWithEmailAndPassword(email, password);
    }
  } catch (err) {
    authError.textContent = err.message;
    authError.style.display = 'block';
  } finally {
    submitBtn.disabled = false;
    submitBtn.classList.remove('is-busy');
    hideLoader();
  }
});

document.getElementById('logoutBtn').addEventListener('click', handleLogout);
document.getElementById('settingsLogoutBtn').addEventListener('click', handleLogout);

async function handleLogout() {
  showLoader();
  if (state.me && db) {
    try {
      await db.collection('users').doc(state.me.uid).update({
        isOnline: false,
        lastSeen: firebase.firestore.FieldValue.serverTimestamp()
      });
    } catch (e) {}
  }
  if (auth) await auth.signOut();
  location.reload();
}

function setupAuthObserver() {
  auth.onAuthStateChanged(async (user) => {
    if (user) {
      showLoader();
      try {
        let userDoc = await db.collection('users').doc(user.uid).get();
        if (!userDoc.exists) {
          const fallback = {
            id: user.uid,
            uid: user.uid,
            username: (user.displayName || user.email.split('@')[0]).toLowerCase().replace(/[^a-z0-9_.]/g, ''),
            name: user.displayName || user.email.split('@')[0],
            email: user.email.toLowerCase(),
            bio: '',
            mood: '✨ Feeling inspired',
            avatar: user.photoURL || '',
            isOnline: true,
            isPrivate: false,
            followersCount: 0,
            followingCount: 0,
            isPremium: false,
            lastSeen: firebase.firestore.FieldValue.serverTimestamp(),
            settings: DEFAULT_SETTINGS,
            createdAt: firebase.firestore.FieldValue.serverTimestamp()
          };
          await db.collection('users').doc(user.uid).set(fallback);
          userDoc = await db.collection('users').doc(user.uid).get();
        }
        state.me = { id: userDoc.id, uid: userDoc.id, ...userDoc.data() };
        state.userCache.set(user.uid, state.me);

        // Apply all saved settings immediately
        applyAllVisualSettings(state.me.settings || {});

        const chatHandleEl = document.getElementById('chatHeaderHandleText');
        if (chatHandleEl && state.me.username) {
          chatHandleEl.textContent = state.me.username;
        }

        await db.collection('users').doc(user.uid).update({
          isOnline: true,
          lastSeen: firebase.firestore.FieldValue.serverTimestamp()
        }).catch(() => {});

        await Promise.all([loadFollowingCache(), loadBookmarksCache(), fetchUsersCacheViaRest()]);

        boot();
      } catch (err) {
        console.error('Error fetching profile:', err);
        toast('Error loading profile: ' + err.message);
      } finally {
        hideLoader();
      }
    } else {
      document.getElementById('authView').style.display = 'flex';
      document.getElementById('appView').classList.remove('active');
    }
  });
}

async function loadFollowingCache() {
  if (!state.me) return;
  try {
    const snap = await db.collection('follows').where('followerId', '==', state.me.uid).get();
    state.followingUserIds = new Set(snap.docs.map(d => d.data().followingId));
  } catch (e) {
    console.warn('Following cache notice:', e);
  }
}

async function loadBookmarksCache() {
  if (!state.me) return;
  try {
    const snap = await db.collection('bookmarks').where('userId', '==', state.me.uid).get();
    state.myBookmarks = new Set(snap.docs.map(d => d.data().postId));
  } catch (e) {}
}

window.addEventListener('beforeunload', () => {
  if (state.me && db) {
    db.collection('users').doc(state.me.uid).update({
      isOnline: false,
      lastSeen: firebase.firestore.FieldValue.serverTimestamp()
    }).catch(() => {});
  }
});

