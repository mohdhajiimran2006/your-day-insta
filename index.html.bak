});

// App PIN Lock Setup
document.getElementById('setupPinLockBtn')?.addEventListener('click', () => {
  const key = 'ydd_pin_' + state.me?.uid;
  const existing = localStorage.getItem(key);
  if (existing) {
    if (confirm('Remove your 4-digit App PIN lock?')) {
      localStorage.removeItem(key);
      loadSettings();
      toast('App PIN lock removed 🔓');
    }
    return;
  }
  const pin = prompt('Enter a new 4-digit PIN to protect your account:');
  if (pin && /^\d{4}$/.test(pin.trim())) {
    localStorage.setItem(key, pin.trim());
    loadSettings();
    toast('4-digit PIN lock enabled 🔐');
  } else if (pin !== null) {
    toast('Please enter exactly 4 digits (e.g. 1234).');
  }
});

// Creator Analytics & Insights Modal
document.getElementById('openInsightsBtn')?.addEventListener('click', async () => {
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal">
      <div class="row between" style="margin-bottom:14px;">
        <h3>📊 Creator Studio Insights</h3>
        <button class="btn btn-icon btn-ghost" id="closeInsightsBtn">✕</button>
      </div>
      <div id="insightsBody"><div class="empty">Calculating reach…</div></div>
    </div>`;
  document.body.appendChild(overlay);
  overlay.querySelector('#closeInsightsBtn').onclick = () => overlay.remove();

  try {
    const snap = await db.collection('posts').where('userId', '==', state.me.uid).get();
    let totalPosts = snap.size;
    let totalLikes = 0;
    let totalViews = 0;
    let totalComments = 0;
    let totalReels = 0;
    snap.docs.forEach(d => {
      const p = d.data();
      totalLikes += Array.isArray(p.likedBy) ? new Set(p.likedBy).size : (p.likeCount || 0);
      totalViews += Array.isArray(p.viewedBy) ? new Set(p.viewedBy).size : (p.viewsCount || 0);
      totalComments += p.commentCount || 0;
      if (p.video || p.isReel) totalReels++;
    });
    overlay.querySelector('#insightsBody').innerHTML = `
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">
        <div style="background:var(--ink-800);padding:14px;border-radius:14px;border:1px solid var(--line-soft);">
          <div style="font-size:24px;font-weight:800;color:var(--amber);">${totalViews}</div>
          <div class="muted" style="font-size:12px;">Unique Post &amp; Reel Views</div>
        </div>
        <div style="background:var(--ink-800);padding:14px;border-radius:14px;border:1px solid var(--line-soft);">
          <div style="font-size:24px;font-weight:800;color:var(--rose);">${totalLikes}</div>
          <div class="muted" style="font-size:12px;">Total Likes Received</div>
        </div>
        <div style="background:var(--ink-800);padding:14px;border-radius:14px;border:1px solid var(--line-soft);">
          <div style="font-size:24px;font-weight:800;color:var(--sage);">${totalPosts} (${totalReels} Reels)</div>
          <div class="muted" style="font-size:12px;">Published Posts &amp; Reels</div>
        </div>
        <div style="background:var(--ink-800);padding:14px;border-radius:14px;border:1px solid var(--line-soft);">
          <div style="font-size:24px;font-weight:800;color:var(--paper);">${totalComments}</div>
          <div class="muted" style="font-size:12px;">Total Comments</div>
        </div>
      </div>
      <div style="font-size:12.5px;color:var(--paper-dim);text-align:center;">Account Status: <b>${isUserPremium(state.me) ? '👑 Verified PRO Creator' : 'Standard Creator'}</b></div>
    `;
  } catch (e) {
    overlay.querySelector('#insightsBody').innerHTML = `<div class="empty">${escapeHTML(e.message)}</div>`;
  }
});

