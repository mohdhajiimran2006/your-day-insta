// WEB AUDIO POLYPHONIC MUSIC PLAYER FOR REELS & POSTS
let activeMusicInterval = null;
let activeMusicCtx = null;
let activeMusicTrackId = null;
let activeCustomAudioEl = null;

function stopSynthMusic() {
  if (activeMusicInterval) {
    clearInterval(activeMusicInterval);
    activeMusicInterval = null;
  }
  if (activeCustomAudioEl) {
    try { activeCustomAudioEl.pause(); } catch (e) {}
    activeCustomAudioEl = null;
  }
  activeMusicTrackId = null;
  document.querySelectorAll('.music-play-indicator').forEach(el => { el.textContent = '▶ Play Song'; });
}

window.togglePlaySynthTrack = function(trackId, btnEl, customAudioUrl) {
  if (activeMusicTrackId === trackId && (activeMusicInterval || activeCustomAudioEl)) {
    stopSynthMusic();
    return false;
  }
  stopSynthMusic();
  const volPref = parseFloat(state.me?.settings?.musicVolume || '0.5');
  if (volPref <= 0) {
    toast('Music volume is muted in Settings.');
    return false;
  }

  activeMusicTrackId = trackId;
  if (btnEl) {
    const ind = btnEl.querySelector('.music-play-indicator');
    if (ind) ind.textContent = '⏸ Playing…';
  }

  if (customAudioUrl) {
    activeCustomAudioEl = new Audio(customAudioUrl);
    activeCustomAudioEl.loop = true;
    activeCustomAudioEl.volume = Math.min(1, volPref);
    activeCustomAudioEl.play().catch(() => {});
    return true;
  }

  const track = INSTAGRAM_MUSIC_LIBRARY.find(t => t.id === trackId) || INSTAGRAM_MUSIC_LIBRARY[0];
  try {
    if (!activeMusicCtx) activeMusicCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (activeMusicCtx.state === 'suspended') activeMusicCtx.resume();
    let step = 0;
    const stepMs = Math.round((60 / track.bpm) * 500);

    const playNote = () => {
      if (!activeMusicCtx) return;
      const freq = track.notes[step % track.notes.length];
      step++;
      const osc = activeMusicCtx.createOscillator();
      const gain = activeMusicCtx.createGain();
      osc.type = track.wave || 'sine';
      osc.frequency.setValueAtTime(freq, activeMusicCtx.currentTime);
      gain.gain.setValueAtTime(0.001, activeMusicCtx.currentTime);
      gain.gain.linearRampToValueAtTime(0.09 * volPref, activeMusicCtx.currentTime + 0.04);
      gain.gain.exponentialRampToValueAtTime(0.0008, activeMusicCtx.currentTime + (stepMs / 1000) * 0.92);
      osc.connect(gain);
      gain.connect(activeMusicCtx.destination);
      osc.start();
      osc.stop(activeMusicCtx.currentTime + (stepMs / 1000));
    };
    playNote();
    activeMusicInterval = setInterval(playNote, stepMs);
    return true;
  } catch (e) {
    return false;
  }
};

async function loadReels() {
  const container = document.getElementById('reelsFeedContainer');
  if (!container) return;
  window.pauseAllMediaEverywhere();

  try {
    const [restRes, sdkRes] = await Promise.allSettled([
      fetchPostsViaRest(120),
      db ? db.collection('posts').limit(120).get() : Promise.resolve(null),
      fetchUsersCacheViaRest(120)
    ]);

    const restItems = (restRes.status === 'fulfilled' && Array.isArray(restRes.value))
      ? restRes.value.map(d => normalizePostDocData(d.id, d)).filter(Boolean)
      : [];
    const sdkItems = (sdkRes.status === 'fulfilled' && sdkRes.value && sdkRes.value.docs)
      ? sdkRes.value.docs.map(doc => normalizePostDocData(doc.id, doc.data())).filter(Boolean)
      : [];

    let items = mergeNormalizedPosts(restItems, sdkItems).filter(d => {
      return !d.isStory && d.mediaType !== 'STORY' && !d.isVideoChunk;
    });

    // Auto-heal any local videos in IndexedDB to Firestore chunks so all other users can play them!
    syncAllLocalVideosToCloud(items);

    // STRICT PRIVACY LOGIC FOR REELS:
    // - Public ID -> ALL users can see Reels!
    // - Private ID -> ONLY followers (and self) can see Reels!
    // - Friends tab -> ONLY followed users' Reels!
    const tabMode = state.reelsTabMode || 'all';
    let reelItems = items.filter(p => (p.isReel || p.hasVideo || p.video || p.videoKey || p.mediaType === 'REEL') && canViewerSeeReelOrPost(p, tabMode));
    if (!reelItems.length) {
      reelItems = items.filter(p => (p.image || p.posterImage) && canViewerSeeReelOrPost(p, tabMode));
    }
    reelItems.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    state.reelsCache = reelItems;

    if (!reelItems.length) {
      container.innerHTML = `
        <div class="reel-card">
          <div class="empty" style="color:#fff;">
            <div style="font-size:44px;margin-bottom:10px;">🎬</div>
            <h3 style="color:#fff;margin:0 0 8px;">${tabMode === 'friends' ? 'No Friends Reels Yet' : 'No Reels Yet'}</h3>
            <p style="color:rgba(255,255,255,.65);max-width:260px;margin:0 auto 18px;">${tabMode === 'friends' ? 'Follow friends or switch back to Reels to watch public Reels from everyone.' : 'Upload a Reel video (up to 125 MB, ≤ 35 seconds) with filters and music!'}</p>
            <button class="btn btn-gradient" onclick="openCreateReelModal()">+ Upload Reel</button>
          </div>
        </div>`;
      return;
    }

    // Smooth DOM reconciliation for Reels: avoid rebuilding DOM and resetting active playing video
    const existingCards = Array.from(container.querySelectorAll('.reel-card[data-reel-id]'));
    if (existingCards.length > 0) {
      const existingIds = existingCards.map(c => c.dataset.reelId);
      const newIds = reelItems.map(r => r.id);
      if (existingIds.length === newIds.length && existingIds.every((id, idx) => id === newIds[idx])) {
        reelItems.forEach(r => {
          const card = container.querySelector(`.reel-card[data-reel-id="${r.id}"]`);
          if (!card) return;
          const likeBtn = card.querySelector('[data-reel-like]');
          if (likeBtn) {
            likeBtn.classList.toggle('liked', !!r.likedByMe);
            const svg = likeBtn.querySelector('svg');
            if (svg) svg.setAttribute('fill', r.likedByMe ? 'currentColor' : 'none');
          }
          const likeCount = card.querySelector('[data-reel-like-count]');
          if (likeCount) likeCount.textContent = r.likeCount || 0;
          const saveBtn = card.querySelector('[data-reel-save]');
          if (saveBtn) {
            const isSaved = state.savedPostIds && state.savedPostIds.has(r.id);
            saveBtn.classList.toggle('saved', isSaved);
            const sSvg = saveBtn.querySelector('svg');
            if (sSvg) sSvg.setAttribute('fill', isSaved ? 'currentColor' : 'none');
          }
        });
        return;
      }
    }

    container.innerHTML = reelItems.map(r => {
      const author = r.author || { name: 'User', username: 'user' };
      const isFollowing = state.followingUserIds.has(r.userId) || state.followingUserIds.has(author.id);
      const isMine = r.userId === state.me.uid || author.id === state.me.uid;
      const filterStyle = r.filterCss && r.filterCss !== 'none' ? `style="filter:${escapeHTML(r.filterCss)};"` : '';
      const trimStart = r.trimStart || 0;
      const trimEnd = r.trimEnd || 35;
      const hasVid = !!(r.video || r.videoKey || r.hasVideo || r.isReel || r.mediaType === 'REEL');
      const isSaved = state.savedPostIds && state.savedPostIds.has(r.id);

      return `
        <div class="reel-card video-paused" data-reel-id="${r.id}" data-track-id="${escapeHTML(r.audioTrackId || '')}" data-audio-label="${escapeHTML(r.audioTrack || '')}" ondblclick="triggerReelHeart(this, '${r.id}')">
          <div class="video-center-play-badge">▶</div>
          ${hasVid ? `
            <video class="reel-media-video" data-post-doc-id="${r.id}" data-chunk-count="${r.videoChunkCount || 0}" ${r.video ? `src="${r.video}"` : ''} ${r.videoKey ? `data-video-key="${escapeHTML(r.videoKey)}"` : ''} ${(r.posterImage || r.image) ? `poster="${r.posterImage || r.image}"` : ''} ${filterStyle} data-trim-start="${trimStart}" data-trim-end="${trimEnd}" onloadedmetadata="window.adjustVideoScreenToUpload && window.adjustVideoScreenToUpload(this)" ontimeupdate="window.enforceReelTrimPlayback(this)" preload="auto" loop playsinline ${window.userExplicitlyMuted ? 'muted' : ''} onclick="window.toggleInstagramVideoPlay(this)"></video>
          ` : `
            <img class="reel-media-img" src="${r.image || r.posterImage}" ${filterStyle} alt="Reel" loading="lazy" decoding="async">
          `}
          ${r.overlayText ? `<div class="post-overlay-banner">${escapeHTML(r.overlayText)}</div>` : ''}
          ${r.sticker ? `<div class="post-overlay-sticker" style="top:64px;right:18px;">${escapeHTML(r.sticker)}</div>` : ''}
          <div class="reel-gradient-scrim"></div>

          <!-- Bottom-Left Author, Follow Button & Caption (Image 5) -->
          <div class="reel-bottom-info">
            <div class="reel-author-row">
              <div onclick="showProfile('${escapeHTML(author.username || '')}')" style="cursor:pointer;">
                ${avatarHTML(author, 'sm')}
              </div>
              <span class="reel-author-name" onclick="showProfile('${escapeHTML(author.username || '')}')">${escapeHTML(author.username || 'user')}</span>
              ${premiumBadgeHTML(author)}
              ${!isMine ? `
                <button class="reel-follow-chip" data-reel-follow="${r.userId || author.id}">${isFollowing ? 'Following' : 'Follow'}</button>
              ` : ''}
            </div>
            ${r.content ? `<div class="reel-caption-text">${escapeHTML(r.content)}</div>` : ''}
            <div class="reel-music-bar" style="cursor:pointer;" onclick="togglePlaySynthTrack('${escapeHTML(r.audioTrackId || 'golden_hour')}', this)">
              <span>🎵</span>
              <span>${escapeHTML(r.audioTrack || ('Original audio · ' + (author.username || 'user')))}</span>
            </div>
          </div>

          <!-- Right-Side Vertical Action Rail (Image 5: Heart, Comment, Repost, Share, Bookmark, Dots, Music Disc) -->
          <div class="reel-side-rail">
            <button class="reel-rail-btn ${r.likedByMe ? 'liked' : ''}" data-reel-like="${r.id}">
              <svg viewBox="0 0 24 24" fill="${r.likedByMe ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
              <span data-reel-like-count>${r.likeCount}</span>
            </button>

            <button class="reel-rail-btn" onclick="openCommentsSheet('${r.id}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-4.5 7.6 8.4 8.4 0 0 1-3.8.9 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7A8.4 8.4 0 0 1 3 11.5 8.5 8.5 0 0 1 11.5 3h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              <span>${r.commentCount}</span>
            </button>

            <button class="reel-rail-btn" onclick="toast('Reposted to your profile! 🔁')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
              <span>${r.shareCount || 0}</span>
            </button>

            <button class="reel-rail-btn" onclick="openSharePostModal('${r.id}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              <span>${r.viewsCount || 1}</span>
            </button>

            <button class="reel-rail-btn" data-reel-save="${r.id}" title="Save Reel">
              <svg viewBox="0 0 24 24" fill="${isSaved ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </button>

            <button class="reel-rail-btn" onclick="window.openPostOptionsMenu('${r.id}')" title="Options">
              <span style="font-size:20px;font-weight:800;">⋯</span>
            </button>

            <div class="reel-disc" onclick="togglePlaySynthTrack('${escapeHTML(r.audioTrackId || 'golden_hour')}')">🎵</div>
          </div>
        </div>
      `;
    }).join('');

    // Hydrate videos in parallel and immediately auto-play the first visible Reel
    hydrateVideoElements(container).then(() => {
      if (state.view === 'reels') {
        const firstVid = container.querySelector('.reel-card video.reel-media-video');
        if (firstVid) {
          window.adjustVideoScreenToUpload && window.adjustVideoScreenToUpload(firstVid);
          if (firstVid.paused && state.me?.settings?.autoPlayVideos !== false) {
            window.autoPlaySingleVideoWithAudio(firstVid);
          }
        }
      }
    });

    container.querySelectorAll('[data-reel-like]').forEach(btn => {
      btn.onclick = async () => {
        const id = btn.dataset.reelLike;
        const countEl = btn.querySelector('[data-reel-like-count]');
        const isLiked = btn.classList.contains('liked');
        btn.classList.toggle('liked', !isLiked);
        const svg = btn.querySelector('svg');
        if (svg) svg.setAttribute('fill', !isLiked ? 'currentColor' : 'none');
        if (countEl) countEl.textContent = Math.max(0, Number(countEl.textContent) + (isLiked ? -1 : 1));
        if (!isLiked) { playHeartPopSound(); triggerHaptic(14); }
        try {
          const ref = db.collection('posts').doc(id);
          const doc = await ref.get();
          if (doc.exists) {
            const likedBy = Array.isArray(doc.data().likedBy) ? Array.from(new Set(doc.data().likedBy)) : [];
            const next = isLiked ? likedBy.filter(u => u !== state.me.uid) : Array.from(new Set([...likedBy, state.me.uid]));
            await ref.update({ likedBy: next, likeCount: next.length });
          }
        } catch (e) {}
      };
    });

    container.querySelectorAll('[data-reel-save]').forEach(btn => {
      btn.onclick = async () => {
        const id = btn.dataset.reelSave;
        const svg = btn.querySelector('svg');
        const currentlySaved = state.savedPostIds.has(id);
        if (currentlySaved) {
          state.savedPostIds.delete(id);
          if (svg) svg.setAttribute('fill', 'none');
          toast('Removed from Saved');
        } else {
          state.savedPostIds.add(id);
          if (svg) svg.setAttribute('fill', 'currentColor');
          toast('Saved to collection 🔖');
        }
        try {
          await db.collection('users').doc(state.me.uid).update({
            savedPosts: Array.from(state.savedPostIds)
          });
        } catch (e) {}
      };
    });

    container.querySelectorAll('[data-reel-follow]').forEach(btn => {
      btn.onclick = async () => {
        const targetUid = btn.dataset.reelFollow;
        if (!targetUid) return;
        const following = state.followingUserIds.has(targetUid);
        const docRef = db.collection('follows').doc(`${state.me.uid}_${targetUid}`);
        if (following) {
          state.followingUserIds.delete(targetUid);
          btn.textContent = 'Follow';
          await docRef.delete().catch(() => {});
        } else {
          state.followingUserIds.add(targetUid);
          btn.textContent = 'Following';
          toast('Following creator! ✨');
          await docRef.set({ followerId: state.me.uid, followingId: targetUid, createdAt: firebase.firestore.FieldValue.serverTimestamp() }).catch(() => {});
        }
      };
    });

    const muteBtn = document.getElementById('reelsGlobalMuteBtn');
    if (muteBtn) {
      muteBtn.textContent = window.userExplicitlyMuted ? '🔇' : '🔊';
      muteBtn.onclick = () => {
        window.toggleUserAudioMute();
        muteBtn.textContent = window.userExplicitlyMuted ? '🔇' : '🔊';
      };
    }

    // STRICT SINGLE ACTIVE REEL VIEWPORT OBSERVER (Only plays when state.view === 'reels')
    if ('IntersectionObserver' in window) {
      if (reelScrollObserver) reelScrollObserver.disconnect();
      reelScrollObserver = new IntersectionObserver((entries) => {
        if (state.view !== 'reels') {
          window.pauseAllMediaEverywhere();
          return;
        }
        entries.forEach(entry => {
          const vid = entry.target.querySelector('video');
          const reelId = entry.target.dataset.reelId;
          if (entry.isIntersecting && entry.intersectionRatio >= 0.50) {
            if (vid) {
              window.adjustVideoScreenToUpload && window.adjustVideoScreenToUpload(vid);
              if (state.me?.settings?.autoPlayVideos !== false) {
                window.autoPlaySingleVideoWithAudio(vid);
              }
            }
            if (reelId) recordUniqueView(reelId);
          } else {
            if (vid) {
              vid.pause();
              entry.target.classList.add('video-paused');
            }
          }
        });
      }, { threshold: [0, 0.50, 0.65] });

      container.querySelectorAll('.reel-card').forEach(card => reelScrollObserver.observe(card));
    }
  } catch (err) {
    container.innerHTML = `<div class="empty" style="color:#fff;">${escapeHTML(err.message)}</div>`;
  }
}

function triggerReelHeart(cardEl, reelId) {
  if (state.me?.settings?.doubleTapLike === false) return;
  const heart = document.createElement('div');
  heart.className = 'heart-explosion';
  heart.textContent = '❤️';
  cardEl.appendChild(heart);
  setTimeout(() => heart.remove(), 800);
  playHeartPopSound();
  triggerHaptic(15);

  const likeBtn = cardEl.querySelector('[data-reel-like]');
  if (likeBtn && !likeBtn.classList.contains('liked')) {
    likeBtn.click();
  }
}

// Bake filters, adjustments, text overlay & sticker onto a photo via HTML5 Canvas
async function bakeEditedPhotoCanvas(srcDataUrl, filterCss, overlayText, sticker) {
  return new Promise((resolve) => {
    const img = new Image();
    img.onload = () => {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        if (filterCss && filterCss !== 'none') {
          try { ctx.filter = filterCss; } catch (e) {}
        }
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        ctx.filter = 'none';
        resolve(canvas.toDataURL('image/jpeg', 0.86));
      } catch (e) {
        resolve(srcDataUrl);
      }
    };
    img.onerror = () => resolve(srcDataUrl);
    img.src = srcDataUrl;
  });
}

// UNIFIED YOUR DAY STUDIO MODAL (<=125MB & <=35S VIDEO, 10 FILTERS, 12 PLAYABLE SONGS, TEXT & STICKERS)
function openCreateReelModal(opts = {}) {
  window.pauseAllMediaEverywhere();
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal studio-modal">
      <div class="row between" style="margin-bottom:10px;">
        <h3 style="margin:0;display:flex;align-items:center;gap:8px;font-size:16px;">Create Post / Reel <span class="badge-premium">≤125MB · ≤35s</span></h3>
        <button class="btn btn-icon btn-ghost" id="crCloseBtn">✕</button>
      </div>

      <!-- File Picker Row -->
      <div class="row between" style="margin-bottom:10px;gap:8px;">
        <label class="btn btn-sm btn-primary" style="cursor:pointer;flex:1;justify-content:center;">
          📂 Select Video (≤125MB, ≤35s) or Photo
          <input type="file" id="crMediaInput" accept="video/*,image/*" class="hidden">
        </label>
        <select id="crTargetSelect" style="width:auto;padding:7px 10px;font-size:12px;font-weight:700;">
          <option value="reel">Share to Feed &amp; Reels</option>
          <option value="story">Share to 24h Story</option>
        </select>
      </div>

      <!-- Live Interactive Preview Stage (Paused by default while editing!) -->
      <div class="studio-stage" id="crPreviewStage" style="height:240px;">
        <div id="crEmptyPrompt" class="muted" style="text-align:center;padding:16px;">
          <div style="font-size:32px;margin-bottom:6px;">📷</div>
          <div style="font-weight:700;color:var(--paper);">Choose a Video (≤125 MB, ≤35s) or Photo</div>
          <div style="font-size:11.5px;">Edit with live Your Day filters, trim, text, stickers &amp; songs</div>
        </div>
        <span class="studio-duration-badge hidden" id="crDurationBadge">⏱️ 0.0s / 35s max</span>
        <video id="crVideoPrev" class="hidden" playsinline preload="metadata" onclick="this.paused ? this.play() : this.pause()" title="Tap video to preview play/pause"></video>
        <img id="crImgPrev" class="hidden" alt="Studio Preview">
        <div class="studio-overlay-text-preview hidden" id="crTextOverlayPrev"></div>
        <div class="studio-sticker-preview hidden" id="crStickerPrev"></div>
        <div class="studio-music-pill-preview hidden" id="crMusicPillPrev">
          <span>🎵</span><span id="crMusicPillText">No song selected</span>
        </div>
      </div>

      <!-- Studio Tool Tabs -->
      <div class="studio-tabs">
        <button type="button" class="studio-tab-btn active" data-studio-tab="filters">🎨 Filters</button>
        <button type="button" class="studio-tab-btn" data-studio-tab="adjust">✂️ Trim ≤35s</button>
        <button type="button" class="studio-tab-btn" data-studio-tab="music">🎵 Music</button>
        <button type="button" class="studio-tab-btn" data-studio-tab="text">Aa Text</button>
      </div>

      <!-- TAB 1: 10 FILTERS -->
      <div class="studio-pane" id="studioPaneFilters">
        <div class="filter-strip" id="crFilterStrip">
          ${INSTAGRAM_FILTERS.map((f, i) => `
            <div class="filter-chip ${i === 0 ? 'active' : ''}" data-filter-css="${f.css}">
              <div class="filter-swatch" style="filter:${f.css};"></div>
              <span>${f.name}</span>
            </div>
          `).join('')}
        </div>
      </div>

      <!-- TAB 2: VIDEO TRIMMER (<=35S) & COLOR ADJUSTMENTS -->
      <div class="studio-pane hidden" id="studioPaneAdjust">
        <div class="trim-box" id="crTrimBox">
          <div class="row between" style="margin-bottom:6px;">
            <span style="font-size:12px;font-weight:700;color:var(--amber);">✂️ Video Trim (Max 35.0s · ≤125MB)</span>
            <span id="crTrimRangeLabel" class="mono" style="font-size:11.5px;">0.0s – 35.0s</span>
          </div>
          <div class="row gap-8">
            <div style="flex:1;">
              <label style="font-size:11px;color:var(--paper-dim);">Start (s)</label>
              <input type="range" id="crTrimStart" min="0" max="34" step="0.5" value="0">
            </div>
            <div style="flex:1;">
              <label style="font-size:11px;color:var(--paper-dim);">End (≤35s max)</label>
              <input type="range" id="crTrimEnd" min="1" max="35" step="0.5" value="35">
            </div>
          </div>
        </div>

        <div class="adjust-grid">
          <div class="adjust-item">
            <label><span>Brightness</span><span id="lblBright">100%</span></label>
            <input type="range" id="adjBright" min="60" max="150" value="100">
          </div>
          <div class="adjust-item">
            <label><span>Contrast</span><span id="lblContrast">100%</span></label>
            <input type="range" id="adjContrast" min="60" max="150" value="100">
          </div>
          <div class="adjust-item">
            <label><span>Saturation</span><span id="lblSat">100%</span></label>
            <input type="range" id="adjSat" min="0" max="200" value="100">
          </div>
          <div class="adjust-item">
            <label><span>Warmth</span><span id="lblWarm">0%</span></label>
            <input type="range" id="adjWarm" min="0" max="80" value="0">
          </div>
        </div>
      </div>

      <!-- TAB 3: MUSIC LIBRARY (12 PLAYABLE TRACKS + CUSTOM UPLOAD) -->
      <div class="studio-pane hidden" id="studioPaneMusic">
        <div class="row between" style="margin-bottom:8px;gap:6px;">
          <input type="text" id="crMusicSearch" placeholder="🔍 Search songs…" style="padding:7px 12px;font-size:12.5px;">
          <label class="btn btn-sm btn-ghost" style="cursor:pointer;flex-shrink:0;">
            📂 Custom MP3<input type="file" id="crCustomAudioFile" accept="audio/*" class="hidden">
          </label>
        </div>
        <div class="music-list" id="crMusicList" style="max-height:145px;">
          ${INSTAGRAM_MUSIC_LIBRARY.map(t => `
            <div class="music-row" data-song-id="${t.id}" data-song-label="${escapeHTML(t.title)} · ${escapeHTML(t.artist)}">
              <div>
                <div class="music-row-title">🎵 ${escapeHTML(t.title)}</div>
                <div class="music-row-sub">${escapeHTML(t.artist)} · ${t.bpm} BPM</div>
              </div>
              <button type="button" class="btn btn-sm btn-ghost" data-preview-song="${t.id}">▶ Play</button>
            </div>
          `).join('')}
        </div>
      </div>

      <!-- TAB 4: TEXT OVERLAY, STICKERS & LOCATION -->
      <div class="studio-pane hidden" id="studioPaneText">
        <div class="row gap-8" style="margin-bottom:8px;">
          <div style="flex:1;">
            <label class="field">On-Screen Text Banner</label>
            <input type="text" id="crOverlayTextInput" placeholder="Add text over photo/reel…" maxlength="60">
          </div>
          <div style="flex:1;">
            <label class="field">Location</label>
            <input type="text" id="crLocationInput" placeholder="📍 Add location…" maxlength="40">
          </div>
        </div>
        <div>
          <label class="field">Floating Emoji Sticker</label>
          <div class="row gap-6" style="flex-wrap:wrap;margin-top:4px;" id="crStickerBar">
            ${['', '🔥', '❤️', '✨', '💯', '🎉', '👑', '📍', '🎵', '🌟'].map(st => `
              <button type="button" class="btn btn-sm btn-ghost" data-sticker="${st}" style="font-size:16px;padding:3px 9px;">${st || 'None'}</button>
            `).join('')}
          </div>
        </div>
      </div>

      <!-- Caption Input -->
      <div class="field-group" style="margin-top:10px;margin-bottom:8px;">
        <input type="text" id="crCaption" placeholder="Write a caption with #hashtags…" value="${escapeHTML(opts.initialCaption || '')}">
      </div>

      <div class="modal-actions" style="margin-top:8px;">
        <button class="btn btn-ghost" id="crCancelBtn">Cancel</button>
        <button class="btn btn-gradient" id="crPublishBtn">Share Now 🚀</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);

  const close = () => {
    window.pauseAllMediaEverywhere();
    overlay.remove();
  };
  overlay.querySelector('#crCloseBtn').onclick = close;
  overlay.querySelector('#crCancelBtn').onclick = close;

  let mediaData = null;
  let videoFileBlob = null;
  let videoSmallDataUrl = null;
  let posterImageData = '';
  let isVideo = false;
  let rawVideoDuration = 15;
  let trimStart = 0;
  let trimEnd = 35;
  let selectedPresetCss = 'none';
  let selectedSongId = '';
  let selectedSongLabel = '';
  let customAudioData = null;
  let overlayText = '';
  let selectedSticker = '';

  const vPrev = overlay.querySelector('#crVideoPrev');
  const iPrev = overlay.querySelector('#crImgPrev');
  const emptyPrompt = overlay.querySelector('#crEmptyPrompt');
  const durBadge = overlay.querySelector('#crDurationBadge');
  const textOverlayPrev = overlay.querySelector('#crTextOverlayPrev');
  const stickerPrev = overlay.querySelector('#crStickerPrev');
  const musicPillPrev = overlay.querySelector('#crMusicPillPrev');
  const musicPillText = overlay.querySelector('#crMusicPillText');

  function computeCombinedFilterCss() {
    const b = overlay.querySelector('#adjBright').value;
    const c = overlay.querySelector('#adjContrast').value;
    const s = overlay.querySelector('#adjSat').value;
    const w = overlay.querySelector('#adjWarm').value;
    overlay.querySelector('#lblBright').textContent = b + '%';
    overlay.querySelector('#lblContrast').textContent = c + '%';
    overlay.querySelector('#lblSat').textContent = s + '%';
    overlay.querySelector('#lblWarm').textContent = w + '%';

    const parts = [];
    if (selectedPresetCss && selectedPresetCss !== 'none') parts.push(selectedPresetCss);
    if (b !== '100') parts.push(`brightness(${b / 100})`);
    if (c !== '100') parts.push(`contrast(${c / 100})`);
    if (s !== '100') parts.push(`saturate(${s / 100})`);
    if (w !== '0') parts.push(`sepia(${w / 100})`);
    const finalCss = parts.length ? parts.join(' ') : 'none';
    vPrev.style.filter = finalCss;
    iPrev.style.filter = finalCss;
    return finalCss;
  }

  overlay.querySelectorAll('[data-studio-tab]').forEach(btn => {
    btn.onclick = () => {
      overlay.querySelectorAll('[data-studio-tab]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.studioTab;
      overlay.querySelector('#studioPaneFilters').classList.toggle('hidden', tab !== 'filters');
      overlay.querySelector('#studioPaneAdjust').classList.toggle('hidden', tab !== 'adjust');
      overlay.querySelector('#studioPaneMusic').classList.toggle('hidden', tab !== 'music');
      overlay.querySelector('#studioPaneText').classList.toggle('hidden', tab !== 'text');
    };
  });

  overlay.querySelectorAll('.filter-chip').forEach(chip => {
    chip.onclick = () => {
      overlay.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      selectedPresetCss = chip.dataset.filterCss;
      computeCombinedFilterCss();
      triggerHaptic(8);
    };
  });

  ['#adjBright', '#adjContrast', '#adjSat', '#adjWarm'].forEach(sel => {
    overlay.querySelector(sel).oninput = computeCombinedFilterCss;
  });

  const trimStartInput = overlay.querySelector('#crTrimStart');
  const trimEndInput = overlay.querySelector('#crTrimEnd');
  const trimLabel = overlay.querySelector('#crTrimRangeLabel');

  function updateTrimBounds() {
    let s = parseFloat(trimStartInput.value) || 0;
    let e = parseFloat(trimEndInput.value) || 35;
    if (e <= s + 0.5) e = Math.min(rawVideoDuration, s + 1);
    if (e - s > MAX_REEL_DURATION_SEC) {
      e = s + MAX_REEL_DURATION_SEC;
      trimEndInput.value = String(e);
    }
    trimStart = s;
    trimEnd = e;
    const clipLen = Math.min(MAX_REEL_DURATION_SEC, Math.max(0.5, e - s));
    trimLabel.textContent = `${s.toFixed(1)}s – ${e.toFixed(1)}s (${clipLen.toFixed(1)}s / 35s max)`;
    durBadge.textContent = `⏱️ ${clipLen.toFixed(1)}s / 35s max`;
    vPrev.dataset.trimStart = String(trimStart);
    vPrev.dataset.trimEnd = String(trimEnd);
    vPrev.currentTime = trimStart;
  }
  trimStartInput.oninput = updateTrimBounds;
  trimEndInput.oninput = updateTrimBounds;

  overlay.querySelector('#crMusicSearch').oninput = (e) => {
    const q = e.target.value.trim().toLowerCase();
    overlay.querySelectorAll('.music-row').forEach(row => {
      row.style.display = (!q || row.textContent.toLowerCase().includes(q)) ? 'flex' : 'none';
    });
  };

  overlay.querySelectorAll('.music-row').forEach(row => {
    row.onclick = () => {
      const id = row.dataset.songId;
      const label = row.dataset.songLabel;
      overlay.querySelectorAll('.music-row').forEach(r => r.classList.remove('active'));
      row.classList.add('active');
      selectedSongId = id;
      selectedSongLabel = label;
      customAudioData = null;
      musicPillPrev.classList.remove('hidden');
      musicPillText.textContent = label;
      window.togglePlaySynthTrack(id, row);
      triggerHaptic(10);
    };
  });

  overlay.querySelector('#crCustomAudioFile').onchange = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 15 * 1024 * 1024) return toast('Audio file must be under 15 MB.');
    const reader = new FileReader();
    reader.onload = () => {
      customAudioData = reader.result;
      selectedSongId = 'custom_audio';
      selectedSongLabel = file.name.replace(/\.[^/.]+$/, '');
      musicPillPrev.classList.remove('hidden');
      musicPillText.textContent = '🎵 ' + selectedSongLabel;
      window.togglePlaySynthTrack('custom_audio', null, customAudioData);
      toast('Custom song attached! 🎵');
    };
    reader.readAsDataURL(file);
  };

  overlay.querySelector('#crOverlayTextInput').oninput = (e) => {
    overlayText = e.target.value.trim();
    textOverlayPrev.textContent = overlayText;
    textOverlayPrev.classList.toggle('hidden', !overlayText);
  };

  overlay.querySelectorAll('[data-sticker]').forEach(btn => {
    btn.onclick = () => {
      selectedSticker = btn.dataset.sticker;
      stickerPrev.textContent = selectedSticker;
      stickerPrev.classList.toggle('hidden', !selectedSticker);
      triggerHaptic(8);
    };
  });

  async function handleSelectedFile(file) {
    if (!file) return;
    showLoader();
    try {
      emptyPrompt.classList.add('hidden');
      if (file.type.startsWith('video/')) {
        const res = await readVideoFileLimited(file);
        isVideo = true;
        videoFileBlob = res.file;
        videoSmallDataUrl = res.smallDataUrl;
        posterImageData = res.posterImage || '';
        mediaData = res.dataUrl;
        rawVideoDuration = res.rawDuration;
        trimStart = 0;
        trimEnd = Math.min(res.rawDuration, MAX_REEL_DURATION_SEC);

        trimStartInput.max = String(Math.max(1, Math.floor(res.rawDuration - 1)));
        trimEndInput.max = String(Math.ceil(res.rawDuration));
        trimStartInput.value = '0';
        trimEndInput.value = String(trimEnd);

        iPrev.classList.add('hidden');
        vPrev.classList.remove('hidden');
        durBadge.classList.remove('hidden');
        durBadge.classList.toggle('warn', res.rawDuration > MAX_REEL_DURATION_SEC);
        durBadge.textContent = `⏱️ ${Math.min(res.rawDuration, MAX_REEL_DURATION_SEC).toFixed(1)}s / 35s max · ${formatFileSize(file.size)}`;
        vPrev.src = mediaData;
        vPrev.pause(); // Keep paused during editing unless user taps!
        vPrev.dataset.trimStart = '0';
        vPrev.dataset.trimEnd = String(trimEnd);
        vPrev.ontimeupdate = () => window.enforceReelTrimPlayback(vPrev);
        updateTrimBounds();
      } else {
        isVideo = false;
        videoFileBlob = null;
        videoSmallDataUrl = null;
        const maxDim = state.me?.settings?.hdUploads !== false ? 1350 : 1080;
        mediaData = await compressImage(file, maxDim, 0.85);
        posterImageData = mediaData;
        vPrev.pause();
        vPrev.classList.add('hidden');
        durBadge.classList.add('hidden');
        iPrev.classList.remove('hidden');
        iPrev.src = mediaData;
      }
    } catch (err) {
      toast(err.message);
    } finally {
      hideLoader();
    }
  }

  if (opts.initialFile) {
    handleSelectedFile(opts.initialFile);
  }

  overlay.querySelector('#crMediaInput').onchange = (e) => {
    handleSelectedFile(e.target.files[0]);
  };

  overlay.querySelector('#crPublishBtn').onclick = async () => {
    if (!mediaData) return toast('Please select a video (≤125MB, ≤35s) or photo first.');
    const finalFilterCss = computeCombinedFilterCss();
    const caption = overlay.querySelector('#crCaption').value.trim();
    const locationTag = overlay.querySelector('#crLocationInput')?.value.trim() || '';
    const targetMode = overlay.querySelector('#crTargetSelect').value;
    const audioTrack = selectedSongLabel || (isVideo ? `Original Audio · @${state.me.username}` : '');
    const clipDuration = isVideo ? Math.min(MAX_REEL_DURATION_SEC, Math.max(1, trimEnd - trimStart)) : null;

    if (isVideo && clipDuration > MAX_REEL_DURATION_SEC) {
      return toast('Reel video duration must be 35 seconds or less!');
    }

    const btn = overlay.querySelector('#crPublishBtn');
    btn.disabled = true;
    btn.classList.add('is-busy');
    showLoader();

    try {
      let finalImage = isVideo ? (posterImageData || null) : mediaData;
      if (!isVideo && finalFilterCss !== 'none') {
        finalImage = await bakeEditedPhotoCanvas(mediaData, finalFilterCss, overlayText, selectedSticker);
      }

      // Save binary video (up to 125 MB) into IndexedDB so Firestore document NEVER exceeds 1MB limit!
      let videoKey = null;
      if (isVideo && videoFileBlob) {
        videoKey = `vid_${state.me.uid}_${Date.now()}`;
        await YDDVideoDB.saveVideo(videoKey, videoFileBlob);
      }

      if (targetMode === 'story') {
        const storyImage = finalImage || posterImageData || (isVideo ? '' : mediaData);
        const nowIso = new Date().toISOString();
        const storyObj = {
          id: 'story_' + Date.now(),
          isStory: true,
          mediaType: 'STORY',
          userId: state.me.uid,
          username: state.me.username,
          name: state.me.name,
          avatar: state.me.avatar || '',
          author: { id: state.me.uid, name: state.me.name, username: state.me.username, avatar: state.me.avatar || '' },
          image: isVideo ? null : storyImage,
          posterImage: isVideo ? storyImage : null,
          hasVideo: isVideo,
          video: isVideo ? (videoSmallDataUrl || null) : null,
          videoKey: isVideo ? videoKey : null,
          videoDuration: clipDuration || 6,
          audioTrack,
          audioTrackId: selectedSongId || '',
          viewedBy: [state.me.uid],
          createdAt: nowIso,
          expiresAt: Date.now() + STORY_TTL_MS
        };
        try {
          const stDoc = await db.collection('posts').add({
            isStory: true,
            mediaType: 'STORY',
            userId: state.me.uid,
            username: state.me.username,
            name: state.me.name,
            avatar: state.me.avatar || '',
            author: storyObj.author,
            image: isVideo ? null : storyImage,
            posterImage: isVideo ? storyImage : null,
            hasVideo: isVideo,
            video: isVideo ? (videoSmallDataUrl || null) : null,
            videoKey: isVideo ? videoKey : null,
            videoDuration: clipDuration || 6,
            audioTrack,
            audioTrackId: selectedSongId || '',
            viewedBy: [state.me.uid],
            createdAt: firebase.firestore.FieldValue.serverTimestamp(),
            expiresAt: Date.now() + STORY_TTL_MS
          });
          storyObj.id = stDoc.id;
          if (isVideo && videoFileBlob && !videoSmallDataUrl) {
            await saveCloudVideoChunks('posts', stDoc.id, videoFileBlob, (pct) => {
              btn.textContent = `☁️ Uploading Story ${pct}%…`;
            });
          }
        } catch (fErr) {
          console.warn('Studio story cloud sync note:', fErr.message);
        }
        safeSaveLocalStory(storyObj);
        toast(isVideo ? '24h Video Story shared! 🎬' : '24h Photo Story shared! 📸');
        close();
        await renderStoriesTray(false);
        openStoryViewer(storyObj);
        return;
      }

      const payload = {
        userId: state.me.uid,
        mediaType: isVideo ? 'REEL' : 'IMAGE',
        author: {
          id: state.me.uid,
          username: state.me.username,
          name: state.me.name,
          avatar: state.me.avatar || '',
          isPremium: isUserPremium(state.me),
          isPrivate: !!(state.me.settings?.privateAccount || state.me.isPrivate)
        },
        content: caption,
        location: locationTag,
        image: isVideo ? null : finalImage,
        posterImage: isVideo ? (posterImageData || null) : null,
        video: isVideo ? (videoSmallDataUrl || null) : null,
        videoKey: isVideo ? videoKey : null,
        hasVideo: isVideo,
        videoDuration: clipDuration,
        trimStart: isVideo ? trimStart : 0,
        trimEnd: isVideo ? trimEnd : 35,
        filterCss: finalFilterCss,
        overlayText: overlayText || '',
        sticker: selectedSticker || '',
        audioTrack,
        audioTrackId: selectedSongId || '',
        isReel: isVideo,
        isPinned: false,
        hideLikes: false,
        commentsDisabled: false,
        likedBy: [],
        likeCount: 0,
        viewsCount: 1,
        viewedBy: [state.me.uid],
        commentCount: 0,
        shareCount: 0,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      };

      btn.textContent = '☁️ Creating Post…';
      const postDocRef = await db.collection('posts').add(payload);
      if (isVideo && videoFileBlob && !videoSmallDataUrl) {
        await saveCloudVideoChunks('posts', postDocRef.id, videoFileBlob, (pct) => {
          btn.textContent = `☁️ Uploading Reel ${pct}%…`;
        });
      }

      triggerHaptic(20);
      toast(isVideo ? 'Reel published (≤35s)! 🎬' : 'Photo post shared! ✨');
      close();
      if (isVideo) showView('reels');
      else showView('feed');
    } catch (err) {
      toast('Upload error: ' + err.message);
      btn.disabled = false;
      btn.classList.remove('is-busy');
      btn.textContent = 'Share Now 🚀';
    } finally {
      hideLoader();
    }
  };
}

// 4. Double-Tap Heart Pop Animation
function triggerHeartExplosion(container, postId) {
  if (state.me?.settings?.doubleTapLike === false) return;
  const heart = document.createElement('div');
  heart.className = 'heart-explosion';
  heart.textContent = '❤️';
  container.appendChild(heart);
  setTimeout(() => heart.remove(), 800);

  // Play micro chime & haptic
  playHeartPopSound();
  triggerHaptic(14);

  // Trigger post like if unliked
  const likeBtn = container.closest('.post')?.querySelector('[data-like]');
  if (likeBtn && !likeBtn.classList.contains('liked')) {
    likeBtn.click();
  }
}

function playHeartPopSound() {
  if (state.me?.settings?.soundEffects === false || state.me?.settings?.quietMode) return;
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(523.25, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(783.99, ctx.currentTime + 0.12);
    gain.gain.setValueAtTime(0.2, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(ctx.currentTime);
    osc.stop(ctx.currentTime + 0.2);
  } catch (e) {}
}

// 5. Comments Sheet
async function openCommentsSheet(postId) {
  const modal = document.getElementById('commentsSheetModal');
  const body = document.getElementById('commentsSheetBody');
  const form = document.getElementById('commentsSheetForm');
  if (!modal || !body) return;

  body.innerHTML = '<div class="empty">Loading comments…</div>';
  modal.classList.remove('hidden');

  try {
    const snap = await db.collection('comments').where('postId', '==', postId).get();
    let comments = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    const mutedWords = (state.me?.settings?.hiddenWords || '')
      .split(',')
      .map(w => w.trim().toLowerCase())
      .filter(Boolean);
    if (mutedWords.length) {
      comments = comments.filter(c => !mutedWords.some(mw => (c.text || '').toLowerCase().includes(mw)));
    }
    comments.sort((a, b) => toDate(a.createdAt) - toDate(b.createdAt));

    body.innerHTML = comments.length ? comments.map(c => `
      <div style="display:flex;align-items:flex-start;gap:10px;">
        ${avatarHTML(c.author, 'sm')}
        <div style="flex:1;">
          <div style="font-size:13.5px;"><b>${escapeHTML(c.author?.name || 'User')}</b> ${escapeHTML(c.text)}</div>
          <div class="faint" style="font-size:11px;margin-top:2px;">${timeAgo(c.createdAt)} · Reply</div>
        </div>
        <button class="btn btn-icon btn-ghost" style="font-size:14px;width:28px;height:28px;" onclick="this.textContent = this.textContent === '🤍' ? '❤️' : '🤍'">🤍</button>
      </div>
    `).join('') : '<div class="empty">No comments yet. Be the first!</div>';
  } catch (e) {
    body.innerHTML = `<div class="empty">${escapeHTML(e.message)}</div>`;
  }

  // Quick Emoji Bar tap
  document.querySelectorAll('#quickEmojiBar span').forEach(sp => {
    sp.onclick = () => {
      document.getElementById('commentsSheetInput').value += sp.textContent;
      document.getElementById('commentsSheetInput').focus();
    };
  });

  form.onsubmit = async (e) => {
    e.preventDefault();
    const input = document.getElementById('commentsSheetInput');
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    showLoader();
    try {
      await db.collection('comments').add({
        postId,
        userId: state.me.uid,
        author: { id: state.me.uid, name: state.me.name, username: state.me.username, avatar: state.me.avatar || '' },
        text,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
      await db.collection('posts').doc(postId).update({
        commentCount: firebase.firestore.FieldValue.increment(1)
      }).catch(() => {});
      toast('Comment posted! 💬');
      openCommentsSheet(postId);
    } catch (err) { toast(err.message); }
    finally { hideLoader(); }
  };

  document.getElementById('commentsSheetCloseBtn').onclick = () => modal.classList.add('hidden');
}

// 6. Share Reel / Post to Direct Chat or Group Modal
async function openSharePostModal(postOrId) {
  const modal = document.getElementById('sharePostModal');
  const listEl = document.getElementById('sharePostUsersList');
  if (!modal || !listEl) return;

  modal.classList.remove('hidden');
  listEl.innerHTML = '<div class="empty">Loading chats &amp; groups…</div>';

  // Resolve full post/reel object so we can build a Shared Reel/Post Card
  let post = (typeof postOrId === 'object' && postOrId !== null) ? postOrId : null;
  const targetId = typeof postOrId === 'string' ? postOrId : postOrId?.id;

  if (targetId && (!post || (!post.image && !post.posterImage && !post.hasVideo))) {
    const fromCache = (state.reelsCache || []).find(p => p.id === targetId) ||
                      (state.feedPostsCache || []).find(p => p.id === targetId);
    if (fromCache) {
      post = fromCache;
    } else {
      try {
        const pDoc = await db.collection('posts').doc(targetId).get();
        if (pDoc.exists) post = { id: pDoc.id, ...pDoc.data() };
      } catch (e) {}
    }
  }
  if (!post) post = { id: targetId || 'post', content: 'Shared a Reel' };

  const isReel = !!(post.isReel || post.hasVideo || post.video || post.videoKey || post.mediaType === 'REEL');
  const sharedPostPayload = {
    id: post.id,
    isReel,
    hasVideo: !!(post.hasVideo || post.video || post.videoKey),
    posterImage: post.posterImage || post.image || null,
    image: post.image || post.posterImage || null,
    videoDuration: post.videoDuration || null,
    content: (post.content || '').slice(0, 140),
    authorUsername: post.author?.username || state.me?.username || 'creator',
    authorName: post.author?.name || state.me?.name || 'Creator',
    authorAvatar: post.author?.avatar || ''
  };

  try {
    const [usersSnap, groupsSnap] = await Promise.all([
      db.collection('users').limit(35).get(),
      db.collection('groups').where('members', 'array-contains', state.me.uid).get().catch(() => ({ docs: [] }))
    ]);

    const friends = usersSnap.docs
      .map(d => ({ id: d.id, ...d.data() }))
      .filter(u => u.id !== state.me.uid);
    const groups = (groupsSnap.docs || []).map(d => ({ id: d.id, ...d.data() }));

    let html = '';
    if (groups.length) {
      html += `<div style="font-size:11px;font-weight:800;color:var(--muted);padding:4px 6px;text-transform:uppercase;">👥 Your Groups</div>`;
      html += groups.map(g => `
        <div class="user-row" style="padding:8px 6px;">
          <div class="group-avatar" style="width:36px;height:36px;font-size:13px;">${initials(g.name)}</div>
          <div class="who">
            <div class="name" style="font-size:13.5px;">${escapeHTML(g.name)}</div>
            <div class="handle mono faint">👥 ${g.members?.length || 1} members</div>
          </div>
          <button class="btn btn-sm btn-gradient" data-send-post-group="${g.id}">Send</button>
        </div>
      `).join('');
    }

    html += `<div style="font-size:11px;font-weight:800;color:var(--muted);padding:8px 6px 4px;text-transform:uppercase;">💬 Direct Messages</div>`;
    html += friends.map(u => `
      <div class="user-row" style="padding:8px 6px;">
        ${avatarHTML(u, 'sm')}
        <div class="who">
          <div class="name" style="font-size:13.5px;">${escapeHTML(u.name || 'User')}</div>
          <div class="handle mono faint">@${escapeHTML(u.username || '')}</div>
        </div>
        <button class="btn btn-sm btn-primary" data-send-post-uid="${u.id}">Send</button>
      </div>
    `).join('');

    listEl.innerHTML = html || '<div class="empty">No contacts found.</div>';

    // Send to Direct Chat
    listEl.querySelectorAll('[data-send-post-uid]').forEach(btn => {
      btn.onclick = async () => {
        const uid = btn.dataset.sendPostUid;
        btn.textContent = 'Sent ✓';
        btn.disabled = true;
        try {
          const chatId = [state.me.uid, uid].sort().join('_');
          await db.collection('messages').add({
            chatId,
            senderId: state.me.uid,
            senderName: state.me.name || state.me.username || 'User',
            receiverId: uid,
            participants: [state.me.uid, uid],
            text: '',
            sharedPost: sharedPostPayload,
            isRead: false,
            createdAt: firebase.firestore.FieldValue.serverTimestamp()
          });
          if (post.id) {
            db.collection('posts').doc(post.id).update({
              shareCount: firebase.firestore.FieldValue.increment(1)
            }).catch(() => {});
          }
          toast(isReel ? 'Reel shared to chat! 🎬' : 'Post shared to chat! ✈️');
        } catch (e) { toast(e.message); }
      };
    });

    // Send to Group Chat
    listEl.querySelectorAll('[data-send-post-group]').forEach(btn => {
      btn.onclick = async () => {
        const gid = btn.dataset.sendPostGroup;
        btn.textContent = 'Sent ✓';
        btn.disabled = true;
        try {
          await db.collection('groupMessages').add({
            groupId: gid,
            senderId: state.me.uid,
            senderName: state.me.name || state.me.username || 'User',
            text: '',
            sharedPost: sharedPostPayload,
            createdAt: firebase.firestore.FieldValue.serverTimestamp()
          });
          if (post.id) {
            db.collection('posts').doc(post.id).update({
              shareCount: firebase.firestore.FieldValue.increment(1)
            }).catch(() => {});
          }
          toast(isReel ? 'Reel shared to group! 🎬' : 'Post shared to group! ✈️');
        } catch (e) { toast(e.message); }
      };
    });
  } catch (err) {
    listEl.innerHTML = `<div class="empty">${escapeHTML(err.message)}</div>`;
  }

  document.getElementById('sharePostCloseBtn').onclick = () => modal.classList.add('hidden');
}

// 7. Settings and Privacy Drawer
function openInstagramSettingsDrawer() {
  const drawer = document.getElementById('instaSettingsDrawer');
  if (!drawer) return;
  drawer.classList.remove('hidden');

  document.getElementById('instaSettingsCloseBtn').onclick = () => drawer.classList.add('hidden');

  // Wire up drawer items
  document.getElementById('drawerSavedPosts').onclick = () => {
    drawer.classList.add('hidden');
    showProfile(state.me.username);
    setTimeout(() => {
      const savedTab = document.querySelector('[data-tab="saved"]');
      if (savedTab) savedTab.click();
    }, 300);
  };

  document.getElementById('drawerNotifications').onclick = () => {
    drawer.classList.add('hidden');
    showView('settings');
  };

  document.getElementById('drawerThemeSwitch').onclick = () => {
    drawer.classList.add('hidden');
    showView('settings');
  };

  document.getElementById('drawerClearCache').onclick = () => {
    state.userCache.clear();
    toast('Cache and temporary states cleared! 🧹');
  };

  document.getElementById('drawerLogout').onclick = handleLogout;

  const privToggle = document.getElementById('drawerPrivateToggle');
  if (privToggle && state.me?.settings) {
    privToggle.checked = !!state.me.settings.privateAccount;
    privToggle.onchange = async () => {
      showLoader();
      try {
        await db.collection('users').doc(state.me.uid).update({
          'settings.privateAccount': privToggle.checked,
          isPrivate: privToggle.checked
        });
        state.me.settings.privateAccount = privToggle.checked;
        state.me.isPrivate = privToggle.checked;
        if (state.userCache) state.userCache.set(state.me.uid, state.me);
        toast(privToggle.checked ? 'Account set to Private (only followers can see your Reels & Stories).' : 'Account set to Public (everyone can see your Reels).');
      } catch (e) { toast(e.message); }
      finally { hideLoader(); }
    };
  }
}

// 8. Instagram Edit Profile Modal
async function openEditProfileModal(user) {
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal" style="max-width:460px;">
      <div class="row between" style="margin-bottom:16px;">
        <h3>Edit Profile</h3>
        <button class="btn btn-icon btn-ghost" id="epCloseBtn">✕</button>
      </div>
      <div style="text-align:center;margin-bottom:18px;">
        ${avatarHTML(user, 'lg')}
        <label class="btn btn-sm btn-ghost" style="margin-top:10px;cursor:pointer;display:inline-block;">
          Change profile photo<input type="file" accept="image/*" id="epAvatarInput" class="hidden">
        </label>
      </div>
      <div class="field-group">
        <label class="field">Name</label>
        <input type="text" id="epName" value="${escapeHTML(user.name || '')}">
      </div>
      <div class="field-group">
        <label class="field">Username</label>
        <input type="text" id="epUsername" value="${escapeHTML(user.username || '')}" disabled style="opacity:.65;">
      </div>
      <div class="field-group">
        <label class="field">Pronouns</label>
        <input type="text" id="epPronouns" placeholder="they/them, she/her, he/him" value="${escapeHTML(user.pronouns || '')}">
      </div>
      <div class="field-group">
        <label class="field">Category</label>
        <input type="text" id="epCategory" placeholder="Digital Creator, Author, Photographer" value="${escapeHTML(user.category || 'Creator')}">
      </div>
      <div class="field-group">
        <label class="field">Bio</label>
        <textarea id="epBio" rows="3">${escapeHTML(user.bio || '')}</textarea>
      </div>
      <div class="field-group">
        <label class="field">Links</label>
        <input type="text" id="epWebsite" placeholder="https://yourwebsite.com" value="${escapeHTML(user.website || '')}">
      </div>
      <button class="btn btn-primary" style="width:100%;margin-top:10px;" id="epSaveBtn">Save Changes</button>
    </div>
  `;
  document.body.appendChild(overlay);

  overlay.querySelector('#epCloseBtn').onclick = () => overlay.remove();

  let newAvatarData = null;
  overlay.querySelector('#epAvatarInput').onchange = async (e) => {
    if (!e.target.files[0]) return;
    showLoader();
    try {
      newAvatarData = await compressImage(e.target.files[0], 400, 0.8);
      overlay.querySelector('.avatar').style.backgroundImage = `url('${newAvatarData}')`;
      overlay.querySelector('.avatar').textContent = '';
    } catch (err) { toast(err.message); }
    finally { hideLoader(); }
  };

  overlay.querySelector('#epSaveBtn').onclick = async () => {
    const name = overlay.querySelector('#epName').value.trim();
    const bio = overlay.querySelector('#epBio').value.trim();
    const pronouns = overlay.querySelector('#epPronouns').value.trim();
    const category = overlay.querySelector('#epCategory').value.trim();
    const website = overlay.querySelector('#epWebsite').value.trim();

    showLoader();
    try {
      const updates = { name, bio, pronouns, category, website };
      if (newAvatarData) updates.avatar = newAvatarData;
      await db.collection('users').doc(state.me.uid).update(updates);
      Object.assign(state.me, updates);
      toast('Profile updated successfully!');
      overlay.remove();
      renderRailAvatar();
      showProfile(state.me.username);
    } catch (err) { toast(err.message); }
    finally { hideLoader(); }
  };
}

/* ==================================================================
   WHATSAPP SUITE (20 WHATSAPP FEATURES)
   ================================================================== */

// 1. WhatsApp Voice Notes Recorder
async function startVoiceRecording() {
  if (state.isRecordingVoice) return;
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    state.mediaRecorder = new MediaRecorder(stream);
    state.voiceAudioChunks = [];
    state.voiceRecordSeconds = 0;
    state.isRecordingVoice = true;

    state.mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) state.voiceAudioChunks.push(e.data);
    };

    state.mediaRecorder.start();

    // Replace chat input row with voice record bar
    const inputRow = document.querySelector('.chat-input-row');
    if (inputRow) {
      inputRow.innerHTML = `
        <div class="voice-record-bar">
          <div class="recording-pulse-dot"></div>
          <span style="font-weight:600;font-size:13.5px;" id="voiceRecordTimerLabel">0:00</span>
          <div style="flex:1;font-size:12px;color:var(--rose);">Recording voice note…</div>
          <button class="btn btn-sm btn-ghost" id="cancelVoiceRecordBtn" style="color:var(--rose);">✕ Cancel</button>
          <button class="btn btn-sm btn-primary" id="sendVoiceRecordBtn">➤ Send</button>
        </div>
      `;

      state.voiceRecordTimer = setInterval(() => {
        state.voiceRecordSeconds++;
        const m = Math.floor(state.voiceRecordSeconds / 60);
        const s = (state.voiceRecordSeconds % 60).toString().padStart(2, '0');
        const lbl = document.getElementById('voiceRecordTimerLabel');
        if (lbl) lbl.textContent = `${m}:${s}`;
      }, 1000);

      document.getElementById('cancelVoiceRecordBtn').onclick = () => stopVoiceRecording(false);
      document.getElementById('sendVoiceRecordBtn').onclick = () => stopVoiceRecording(true);
    }
  } catch (err) {
    toast('Microphone permission required for voice notes.');
  }
}

async function stopVoiceRecording(shouldSend) {
  if (!state.isRecordingVoice || !state.mediaRecorder) return;
  clearInterval(state.voiceRecordTimer);
  state.isRecordingVoice = false;

  state.mediaRecorder.onstop = async () => {
    if (shouldSend && state.voiceAudioChunks.length > 0) {
      showLoader();
      try {
        const audioBlob = new Blob(state.voiceAudioChunks, { type: 'audio/webm' });
        const reader = new FileReader();
        reader.readAsDataURL(audioBlob);
        reader.onloadend = async () => {
          const base64Audio = reader.result;
          const chatId = [state.me.uid, state.activeConvUserId].sort().join('_');
          await db.collection('messages').add({
            chatId,
            senderId: state.me.uid,
            receiverId: state.activeConvUserId,
            participants: [state.me.uid, state.activeConvUserId],
            voiceNote: base64Audio,
            duration: state.voiceRecordSeconds,
            isRead: false,
            createdAt: firebase.firestore.FieldValue.serverTimestamp()
          });
          toast('Voice note sent! 🎙️');
        };
      } catch (e) { toast(e.message); }
      finally { hideLoader(); }
    }
    // Restore normal chat input row
    if (state.activeConvUser) openChatWith(state.activeConvUser);
  };

  state.mediaRecorder.stop();
  state.mediaRecorder.stream.getTracks().forEach(t => t.stop());
}

// 2. WhatsApp Message Reactions
function openReactionBar(msgId, targetEl) {
  const existing = document.querySelector('.reaction-bar-popup');
  if (existing) existing.remove();

  const bar = document.createElement('div');
  bar.className = 'reaction-bar-popup';
  bar.innerHTML = ['❤️', '👍', '😂', '😮', '😢', '🙏'].map(em => `
    <button class="reaction-btn-pop" data-react-emoji="${em}">${em}</button>
  `).join('');

  targetEl.style.position = 'relative';
  targetEl.appendChild(bar);

  bar.querySelectorAll('[data-react-emoji]').forEach(btn => {
    btn.onclick = async (e) => {
      e.stopPropagation();
      const em = btn.dataset.reactEmoji;
      bar.remove();
      try {
        await db.collection('messages').doc(msgId).update({
          [`reactions.${em}`]: firebase.firestore.FieldValue.arrayUnion(state.me.uid)
        });
        toast('Reacted with ' + em);
      } catch (err) { toast(err.message); }
    };
  });

  const closeDoc = (e) => {
    if (!bar.contains(e.target)) { bar.remove(); document.removeEventListener('click', closeDoc); }
  };
  setTimeout(() => document.addEventListener('click', closeDoc), 100);
}

// 3. Quoted Replies
function setReplyToMessage(msg) {
  state.replyingToMessage = msg;
  const attachBar = document.getElementById('chatAttachBar');
  const attachContent = document.getElementById('chatAttachPreviewContent');
  if (attachBar && attachContent) {
    attachContent.innerHTML = `
      <div style="border-left:3px solid var(--amber);padding-left:8px;">
        <b style="font-size:12px;">Replying to ${escapeHTML(msg.senderName || 'message')}</b>
        <div class="faint" style="font-size:11.5px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escapeHTML(msg.text || 'Attachment')}</div>
      </div>
    `;
    attachBar.classList.remove('hidden');
  }
}

// 4. Contact Info Drawer
function openContactInfoDrawer(user) {
  const drawer = document.getElementById('contactInfoDrawer');
  if (!drawer) return;
  drawer.classList.remove('hidden');

  document.getElementById('ciAvatar').innerHTML = avatarHTML(user, 'lg');
  document.getElementById('ciName').textContent = user.name || 'User';
  document.getElementById('ciUsername').textContent = '@' + (user.username || 'user');

  document.getElementById('contactInfoCloseBtn').onclick = () => drawer.classList.add('hidden');
  document.getElementById('ciVoiceBtn').onclick = () => { drawer.classList.add('hidden'); startCall(user, 'audio'); };
  document.getElementById('ciVideoBtn').onclick = () => { drawer.classList.add('hidden'); startCall(user, 'video'); };
  document.getElementById('ciBlockBtn').onclick = async () => {
    if (!confirm('Block this contact?')) return;
    try {
      await db.collection('blocks').doc(`${state.me.uid}_${user.id}`).set({
        blockedId: user.id, blockerId: state.me.uid, createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
      toast('Contact blocked.');
      drawer.classList.add('hidden');
    } catch (e) { toast(e.message); }
  };

  drawer.querySelectorAll('[data-wallpaper]').forEach(btn => {
    btn.onclick = () => {
      const wp = btn.dataset.wallpaper;
      state.chatWallpaper = wp;
      const chatBody = document.getElementById('chatBody');
      if (chatBody) {
        chatBody.className = 'chat-body wallpaper-' + wp;
      }
      toast('Chat wallpaper set to ' + wp);
    };
  });
}


async function boot() {
  document.getElementById('authView').style.display = 'none';
  document.getElementById('appView').classList.add('active');
  renderRailAvatar();
  startPresenceListener();
  startCallsListener();
  startIncomingMessagesListener();
  showView('feed');
  loadConversations();
  syncAllLocalVideosToCloud();
}

// Start
initFirebase();
</script>
</body>
</html>