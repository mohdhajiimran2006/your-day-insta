/* ==================================================================
   PRESENCE & WEBRTC CALLING (ROBUST P2P SIGNALING & AUDIO/VIDEO)
   ================================================================== */
function startPresenceListener() {
  if (state.presenceUnsub) state.presenceUnsub();
  state.presenceUnsub = db.collection('users').limit(40).onSnapshot((snap) => {
    snap.docChanges().forEach(change => {
      const u = change.doc.data();
      const uid = change.doc.id;
      state.userCache.set(uid, { id: uid, ...u });
      const isOnline = !!u.isOnline && u.settings?.showOnlineStatus !== false;
      if (isOnline) state.onlineUserIds.add(uid);
      else state.onlineUserIds.delete(uid);

      const dot = document.querySelector(`[data-presence-dot="${uid}"]`);
      const text = document.querySelector(`[data-presence-text="${uid}"]`);
      if (dot) dot.classList.toggle('online', isOnline);
      if (text) text.textContent = isOnline ? 'Online' : 'Offline';
    });
  });
}

let activeListenerSessionTime = Date.now();

function startCallsListener() {
  if (state.callsUnsub) state.callsUnsub();
  activeListenerSessionTime = Date.now();

  state.callsUnsub = db.collection('calls')
    .where('to', '==', state.me.uid)
    .onSnapshot((snap) => {
      snap.docChanges().forEach(change => {
        if (change.type === 'added' || change.type === 'modified') {
          const callData = change.doc.data();
          if (callData && callData.status === 'calling') {
            // Ignore calls older than 90 seconds
            if (callData.createdAt) {
              const callTime = toDate(callData.createdAt).getTime();
              if (Date.now() - callTime > 90000) return;
            }
            showIncomingCall(change.doc.id, callData.fromUser, callData.kind, callData.offer);
          }
        }
      });
    }, (err) => console.warn('Calls listener note:', err));
}

const ICE_SERVERS = [
  { urls: 'stun:stun.l.google.com:19302' },
  { urls: 'stun:stun1.l.google.com:19302' },
  { urls: 'stun:stun2.l.google.com:19302' },
  { urls: 'stun:global.stun.twilio.com:3478' },
  {
    urls: 'turn:openrelay.metered.ca:80',
    username: 'openrelay',
    credential: 'openrelay'
  },
  {
    urls: 'turn:openrelay.metered.ca:443',
    username: 'openrelay',
    credential: 'openrelay'
  },
  {
    urls: 'turn:openrelay.metered.ca:443?transport=tcp',
    username: 'openrelay',
    credential: 'openrelay'
  }
];

function formatDuration(sec) {
  const m = Math.floor(sec / 60).toString().padStart(2, '0');
  const s = (sec % 60).toString().padStart(2, '0');
  return `${m}:${s}`;
}

function startCallTimer() {
  if (state.callTimerInterval) clearInterval(state.callTimerInterval);
  state.callSeconds = 0;
  const timerEl = document.getElementById('callTimer');
  if (timerEl) {
    timerEl.textContent = '00:00';
    timerEl.classList.remove('hidden');
  }
  state.callTimerInterval = setInterval(() => {
    state.callSeconds++;
    const el = document.getElementById('callTimer');
    if (el) el.textContent = formatDuration(state.callSeconds);
  }, 1000);
}

function stopCallTimer() {
  if (state.callTimerInterval) {
    clearInterval(state.callTimerInterval);
    state.callTimerInterval = null;
  }
  state.callSeconds = 0;
}

let callTimeoutTimer = null;

async function startCall(user, kind) {
  if (!user || !user.id) return toast('Invalid user to call.');
  if (user.id === state.me.uid) {
    toast('You cannot call your own account. Use a separate browser/incognito window to test calls between 2 accounts!');
    return;
  }

  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    toast('Calling requires microphone/camera permission on HTTPS or localhost.');
    return;
  }

  state.callPeerId = user.id;
  state.isMuted = false;
  state.isVideoOff = false;
  state.pendingIceCandidates = [];
  buildCallOverlay(user, kind, 'Calling…');
  playOutgoingRingTone();

  try {
    state.localStream = await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
      video: kind === 'video' ? { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: 'user' } : false
    });
  } catch (e) {
    try {
      state.localStream = await navigator.mediaDevices.getUserMedia({
        audio: true,
        video: kind === 'video'
      });
    } catch (e2) {
      stopRingTone();
      toast('Microphone/Camera permission required for calls: ' + e2.message);
      return endCall();
    }
  }

  const localVid = document.getElementById('localVideo');
  if (localVid) {
    localVid.muted = true;
    localVid.playsInline = true;
    localVid.srcObject = state.localStream;
    if (kind === 'video') {
      localVid.style.display = 'block';
      localVid.play().catch(err => console.warn('localVid play err:', err));
    } else {
      localVid.style.display = 'none';
    }
  }

  state.peerConnection = new RTCPeerConnection({ iceServers: ICE_SERVERS });
  state.remoteStream = new MediaStream();

  // Add all local tracks
  state.localStream.getTracks().forEach(t => state.peerConnection.addTrack(t, state.localStream));

  state.peerConnection.ontrack = (event) => {
    console.log('WebRTC ontrack received (caller):', event.track.kind);
    if (event.streams && event.streams[0]) {
      event.streams[0].getTracks().forEach(t => {
        if (!state.remoteStream.getTracks().find(x => x.id === t.id)) {
          state.remoteStream.addTrack(t);
        }
      });
    } else if (event.track) {
      if (!state.remoteStream.getTracks().find(x => x.id === event.track.id)) {
        state.remoteStream.addTrack(event.track);
      }
    }

    const remoteVid = document.getElementById('remoteVideo');
    const remoteAud = document.getElementById('remoteAudio');
    const avatarPlaceholder = document.getElementById('callAvatarPlaceholder');

    if (remoteVid && kind === 'video') {
      if (remoteVid.srcObject !== state.remoteStream) {
        remoteVid.srcObject = state.remoteStream;
        remoteVid.playsInline = true;
      }
      remoteVid.play().catch(err => {
        console.warn('remoteVideo play err (fallback muted):', err);
        remoteVid.muted = true;
        remoteVid.play().catch(() => {});
        const banner = document.getElementById('unmuteAudioBanner');
        if (banner) banner.classList.remove('hidden');
      });
      if (avatarPlaceholder) avatarPlaceholder.style.display = 'none';
    }

    if (remoteAud) {
      if (remoteAud.srcObject !== state.remoteStream) {
        remoteAud.srcObject = state.remoteStream;
        remoteAud.playsInline = true;
      }
      remoteAud.play().catch(err => {
        console.warn('remoteAudio play err:', err);
        const banner = document.getElementById('unmuteAudioBanner');
        if (banner) banner.classList.remove('hidden');
      });
    }
  };

  const callDoc = db.collection('calls').doc();
  state.activeCallId = callDoc.id;

  state.peerConnection.onicecandidate = (e) => {
    if (e.candidate) {
      callDoc.collection('callerCandidates').add(e.candidate.toJSON()).catch(err => console.warn('ICE add error:', err));
    }
  };

  const offer = await state.peerConnection.createOffer({
    offerToReceiveAudio: true,
    offerToReceiveVideo: kind === 'video'
  });
  await state.peerConnection.setLocalDescription(offer);

  await callDoc.set({
    from: state.me.uid,
    fromUser: { id: state.me.uid, name: state.me.name || 'User', username: state.me.username || 'user', avatar: state.me.avatar || '' },
    to: user.id,
    kind,
    offer: { type: offer.type, sdp: offer.sdp },
    status: 'calling',
    createdAt: firebase.firestore.FieldValue.serverTimestamp()
  });

  // 45-second watchdog
  if (callTimeoutTimer) clearTimeout(callTimeoutTimer);
  callTimeoutTimer = setTimeout(async () => {
    if (state.activeCallId === callDoc.id) {
      toast('No answer.');
      stopRingTone();
      await callDoc.update({ status: 'ended' }).catch(() => {});
      endCall();
    }
  }, 45000);

  callDoc.onSnapshot(async (snapshot) => {
    const data = snapshot.data();
    if (data && data.status === 'connected' && data.answer && (!state.peerConnection || !state.peerConnection.remoteDescription)) {
      if (callTimeoutTimer) clearTimeout(callTimeoutTimer);
      try {
        await state.peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
        setCallStatus('Connected');
        stopRingTone();
        startCallTimer();

        // Drain buffered callee ICE candidates
        while (state.pendingIceCandidates && state.pendingIceCandidates.length > 0) {
          const cand = state.pendingIceCandidates.shift();
          await state.peerConnection.addIceCandidate(cand).catch(e => console.warn('Drain cand err:', e));
        }
      } catch (err) {
        console.warn('setRemoteDescription error:', err);
      }
    }
    if (data && (data.status === 'declined' || data.status === 'ended')) {
      if (callTimeoutTimer) clearTimeout(callTimeoutTimer);
      stopRingTone();
      toast('Call ' + data.status);
      endCall();
    }
  });

  callDoc.collection('calleeCandidates').onSnapshot(snap => {
    snap.docChanges().forEach(change => {
      if (change.type === 'added') {
        const candData = change.doc.data();
        if (candData && candData.candidate) {
          try {
            const cand = new RTCIceCandidate(candData);
            if (state.peerConnection && state.peerConnection.remoteDescription) {
              state.peerConnection.addIceCandidate(cand).catch(err => console.warn('ICE add err:', err));
            } else {
              state.pendingIceCandidates.push(cand);
            }
          } catch (e) {
            console.warn('calleeCandidate parse error:', e);
          }
        }
      }
    });
  });
}

function showIncomingCall(callId, fromUser, kind, offer) {
  if (document.getElementById('incomingCallOverlay')) return;
  playIncomingMelody();

  // Heads-up notification on mobile / lock screen
  showPushNotification(`📞 Incoming ${kind === 'video' ? 'Video' : 'Voice'} Call`, {
    body: `${fromUser?.name || fromUser?.username || 'Someone'} is calling you…`,
    icon: fromUser?.avatar || '',
    tag: 'call-' + callId,
    vibrate: [400, 200, 400, 200, 800],
    requireInteraction: true
  });

  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.id = 'incomingCallOverlay';
  overlay.style.zIndex = '99999';
  overlay.innerHTML = `
    <div class="modal" style="text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.9);">
      ${avatarHTML(fromUser, 'lg')}
      <h3 style="margin-top:16px;">${escapeHTML(fromUser?.name || fromUser?.username || 'User')}</h3>
      <p class="muted">Incoming ${kind} call…</p>
      <div class="modal-actions" style="justify-content:center;gap:18px;">
        <button class="btn btn-danger" id="declineCallBtn">Decline</button>
        <button class="btn btn-primary" id="acceptCallBtn">Accept</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);

  // Auto-dismiss if caller cancels
  const incomingWatcher = db.collection('calls').doc(callId).onSnapshot(doc => {
    const data = doc.data();
    if (!data || data.status === 'ended' || data.status === 'declined') {
      stopRingTone();
      incomingWatcher();
      overlay.remove();
    }
  });

  overlay.querySelector('#declineCallBtn').addEventListener('click', async () => {
    stopRingTone();
    incomingWatcher();
    await db.collection('calls').doc(callId).update({ status: 'declined' }).catch(() => {});
    overlay.remove();
  });

  overlay.querySelector('#acceptCallBtn').addEventListener('click', async () => {
    stopRingTone();
    incomingWatcher();
    overlay.remove();
    await acceptCall(callId, fromUser, kind, offer);
  });
}

async function acceptCall(callId, fromUser, kind, offer) {
  state.activeCallId = callId;
  state.callPeerId = fromUser?.id;
  state.isMuted = false;
  state.isVideoOff = false;
  state.pendingIceCandidates = [];
  buildCallOverlay(fromUser, kind, 'Connected');
  startCallTimer();

  try {
    state.localStream = await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
      video: kind === 'video' ? { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: 'user' } : false
    });
  } catch (e) {
    try {
      state.localStream = await navigator.mediaDevices.getUserMedia({
        audio: true,
        video: kind === 'video'
      });
    } catch (e2) {
      toast('Microphone/Camera access required for calls: ' + e2.message);
      return endCall();
    }
  }

  const localVid = document.getElementById('localVideo');
  if (localVid) {
    localVid.muted = true;
    localVid.playsInline = true;
    localVid.srcObject = state.localStream;
    if (kind === 'video') {
      localVid.style.display = 'block';
      localVid.play().catch(err => console.warn('localVideo play err:', err));
    } else {
      localVid.style.display = 'none';
    }
  }

  state.peerConnection = new RTCPeerConnection({ iceServers: ICE_SERVERS });
  state.remoteStream = new MediaStream();

  state.localStream.getTracks().forEach(t => state.peerConnection.addTrack(t, state.localStream));

  state.peerConnection.ontrack = (event) => {
    console.log('WebRTC ontrack received (callee):', event.track.kind);
    if (event.streams && event.streams[0]) {
      event.streams[0].getTracks().forEach(t => {
        if (!state.remoteStream.getTracks().find(x => x.id === t.id)) {
          state.remoteStream.addTrack(t);
        }
      });
    } else if (event.track) {
      if (!state.remoteStream.getTracks().find(x => x.id === event.track.id)) {
        state.remoteStream.addTrack(event.track);
      }
    }

    const remoteVid = document.getElementById('remoteVideo');
    const remoteAud = document.getElementById('remoteAudio');
    const avatarPlaceholder = document.getElementById('callAvatarPlaceholder');

    if (remoteVid && kind === 'video') {
      if (remoteVid.srcObject !== state.remoteStream) {
        remoteVid.srcObject = state.remoteStream;
        remoteVid.playsInline = true;
      }
      remoteVid.play().catch(err => {
        console.warn('remoteVideo play err (callee, fallback muted):', err);
        remoteVid.muted = true;
        remoteVid.play().catch(() => {});
        const banner = document.getElementById('unmuteAudioBanner');
        if (banner) banner.classList.remove('hidden');
      });
      if (avatarPlaceholder) avatarPlaceholder.style.display = 'none';
    }

    if (remoteAud) {
      if (remoteAud.srcObject !== state.remoteStream) {
        remoteAud.srcObject = state.remoteStream;
        remoteAud.playsInline = true;
      }
      remoteAud.play().catch(err => {
        console.warn('remoteAudio play err:', err);
        const banner = document.getElementById('unmuteAudioBanner');
        if (banner) banner.classList.remove('hidden');
      });
    }
  };

  const callDoc = db.collection('calls').doc(callId);

  state.peerConnection.onicecandidate = (e) => {
    if (e.candidate) {
      callDoc.collection('calleeCandidates').add(e.candidate.toJSON()).catch(err => console.warn('ICE add error:', err));
    }
  };

  try {
    await state.peerConnection.setRemoteDescription(new RTCSessionDescription(offer));
    const answer = await state.peerConnection.createAnswer();
    await state.peerConnection.setLocalDescription(answer);

    await callDoc.update({
      answer: { type: answer.type, sdp: answer.sdp },
      status: 'connected'
    });
  } catch (err) {
    console.error('acceptCall negotiation error:', err);
    toast('Call setup error: ' + err.message);
    return endCall();
  }

  // Drain buffered caller candidates
  while (state.pendingIceCandidates && state.pendingIceCandidates.length > 0) {
    const cand = state.pendingIceCandidates.shift();
    await state.peerConnection.addIceCandidate(cand).catch(e => console.warn('Drain cand err:', e));
  }

  callDoc.collection('callerCandidates').onSnapshot(snap => {
    snap.docChanges().forEach(change => {
      if (change.type === 'added') {
        const candData = change.doc.data();
        if (candData && candData.candidate) {
          try {
            const cand = new RTCIceCandidate(candData);
            if (state.peerConnection && state.peerConnection.remoteDescription) {
              state.peerConnection.addIceCandidate(cand).catch(err => console.warn('ICE add err:', err));
            } else {
              state.pendingIceCandidates.push(cand);
            }
          } catch (e) {
            console.warn('callerCandidate parse error:', e);
          }
        }
      }
    });
  });

  callDoc.onSnapshot(snap => {
    const data = snap.data();
    if (data && (data.status === 'ended' || data.status === 'declined')) {
      toast('Call ended.');
      endCall();
    }
  });
}

function buildCallOverlay(user, kind, status) {
  const overlay = document.createElement('div');
  overlay.className = 'call-overlay';
  overlay.id = 'callOverlay';
  overlay.innerHTML = `
    <div class="call-title">${escapeHTML(user?.name || user?.username || 'Call')}</div>
    <div class="call-sub">
      <span id="callStatus">${status}</span>
      <span class="call-timer ${status === 'Connected' ? '' : 'hidden'}" id="callTimer">00:00</span>
    </div>

    <!-- Pulsing avatar placeholder for audio calls or while video is connecting -->
    <div class="call-avatar-wrap" id="callAvatarPlaceholder" style="${kind === 'video' ? 'margin:12px 0;' : 'margin:24px 0;'}">
      <div class="call-pulse-ring">
        ${avatarHTML(user, 'lg')}
      </div>
    </div>

    <!-- Dedicated audio element for reliable remote voice playback -->
    <audio id="remoteAudio" autoplay playsinline></audio>

    <!-- Video container for remote and local PIP viewports -->
    <div class="call-video-container ${kind === 'video' ? '' : 'hidden'}" id="callVideoContainer">
      <video id="remoteVideo" autoplay playsinline></video>
      <video id="localVideo" autoplay playsinline muted></video>
      <div id="unmuteAudioBanner" class="unmute-banner hidden">
        🔊 Tap to unmute sound
      </div>
    </div>

    <div class="call-controls">
      <button class="btn btn-icon" id="callMuteBtn" title="Mute/Unmute microphone" style="background:#262a3f;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
      </button>
      ${kind === 'video' ? `
      <button class="btn btn-icon" id="callCamBtn" title="Camera On/Off" style="background:#262a3f;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
      </button>` : ''}
      <button class="btn btn-icon btn-danger" id="hangupBtn" title="End call">
        <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M12 9c-2.6 0-5 .8-7 2.2a1 1 0 0 0-.2 1.4l2 2.7a1 1 0 0 0 1.3.3c.9-.5 1.9-.8 2.9-1v-2.4c0-.4.3-.8.7-.9 1.5-.4 3-.4 4.5 0 .4.1.7.5.7.9v2.4c1 .2 2 .5 2.9 1a1 1 0 0 0 1.3-.3l2-2.7a1 1 0 0 0-.2-1.4C17 9.8 14.6 9 12 9z"/></svg>
      </button>
    </div>`;
  document.body.appendChild(overlay);

  const banner = overlay.querySelector('#unmuteAudioBanner');
  if (banner) {
    banner.addEventListener('click', () => {
      const remoteVid = document.getElementById('remoteVideo');
      const remoteAud = document.getElementById('remoteAudio');
      if (remoteVid) { remoteVid.muted = false; remoteVid.play().catch(() => {}); }
      if (remoteAud) { remoteAud.play().catch(() => {}); }
      banner.classList.add('hidden');
      toast('Audio unmuted 🔊');
    });
  }

  overlay.querySelector('#callMuteBtn').addEventListener('click', () => {
    if (!state.localStream) return;
    const audioTrack = state.localStream.getAudioTracks()[0];
    if (audioTrack) {
      state.isMuted = !state.isMuted;
      audioTrack.enabled = !state.isMuted;
      overlay.querySelector('#callMuteBtn').style.opacity = state.isMuted ? '0.5' : '1';
      toast(state.isMuted ? 'Microphone muted' : 'Microphone unmuted');
    }
  });

  const camBtn = overlay.querySelector('#callCamBtn');
  if (camBtn) {
    camBtn.addEventListener('click', () => {
      if (!state.localStream) return;
      const videoTrack = state.localStream.getVideoTracks()[0];
      if (videoTrack) {
        state.isVideoOff = !state.isVideoOff;
        videoTrack.enabled = !state.isVideoOff;
        camBtn.style.opacity = state.isVideoOff ? '0.5' : '1';
        toast(state.isVideoOff ? 'Camera turned off' : 'Camera turned on');
      }
    });
  }

  overlay.querySelector('#hangupBtn').addEventListener('click', () => {
    stopRingTone();
    if (callTimeoutTimer) clearTimeout(callTimeoutTimer);
    if (state.activeCallId && db) {
      db.collection('calls').doc(state.activeCallId).update({ status: 'ended' }).catch(() => {});
    }
    endCall();
  });
}

function setCallStatus(text) {
  const el = document.getElementById('callStatus');
  if (el) el.textContent = text;
}

function endCall() {
  stopRingTone();
  stopCallTimer();
  if (callTimeoutTimer) clearTimeout(callTimeoutTimer);
  if (state.peerConnection) {
    state.peerConnection.ontrack = null;
    state.peerConnection.onicecandidate = null;
    state.peerConnection.close();
    state.peerConnection = null;
  }
  if (state.localStream) {
    state.localStream.getTracks().forEach(t => t.stop());
    state.localStream = null;
  }
  if (state.remoteStream) {
    state.remoteStream.getTracks().forEach(t => t.stop());
    state.remoteStream = null;
  }
  const overlay = document.getElementById('callOverlay');
  if (overlay) overlay.remove();
  state.callPeerId = null;
  state.activeCallId = null;
  state.pendingIceCandidates = [];
}

/* ==================================================================
   REALTIME MESSAGE NOTIFICATION LISTENER (WHATSAPP-STYLE ALERT)
   ================================================================== */
function startIncomingMessagesListener() {
  if (state.incomingMessagesUnsub) state.incomingMessagesUnsub();
  const startTime = new Date();
  state.incomingMessagesUnsub = db.collection('messages')
    .where('receiverId', '==', state.me.uid)
    .onSnapshot(snap => {
      snap.docChanges().forEach(async change => {
        if (change.type === 'added') {
          const m = change.doc.data();
          const createdAt = toDate(m.createdAt);
          // Only alert for fresh messages in current session or last 20 seconds
          if (createdAt >= startTime || (Date.now() - createdAt.getTime()) < 20000) {
            const isViewingThisChat = state.view === 'chat' && state.activeConvUserId === m.senderId && !document.hidden;
            if (!isViewingThisChat) {
              playMessageChime();
              let sender = state.userCache.get(m.senderId);
              if (!sender) {
                try {
                  const sDoc = await db.collection('users').doc(m.senderId).get();
                  sender = sDoc.exists ? sDoc.data() : { name: 'Friend', username: 'user' };
                  state.userCache.set(m.senderId, sender);
                } catch (e) {
                  sender = { name: 'Friend', username: 'user' };
                }
              }
              const senderName = sender.name || ('@' + sender.username);
              const preview = m.image ? '📷 Sent a photo' : (m.file ? '📄 Sent a file' : (m.text || 'New message'));
              showPushNotification(senderName, {
                body: preview,
                icon: sender.avatar || '',
                tag: 'msg-' + m.senderId,
                data: {
                  url: './index.html',
                  chatWith: { id: m.senderId, name: sender.name || '', username: sender.username || '', avatar: sender.avatar || '' }
                }
              });
            }
          }
        }
      });
    }, err => console.warn('Incoming messages listener note:', err));
}

/* ==================================================================
   BOOT
   ================================================================== */
function renderRailAvatar() {
  const el = document.getElementById('railAvatar');
  if (state.me && state.me.avatar) {
    el.style.backgroundImage = `url('${state.me.avatar}')`;
    el.textContent = '';
  } else {
    el.style.backgroundImage = 'none';
    el.textContent = initials(state.me ? (state.me.name || state.me.username) : '?');
  }
}


/* ==================================================================
   24-HOUR STORIES, NOTES & INSTAGRAM REELS ENGINE
   ================================================================== */

const STORY_TTL_MS = 24 * 60 * 60 * 1000; // Strictly 24 Hours (86,400,000 ms)

function isStoryWithin24Hours(createdAt) {
  if (!createdAt) return true;
  const createdTime = toDate(createdAt).getTime();
  if (isNaN(createdTime)) return true;
  return (Date.now() - createdTime) < STORY_TTL_MS;
}

function formatStoryRemaining(createdAt) {
  if (!createdAt) return '24h left';
  const createdTime = toDate(createdAt).getTime();
  if (isNaN(createdTime)) return '24h left';
  const elapsedMs = Date.now() - createdTime;
  const remainingMs = Math.max(0, STORY_TTL_MS - elapsedMs);
  const remHours = Math.ceil(remainingMs / (60 * 60 * 1000));
  return `${timeAgo(createdAt)} · ${remHours}h left`;
}

// 1. Strictly 24-Hour Stories System (Supports BOTH Video <=35s/<=125MB & Photo Stories — 100% Reliable Upload!)
function safeReadLocalStories() {
  try {
    const raw = JSON.parse(localStorage.getItem('ydd_local_stories') || '[]');
    if (!Array.isArray(raw)) return [];
    return raw.filter(s => s && isStoryWithin24Hours(s.createdAt));
  } catch (e) {
    return [];
  }
}

function safeSaveLocalStory(storyObj) {
  if (!state.storiesCache) state.storiesCache = [];
  state.storiesCache = [storyObj, ...state.storiesCache.filter(s => s.id !== storyObj.id && s.userId !== state.me.uid)];
  state.storiesCacheTime = Date.now();

  try {
    const existing = safeReadLocalStories().filter(s => s.id !== storyObj.id && s.userId !== state.me.uid);
    // Keep localStorage payload compact so it NEVER throws QuotaExceededError
    const compact = {
      id: storyObj.id,
      userId: storyObj.userId,
      author: storyObj.author,
      image: storyObj.image || storyObj.posterImage || null,
      posterImage: storyObj.posterImage || storyObj.image || null,
      hasVideo: !!storyObj.hasVideo,
      videoKey: storyObj.videoKey || null,
      videoDuration: storyObj.videoDuration || 6,
      audioTrack: storyObj.audioTrack || '',
      audioTrackId: storyObj.audioTrackId || '',
      viewedBy: storyObj.viewedBy || [state.me.uid],
      createdAt: storyObj.createdAt || new Date().toISOString()
    };
    existing.unshift(compact);
    localStorage.setItem('ydd_local_stories', JSON.stringify(existing.slice(0, 4)));
  } catch (quotaErr) {
    try {
      localStorage.removeItem('ydd_local_stories');
    } catch (e) {}
  }
}

async function processAndUploadStoryFile(file, extraMeta = {}) {
  if (!file) return null;
  const isVideo = file.type.startsWith('video/');
  const nowIso = new Date().toISOString();
  let compressedImg = null;
  let videoKey = null;
  let inlineSmallVideo = null;
  let clipDuration = 6;

  if (isVideo) {
    const res = await readVideoFileLimited(file);
    clipDuration = Math.min(MAX_REEL_DURATION_SEC, Math.max(1, Math.round(res.duration || 15)));
    compressedImg = res.posterImage || '';
    inlineSmallVideo = res.smallDataUrl || null;
    videoKey = `story_vid_${state.me.uid}_${Date.now()}`;
    await YDDVideoDB.saveVideo(videoKey, file);
  } else {
    // Compress photo to 900px @ 0.78 quality (~140KB) so Firestore and localStorage NEVER fail
    compressedImg = await compressImage(file, 900, 0.78);
  }

  const storyObj = {
    id: 'story_' + Date.now(),
    isStory: true,
    mediaType: 'STORY',
    userId: state.me.uid,
    username: state.me.username,
    name: state.me.name,
    avatar: state.me.avatar || '',
    author: {
      id: state.me.uid,
      name: state.me.name,
      username: state.me.username,
      avatar: state.me.avatar || ''
    },
    image: isVideo ? null : compressedImg,
    posterImage: isVideo ? compressedImg : null,
    hasVideo: isVideo,
    video: inlineSmallVideo,
    videoKey: videoKey,
    videoDuration: clipDuration,
    audioTrack: extraMeta.audioTrack || '',
    audioTrackId: extraMeta.audioTrackId || '',
    viewedBy: [state.me.uid],
    createdAt: nowIso,
    expiresAt: Date.now() + STORY_TTL_MS
  };

  // Save Story into 'posts' collection (100% permitted for all users in live Firestore rules!)
  try {
    const docRef = await db.collection('posts').add({
      isStory: true,
      mediaType: 'STORY',
      userId: state.me.uid,
      username: state.me.username,
      name: state.me.name,
      avatar: state.me.avatar || '',
      author: storyObj.author,
      image: isVideo ? null : compressedImg,
      posterImage: isVideo ? compressedImg : null,
      hasVideo: isVideo,
      video: inlineSmallVideo,
      videoKey: videoKey,
      videoDuration: clipDuration,
      audioTrack: storyObj.audioTrack,
      audioTrackId: storyObj.audioTrackId,
      viewedBy: [state.me.uid],
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      expiresAt: Date.now() + STORY_TTL_MS
    });
    storyObj.id = docRef.id;
    if (isVideo && !inlineSmallVideo) {
      await saveCloudVideoChunks('posts', docRef.id, file);
    }
  } catch (fErr) {
    console.warn('Story cloud sync error:', fErr.message);
  }

  safeSaveLocalStory(storyObj);
  return storyObj;
}

async function renderStoriesTray(forceRefresh = false) {
  const tray = document.getElementById('feedStoriesTray');
  if (!tray) return;

  const localStories = safeReadLocalStories();
  const seenIds = new Set();
  const validStories = [];

  localStories.forEach(s => {
    if (s && s.id && !seenIds.has(s.id) && canViewerSeeStory(s)) {
      seenIds.add(s.id);
      validStories.push(s);
      // Auto-sync any pre-existing local story (id starting with 'story_') to 'posts' collection
      if (String(s.id).startsWith('story_') && s.userId === state.me?.uid && !s._syncingToPosts) {
        s._syncingToPosts = true;
        db.collection('posts').add({
          isStory: true,
          mediaType: 'STORY',
          userId: state.me.uid,
          username: state.me.username,
          name: state.me.name,
          avatar: state.me.avatar || '',
          author: s.author || { id: state.me.uid, name: state.me.name, username: state.me.username, avatar: state.me.avatar || '' },
          image: s.hasVideo ? null : (s.image || s.posterImage || null),
          posterImage: s.hasVideo ? (s.posterImage || s.image || null) : null,
          hasVideo: !!s.hasVideo,
          videoKey: s.videoKey || null,
          videoDuration: s.videoDuration || 6,
          audioTrack: s.audioTrack || '',
          audioTrackId: s.audioTrackId || '',
          viewedBy: [state.me.uid],
          createdAt: firebase.firestore.FieldValue.serverTimestamp(),
          expiresAt: Date.now() + STORY_TTL_MS
        }).then(docRef => {
          s.id = docRef.id;
          safeSaveLocalStory(s);
          if (s.hasVideo && s.videoKey) {
            YDDVideoDB.getVideoBlob(s.videoKey).then(blob => {
              if (blob) saveCloudVideoChunks('posts', docRef.id, blob);
            }).catch(() => {});
          }
        }).catch(() => {});
      }
    }
  });

  if (!forceRefresh && state.storiesCache && state.storiesCache.length && (Date.now() - (state.storiesCacheTime || 0) < 20000)) {
    state.storiesCache.forEach(s => {
      if (s && s.id && !seenIds.has(s.id) && isStoryWithin24Hours(s.createdAt) && canViewerSeeStory(s)) {
        seenIds.add(s.id);
        validStories.push(s);
      }
    });
  } else {
    try {
      const [restRes, sdkRes] = await Promise.allSettled([
        fetchPostsViaRest(120),
        db ? db.collection('posts').limit(120).get() : Promise.resolve(null)
      ]);
      const rawDocs = [];
      if (restRes.status === 'fulfilled' && Array.isArray(restRes.value)) {
        rawDocs.push(...restRes.value);
      }
      if (sdkRes.status === 'fulfilled' && sdkRes.value && sdkRes.value.docs) {
        sdkRes.value.docs.forEach(d => rawDocs.push({ id: d.id, ...d.data() }));
      }
      const byId = new Map();
      rawDocs.forEach(d => {
        if (!d || !d.id) return;
        const prev = byId.get(d.id);
        byId.set(d.id, prev ? { ...prev, ...d, videoChunkCount: Math.max(Number(prev.videoChunkCount) || 0, Number(d.videoChunkCount) || 0) } : d);
      });

      const fetched = [];
      byId.forEach((data, docId) => {
        if (!data.isStory && data.mediaType !== 'STORY') return;
        if (!isStoryWithin24Hours(data.createdAt)) {
          if (data.userId === state.me?.uid && db) {
            db.collection('posts').doc(docId).delete().catch(() => {});
          }
          return;
        }
        if ((data.image || data.hasVideo || data.video || data.videoKey || data.posterImage)) {
          const item = {
            id: docId,
            ...data,
            videoChunkCount: Number(data.videoChunkCount) || 0,
            createdAt: data.createdAt ? toDate(data.createdAt).toISOString() : new Date().toISOString()
          };
          if (!canViewerSeeStory(item)) return;
          fetched.push(item);
          if (!seenIds.has(docId)) {
            seenIds.add(docId);
            validStories.push(item);
          }
        }
      });
      // Sort newest first so latest uploaded story is always shown first!
      fetched.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
      state.storiesCache = fetched;
      state.storiesCacheTime = Date.now();
    } catch (err) {
      console.warn('Stories sync notice:', err.message);
    }
  }

  // Always sort validStories newest-first
  validStories.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));

  const myStory = validStories.find(s => s.userId === state.me.uid);
  // Deduplicate other users so each followed user has 1 ring in the tray (showing their newest story)
  const seenUsers = new Set([state.me.uid]);
  const otherStories = [];
  validStories.forEach(s => {
    if (s.userId && !seenUsers.has(s.userId) && canViewerSeeStory(s)) {
      seenUsers.add(s.userId);
      otherStories.push(s);
    }
  });

  // Note: Place <input id="selfStoryFileInput"> OUTSIDE #addSelfStoryBtn so fileInput.click() NEVER bubbles back into #addSelfStoryBtn!
  let html = `
    <input type="file" id="selfStoryFileInput" accept="image/*,video/*" class="hidden">
    <div class="story-item" id="addSelfStoryBtn">
      <div class="story-ring-wrap ${myStory ? '' : 'add-self'}">
        ${avatarHTML(state.me)}
        <div class="story-add-badge" id="selfStoryPlusBadge" title="Upload New Photo or Video Story">+</div>
      </div>
      <span class="story-uname">Your story</span>
    </div>
  `;

  otherStories.forEach(s => {
    const author = s.author || { name: s.name || 'User', username: s.username || 'user', avatar: s.avatar || '' };
    html += `
      <div class="story-item" data-story-id="${s.id}">
        <div class="story-ring-wrap">
          ${avatarHTML(author)}
        </div>
        <span class="story-uname">${escapeHTML(author.username || 'user')}</span>
      </div>
    `;
  });

  tray.innerHTML = html;
  state.activeStoriesList = validStories;

  const addBtn = tray.querySelector('#addSelfStoryBtn');
  const plusBadge = tray.querySelector('#selfStoryPlusBadge');
  const fileInput = tray.querySelector('#selfStoryFileInput');

  if (plusBadge && fileInput) {
    plusBadge.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      fileInput.value = '';
      fileInput.click();
    });
  }

  if (addBtn && fileInput) {
    addBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!myStory) {
        fileInput.value = '';
        fileInput.click();
      } else {
        openStoryViewer(myStory);
      }
    });

    fileInput.addEventListener('change', async (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      fileInput.value = '';
      showLoader();
      try {
        const uploaded = await processAndUploadStoryFile(file);
        toast(uploaded.hasVideo ? '24h Video Story uploaded! 🎬' : '24h Photo Story uploaded! 📸');
        await renderStoriesTray(false);
        openStoryViewer(uploaded);
      } catch (err) {
        toast('Story upload error: ' + (err.message || err));
      } finally {
        hideLoader();
      }
    });
  }

  tray.querySelectorAll('[data-story-id]').forEach(el => {
    el.addEventListener('click', () => {
      const st = (state.activeStoriesList || []).find(x => x.id === el.dataset.storyId);
      if (st) openStoryViewer(st);
    });
  });
}

window.openStoryUploadPicker = function() {
  const inp = document.getElementById('selfStoryFileInput');
  if (inp) {
    inp.value = '';
    inp.click();
  } else {
    openCreateReelModal();
  }
};

window.openCreateNoteModal = async function() {
  const note = prompt('Share a short note (up to 60 chars):', state.me?.note || '');
  if (note !== null) {
    const clean = note.trim().slice(0, 60);
    showLoader();
    try {
      await db.collection('users').doc(state.me.uid).update({ note: clean });
      state.me.note = clean;
      if (state.userCache) state.userCache.set(state.me.uid, state.me);
      toast('Note updated! 💬');
      renderNotesTray();
      if (state.view === 'profile' && state.currentProfileUser?.id === state.me.uid) {
        showProfile(state.me.username);
      }
    } catch (e) { toast(e.message); }
    finally { hideLoader(); }
  }
};

async function openStoryViewer(story) {
  const modal = document.getElementById('storyViewerModal');
  const imgEl = document.getElementById('storyViewerImage');
  const vidEl = document.getElementById('storyViewerVideo');
  const unameEl = document.getElementById('storyViewerUsername');
  const timeEl = document.getElementById('storyViewerTime');
  const barsEl = document.getElementById('storyViewerBars');
  const viewsPill = document.getElementById('storyViewsPill');
  const delBtn = document.getElementById('storyDeleteBtn');
  const addAnotherBtn = document.getElementById('storyAddAnotherBtn');
  if (!modal || !imgEl) return;

  window.pauseAllMediaEverywhere();

  const isMine = story.userId === state.me.uid;
  const isVideoStory = !!(story.hasVideo || story.video || story.videoKey);
  const durationSec = isVideoStory ? Math.min(35, Math.max(4, Number(story.videoDuration) || 12)) : 6;

  unameEl.textContent = '@' + (story.author?.username || story.username || 'user');
  if (timeEl) timeEl.textContent = (isVideoStory ? '🎬 Video · ' : '') + formatStoryRemaining(story.createdAt);

  if (story.audioTrackId && !window.userExplicitlyMuted) {
    window.togglePlaySynthTrack(story.audioTrackId);
  }

  if (isVideoStory && vidEl) {
    imgEl.classList.add('hidden');
    vidEl.classList.remove('hidden');
    vidEl.dataset.usingCinemaFallback = 'false';
    if (vidEl._cinemaInterval) { clearInterval(vidEl._cinemaInterval); vidEl._cinemaInterval = null; }
    vidEl.srcObject = null;
    vidEl.removeAttribute('src');
    vidEl.poster = story.posterImage || story.image || '';
    vidEl.dataset.videoKey = story.videoKey || '';
    vidEl.dataset.storyDocId = story.id || '';
    vidEl.dataset.chunkCount = String(story.videoChunkCount || 0);
    vidEl.dataset.hydrated = 'false';
    if (story.video) {
      vidEl.src = story.video;
      vidEl.dataset.hydrated = 'true';
    } else {
      await hydrateVideoElements(modal);
    }
    vidEl.currentTime = 0;
    vidEl.muted = !!window.userExplicitlyMuted;
    vidEl.play().catch(() => {
      vidEl.muted = true;
      vidEl.play().catch(() => {});
    });
  } else {
    if (vidEl) {
      vidEl.pause();
      vidEl.dataset.usingCinemaFallback = 'false';
      if (vidEl._cinemaInterval) { clearInterval(vidEl._cinemaInterval); vidEl._cinemaInterval = null; }
      vidEl.srcObject = null;
      vidEl.removeAttribute('src');
      vidEl.classList.add('hidden');
    }
    imgEl.classList.remove('hidden');
    imgEl.src = story.image || story.posterImage || '';
  }

  const viewersSet = new Set(Array.isArray(story.viewedBy) ? story.viewedBy : []);
  if (state.me?.uid) viewersSet.add(state.me.uid);
  if (viewsPill) viewsPill.textContent = `👁️ ${viewersSet.size} ${viewersSet.size === 1 ? 'view' : 'views'}`;

  if (!isMine && story.id && !String(story.id).startsWith('story_')) {
    db.collection('posts').doc(story.id).update({
      viewedBy: firebase.firestore.FieldValue.arrayUnion(state.me.uid)
    }).catch(() => {});
  }

  const closeStoryModal = () => {
    clearTimeout(state.storyTimer);
    if (vidEl) {
      vidEl.pause();
      vidEl.dataset.usingCinemaFallback = 'false';
      if (vidEl._cinemaInterval) { clearInterval(vidEl._cinemaInterval); vidEl._cinemaInterval = null; }
      vidEl.srcObject = null;
      vidEl.removeAttribute('src');
    }
    stopSynthMusic();
    modal.classList.add('hidden');
  };

  if (delBtn) {
    delBtn.classList.toggle('hidden', !isMine);
    delBtn.onclick = async () => {
      closeStoryModal();
      try {
        const locals = safeReadLocalStories().filter(s => s.id !== story.id && s.userId !== state.me.uid);
        localStorage.setItem('ydd_local_stories', JSON.stringify(locals));
      } catch (e) {}
      if (state.storiesCache) {
        state.storiesCache = state.storiesCache.filter(s => s.id !== story.id);
      }
      if (story.id && !String(story.id).startsWith('story_')) {
        await db.collection('posts').doc(story.id).delete().catch(() => {});
      }
      toast('Story deleted.');
      renderStoriesTray(true);
    };
  }

  if (addAnotherBtn) {
    addAnotherBtn.classList.toggle('hidden', !isMine);
    addAnotherBtn.onclick = () => {
      closeStoryModal();
      const inp = document.getElementById('selfStoryFileInput');
      if (inp) {
        inp.value = '';
        inp.click();
      }
    };
  }

  barsEl.innerHTML = '<div class="story-bar"><div class="story-bar-fill" id="storyProgressFill"></div></div>';
  modal.classList.remove('hidden');

  const fillEl = document.getElementById('storyProgressFill');
  fillEl.style.transition = `width ${durationSec}s linear`;
  setTimeout(() => { fillEl.style.width = '100%'; }, 40);

  if (state.storyTimer) clearTimeout(state.storyTimer);
  state.storyTimer = setTimeout(closeStoryModal, durationSec * 1000 + 200);

  document.getElementById('storyCloseBtn').onclick = closeStoryModal;
  document.getElementById('storyTapRight').onclick = closeStoryModal;
  document.getElementById('storyTapLeft').onclick = () => {
    if (isVideoStory && vidEl) vidEl.currentTime = 0;
    fillEl.style.transition = 'none';
    fillEl.style.width = '0%';
    setTimeout(() => {
      fillEl.style.transition = `width ${durationSec}s linear`;
      fillEl.style.width = '100%';
    }, 30);
  };
  document.getElementById('storyLikeBtn').onclick = () => {
    playHeartPopSound();
    toast('Liked story ❤️');
  };
}

// 2. Direct Notes System (Image 1 inside Messages View)
async function renderNotesTray() {
  const tray = document.getElementById('feedNotesTray');
  if (!tray) return;

  const myNote = state.me?.note || 'Your thoughts go here...';
  let html = `
    <div class="note-item" id="addSelfNoteBtn">
      <div class="note-bubble-tag">${escapeHTML(myNote)}</div>
      ${avatarHTML(state.me)}
      <span class="story-uname">Your note</span>
      <span class="note-sub">Location off</span>
    </div>
  `;

  try {
    const snap = await db.collection('users').limit(40).get();
    snap.docs.forEach(d => {
      const u = d.data();
      state.userCache.set(d.id, { id: d.id, ...u });
      if (d.id !== state.me.uid && u.note && u.note.trim() && state.followingUserIds.has(d.id)) {
        html += `
          <div class="note-item" data-goto-profile="${escapeHTML(u.username || '')}">
            <div class="note-bubble-tag">${escapeHTML(u.note)}</div>
            ${avatarHTML({ name: u.name, username: u.username, avatar: u.avatar })}
            <span class="story-uname">${escapeHTML(u.name || u.username || '')}</span>
          </div>
        `;
      }
    });
  } catch (e) {}

  tray.innerHTML = html;

  const selfBtn = tray.querySelector('#addSelfNoteBtn');
  if (selfBtn) {
    selfBtn.addEventListener('click', () => window.openCreateNoteModal());
  }

  tray.querySelectorAll('[data-goto-profile]').forEach(el => {
    el.addEventListener('click', () => showProfile(el.dataset.gotoProfile));
  });
}

