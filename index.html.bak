// FAST PARALLEL USER CACHE ENGINE (0ms Cached Lookup)
async function getCachedUser(uid) {
  if (!uid) return null;
  if (state.userCache.has(uid)) return state.userCache.get(uid);
  try {
    const doc = await db.collection('users').doc(uid).get();
    if (doc.exists) {
      const u = { id: doc.id, uid: doc.id, ...doc.data() };
      state.userCache.set(uid, u);
      return u;
    }
  } catch (e) {}
  return null;
}

async function getCachedUsersParallel(uids) {
  const unique = Array.from(new Set((uids || []).filter(Boolean)));
  const results = await Promise.all(unique.map(id => getCachedUser(id)));
  return results.filter(Boolean);
}

function triggerHaptic(ms = 12) {
  if (state.me?.settings?.hapticFeedback !== false && navigator.vibrate) {
    try { navigator.vibrate(ms); } catch (e) {}
  }
}

function applyAllVisualSettings(settings = {}) {
  const s = { ...DEFAULT_SETTINGS, ...settings };
  if (s.theme) applyTheme(s.theme);
  if (s.fontFamily) document.documentElement.style.setProperty('--diary-font', s.fontFamily);
  if (s.fontScale) document.documentElement.style.fontSize = s.fontScale;
  if (s.accentColor) {
    document.documentElement.style.setProperty('--amber', s.accentColor);
    document.documentElement.style.setProperty('--amber-bright', s.accentColor);
  }
  document.body.classList.toggle('compact-feed', !!s.compactFeed);
  document.body.classList.toggle('high-contrast', !!s.highContrast);
  document.body.classList.toggle('hide-metrics-counts', !!s.hideLikeCounts);
  if (s.startVideosUnmuted !== undefined) {
    reelsAudioMuted = !s.startVideosUnmuted;
  }
}

