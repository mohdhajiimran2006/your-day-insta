const railProfWrap = document.getElementById('railProfileWrap');
if (railProfWrap) railProfWrap.addEventListener('click', () => showProfile(state.me.username));

const railCreateBtn = document.getElementById('railCreateBtn');
if (railCreateBtn) railCreateBtn.addEventListener('click', () => openCreateReelModal());
const topbarCreateBtn = document.getElementById('topbarCreateBtn');
if (topbarCreateBtn) topbarCreateBtn.addEventListener('click', () => openCreateReelModal());

function showView(view, opts = {}) {
  // Keep Groups inside Chat page only
  if (view === 'groups') {
    view = 'chat';
    opts = { ...opts, openGroupsTab: true };
  }
  state.view = view;
  const mainEl = document.querySelector('.main');
  if (mainEl) mainEl.setAttribute('data-active-view', view);

  document.querySelectorAll('.rail-btn[data-view]').forEach(b => b.classList.toggle('active', b.dataset.view === view));
  document.querySelectorAll('#viewScroll > section').forEach(s => s.classList.add('hidden'));
  const targetSec = document.getElementById('view-' + view);
  if (targetSec) targetSec.classList.remove('hidden');
  document.getElementById('topbarTitle').textContent = opts.title || titles[view] || '';

  // STRICT MEDIA RULE: Pause ALL videos & audio immediately when switching any view!
  if (typeof window.pauseAllMediaEverywhere === 'function') {
    window.pauseAllMediaEverywhere();
  }

  if (view !== 'chat' && !opts.keepActiveChat) {
    const convList = document.getElementById('convList');
    const chatPane = document.getElementById('chatPane');
    if (convList && chatPane) {
      convList.classList.remove('chat-active');
      chatPane.classList.remove('chat-active');
    }
  }

  if (view === 'feed') { loadFeed(); renderStoriesTray(); }
  if (view === 'reels') { loadReels(); }
  if (view === 'search') {
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
      performSearch(searchInput.value);
    }
  }
  if (view === 'chat') {
    const chatHandleEl = document.getElementById('chatHeaderHandleText');
    if (chatHandleEl && state.me?.username) {
      chatHandleEl.textContent = state.me.username;
    }
    renderNotesTray();
    loadConversations();
    loadGroups();
    if (opts.openGroupsTab && typeof window.switchChatListTab === 'function') {
      window.switchChatListTab('groups');
    }
  }
  if (view === 'settings') loadSettings();
}

/* ==================================================================
   FEED & POSTS (<=125MB & <=35S VIDEO ENGINE, STRICT VIEWPORT PLAYBACK)
   ================================================================== */
const MAX_REEL_DURATION_SEC = 35;
const MAX_VIDEO_FILE_BYTES = 125 * 1024 * 1024; // 125 MB exact limit

// INDEXED-DB BINARY VIDEO ENGINE (Stores up to 125MB videos natively without base64 quota errors)
const blobUrlMemoryCache = new Map();
const YDDVideoDB = {
  dbPromise: null,
  open() {
    if (this.dbPromise) return this.dbPromise;
    this.dbPromise = new Promise((resolve, reject) => {
      const req = indexedDB.open('YDDInstagramMediaDB', 1);
      req.onupgradeneeded = (e) => {
        const db = e.target.result;
        if (!db.objectStoreNames.contains('videos')) {
          db.createObjectStore('videos');
        }
      };
      req.onsuccess = (e) => resolve(e.target.result);
      req.onerror = (e) => reject(e.target.error);
    });
    return this.dbPromise;
  },
  async saveVideo(key, fileOrBlob) {
    try {
      const db = await this.open();
      await new Promise((resolve, reject) => {
        const tx = db.transaction('videos', 'readwrite');
        tx.objectStore('videos').put(fileOrBlob, key);
        tx.oncomplete = () => resolve();
        tx.onerror = (e) => reject(e.target.error);
      });
      const objUrl = URL.createObjectURL(fileOrBlob);
      blobUrlMemoryCache.set(key, objUrl);
      return objUrl;
    } catch (e) {
      console.warn('IndexedDB video save fallback:', e);
      return URL.createObjectURL(fileOrBlob);
    }
  },
  async getVideoBlob(key) {
    if (!key) return null;
    try {
      const db = await this.open();
      return await new Promise((resolve) => {
        const tx = db.transaction('videos', 'readonly');
        const req = tx.objectStore('videos').get(key);
        req.onsuccess = () => resolve(req.result || null);
        req.onerror = () => resolve(null);
      });
    } catch (e) {
      return null;
    }
  },
  async getVideoUrl(key) {
    if (!key) return null;
    if (blobUrlMemoryCache.has(key)) return blobUrlMemoryCache.get(key);
    const blob = await this.getVideoBlob(key);
    if (blob) {
      const url = URL.createObjectURL(blob);
      blobUrlMemoryCache.set(key, url);
      return url;
    }
    return null;
  }
};

// Pure-JS Base64 DataURL -> Blob converter fallback
function base64DataUrlToBlob(dataUrl) {
  try {
    const commaIdx = dataUrl.indexOf(',');
    if (commaIdx === -1) return null;
    const meta = dataUrl.slice(0, commaIdx);
    const base64 = dataUrl.slice(commaIdx + 1);
    const mimeMatch = meta.match(/data:([^;]+)/);
    const mime = mimeMatch ? mimeMatch[1] : 'video/mp4';
    const binary = atob(base64);
    const len = binary.length;
    const bytes = new Uint8Array(len);
    for (let i = 0; i < len; i++) {
      bytes[i] = binary.charCodeAt(i);
    }
    return new Blob([bytes], { type: mime });
  } catch (e) {
    console.warn('base64DataUrlToBlob error:', e);
    return null;
  }
}

// Ultra-fast Native C++ DataURL -> Blob converter (decodes 22MB in ~30ms without blocking UI thread)
async function fastDataUrlToBlob(dataUrl) {
  if (!dataUrl || typeof dataUrl !== 'string') return null;
  try {
    const res = await fetch(dataUrl);
    const blob = await res.blob();
    if (blob && blob.size > 0) return blob;
  } catch (e) {}
  return base64DataUrlToBlob(dataUrl);
}

// CLOUD VIDEO CHUNKS ENGINE (Uses top-level 'likes' collection with deterministic IDs chunk_{docId}_{i}
// via Parallel HTTP/2 REST + SDK fallback so uploads/downloads are 6x faster and never stall!)
const healedVideoDocs = new Set();
const inFlightCloudVideoDownloads = new Map();

async function writeChunkDocViaRestOrSdk(chunkDocId, chunkPayload, idToken) {
  if (idToken) {
    try {
      const restUrl = `${getFirestoreRestBaseUrl()}/likes?documentId=${encodeURIComponent(chunkDocId)}`;
      const body = {
        fields: {
          parentId: { stringValue: String(chunkPayload.parentId) },
          index: { integerValue: String(chunkPayload.index) },
          total: { integerValue: String(chunkPayload.total) },
          userId: { stringValue: String(chunkPayload.userId || '') },
          data: { stringValue: String(chunkPayload.data || '') }
        }
      };
      const res = await fetch(restUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${idToken}`
        },
        body: JSON.stringify(body)
      });
      // 200 = newly created; 409 = chunk already exists on server!
      if (res.ok || res.status === 409) return true;
    } catch (e) {}
  }
  // Fallback to Firestore SDK
  try {
    await db.collection('likes').doc(chunkDocId).set(chunkPayload);
    return true;
  } catch (e) {
    await db.collection('likes').doc(chunkDocId).delete().catch(() => {});
    await db.collection('likes').doc(chunkDocId).set(chunkPayload);
    return true;
  }
}

async function saveCloudVideoChunks(collectionName, docId, fileOrBlob, onProgress = null) {
  if (!fileOrBlob || !docId) return false;
  if (fileOrBlob.size > MAX_VIDEO_FILE_BYTES) return false;
  try {
    // Cache under deterministic post key immediately in local IndexedDB
    await YDDVideoDB.saveVideo(`vid_post_${docId}`, fileOrBlob).catch(() => {});

    const dataUrl = await readBlobAsDataURLUnlimited(fileOrBlob);
    const chunkSize = 650 * 1024; // ~650 KB per chunk doc (well under 1MB Firestore limit)
    const totalChunks = Math.ceil(dataUrl.length / chunkSize);

    // If only 1 chunk (<= 650KB), store directly in the post's 'video' field for 0ms instant playback!
    if (totalChunks === 1) {
      if (typeof onProgress === 'function') onProgress(50);
      await db.collection('posts').doc(docId).update({
        video: dataUrl,
        hasCloudVideoChunks: true,
        videoChunkCount: 1
      }).catch(() => {});
      if (typeof onProgress === 'function') onProgress(100);
      return true;
    }

    const idToken = (auth && auth.currentUser)
      ? await auth.currentUser.getIdToken().catch(() => null)
      : null;

    // Upload in parallel HTTP/2 batches of 8 chunks
    let completed = 0;
    const batchSize = 8;
    for (let start = 0; start < totalChunks; start += batchSize) {
      const batchWrites = [];
      for (let i = start; i < Math.min(totalChunks, start + batchSize); i++) {
        const slice = dataUrl.slice(i * chunkSize, (i + 1) * chunkSize);
        const chunkDocId = `chunk_${docId}_${i}`;
        const chunkPayload = {
          parentId: docId,
          index: i,
          total: totalChunks,
          userId: state.me?.uid || '',
          data: slice
        };
        batchWrites.push(
          writeChunkDocViaRestOrSdk(chunkDocId, chunkPayload, idToken).then(() => {
            completed++;
            if (typeof onProgress === 'function') {
              onProgress(Math.min(99, Math.round((completed / totalChunks) * 100)));
            }
          })
        );
      }
      await Promise.all(batchWrites);
    }

    await db.collection('posts').doc(docId).update({
      hasCloudVideoChunks: true,
      videoChunkCount: totalChunks
    }).catch(() => {});
    if (typeof onProgress === 'function') onProgress(100);
    return true;
  } catch (e) {
    console.warn('Cloud video chunk sync error:', e.message);
    return false;
  }
}

// Background Auto-Healer: Syncs any video in this browser's IndexedDB to Firestore chunks so all other users can play it
async function syncAllLocalVideosToCloud(postsArray = null) {
  if (!db || !state.me) return;
  try {
    let docsToCheck = postsArray;
    if (!docsToCheck) {
      docsToCheck = await fetchPostsViaRest(80);
    }
    for (const p of (docsToCheck || [])) {
      if (!p || !p.id || healedVideoDocs.has(p.id)) continue;
      const needsCloudSync = (p.hasVideo || p.isReel || p.videoKey) && !p.video && !p.videoChunkCount;
      if (needsCloudSync && p.videoKey) {
        const blob = await YDDVideoDB.getVideoBlob(p.videoKey);
        if (blob) {
          healedVideoDocs.add(p.id);
          saveCloudVideoChunks('posts', p.id, blob).catch(() => {});
        }
      }
    }
  } catch (e) {}
}

async function fetchSingleChunkData(docId, idx) {
  const chunkDocId = `chunk_${docId}_${idx}`;
  // 1. Direct HTTP/2 REST GET (fast, bypasses Firestore SDK queue)
  const restDoc = await fetchSingleDocViaRest('likes', chunkDocId);
  if (restDoc && restDoc.data) {
    return restDoc;
  }
  // 2. Fallback to Firestore SDK
  if (db) {
    const snap = await db.collection('likes').doc(chunkDocId).get().catch(() => null);
    if (snap && snap.exists) return snap.data();
  }
  return null;
}

async function fetchCloudVideoUrl(collectionName, docId, cacheKey, chunkCountHint = 0, onProgress = null) {
  if (!docId) return null;
  const finalKey = cacheKey || `vid_post_${docId}`;
  const postCacheKey = `vid_post_${docId}`;

  if (blobUrlMemoryCache.has(finalKey)) return blobUrlMemoryCache.get(finalKey);
  if (blobUrlMemoryCache.has(postCacheKey)) return blobUrlMemoryCache.get(postCacheKey);

  const cachedLocal = await YDDVideoDB.getVideoUrl(finalKey) || await YDDVideoDB.getVideoUrl(postCacheKey);
  if (cachedLocal) return cachedLocal;

  // Deduplicate concurrent downloads for the same docId
  if (inFlightCloudVideoDownloads.has(docId)) {
    return inFlightCloudVideoDownloads.get(docId);
  }

  const downloadPromise = (async () => {
    try {
      let chunkCount = Number(chunkCountHint) || 0;
      if (!chunkCount) {
        const postData = await fetchSingleDocViaRest('posts', docId) ||
          (db ? await db.collection('posts').doc(docId).get().then(d => d.exists ? d.data() : null).catch(() => null) : null);
        if (postData) {
          if (postData.video && String(postData.video).startsWith('data:')) {
            const inlineBlob = await fastDataUrlToBlob(postData.video);
            if (inlineBlob) {
              await YDDVideoDB.saveVideo(postCacheKey, inlineBlob).catch(() => {});
              return await YDDVideoDB.saveVideo(finalKey, inlineBlob);
            }
          }
          chunkCount = Number(postData.videoChunkCount) || 0;
        }
      }

      // If chunkCount still unknown, probe chunk_0 directly via REST
      let chunk0Data = null;
      if (!chunkCount) {
        chunk0Data = await fetchSingleChunkData(docId, 0);
        if (chunk0Data && chunk0Data.data) {
          chunkCount = Number(chunk0Data.total) || 1;
        }
      }

      if (chunkCount > 0) {
        const slices = new Array(chunkCount).fill('');
        let downloaded = 0;
        if (chunk0Data && chunk0Data.data) {
          slices[0] = chunk0Data.data;
          downloaded = 1;
          if (typeof onProgress === 'function') {
            onProgress(Math.round((downloaded / chunkCount) * 100));
          }
        }

        const batchSize = 12;
        const startIdx = slices[0] ? 1 : 0;
        for (let start = startIdx; start < chunkCount; start += batchSize) {
          const batch = [];
          for (let i = start; i < Math.min(chunkCount, start + batchSize); i++) {
            batch.push(
              fetchSingleChunkData(docId, i).then(c => {
                if (c && c.data) {
                  slices[i] = c.data;
                  downloaded++;
                  if (typeof onProgress === 'function') {
                    onProgress(Math.min(99, Math.round((downloaded / chunkCount) * 100)));
                  }
                }
              })
            );
          }
          await Promise.all(batch);
        }

        if (slices.every(Boolean)) {
          const fullDataUrl = slices.join('');
          const blob = await fastDataUrlToBlob(fullDataUrl);
          if (blob) {
            if (typeof onProgress === 'function') onProgress(100);
            if (finalKey !== postCacheKey) {
              await YDDVideoDB.saveVideo(postCacheKey, blob).catch(() => {});
            }
            return await YDDVideoDB.saveVideo(finalKey, blob);
          }
        }
      }
    } catch (e) {
      console.warn('fetchCloudVideoUrl note:', e.message);
    } finally {
      inFlightCloudVideoDownloads.delete(docId);
    }
    return null;
  })();

  inFlightCloudVideoDownloads.set(docId, downloadPromise);
  return downloadPromise;
}

// Background HD Cloud Video Upgrader: downloads chunked video via parallel HTTP/2 REST
// while the video card is already playing, and hot-swaps to real HD MP4 + audio seamlessly!
function upgradeVideoElementFromCloud(v, postDocId, key, chunkCountHint = 0) {
  if (!v || !postDocId || v._cloudUpgrading) return;
  v._cloudUpgrading = true;

  const container = v.closest('.reel-card, .post-media-container') || v.parentElement;
  let badge = container ? container.querySelector('.cloud-hd-sync-pill') : null;
  if (container && !badge) {
    badge = document.createElement('div');
    badge.className = 'cloud-hd-sync-pill';
    badge.style.cssText = 'position:absolute;top:14px;right:14px;z-index:15;background:rgba(0,0,0,0.68);backdrop-filter:blur(8px);color:#fff;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;pointer-events:none;border:1px solid rgba(255,255,255,0.18);';
    badge.textContent = '⚡ HD Stream…';
    container.appendChild(badge);
  }

  fetchCloudVideoUrl('posts', postDocId, key || `vid_post_${postDocId}`, chunkCountHint, (pct) => {
    if (badge && badge.isConnected) {
      badge.textContent = `⚡ HD ${pct}%`;
    }
  }).then((cloudUrl) => {
    v._cloudUpgrading = false;
    if (badge && badge.isConnected) badge.remove();
    if (!cloudUrl || !v.isConnected) return;

    const wasPlaying = !v.paused || v.dataset.usingCinemaFallback === 'true';
    v.dataset.usingCinemaFallback = 'false';
    if (v._cinemaInterval) {
      clearInterval(v._cinemaInterval);
      v._cinemaInterval = null;
    }
    if (v._cloudUpgradeUnsub) {
      v._cloudUpgradeUnsub();
      v._cloudUpgradeUnsub = null;
    }
    v.srcObject = null;
    v.src = cloudUrl;
    v.dataset.hydrated = 'true';

    // If this video is in the active view or was playing, immediately play the real HD video with audio!
    const isStoryModalOpen = v.id === 'storyViewerVideo' && !document.getElementById('storyViewerModal')?.classList.contains('hidden');
    const isPostModalOpen = !!v.closest('#postViewerContainer');
    if (isStoryModalOpen) {
      v.muted = !!window.userExplicitlyMuted;
      v.play().catch(() => { v.muted = true; v.play().catch(() => {}); });
    } else if (isPostModalOpen || ((state.view === 'reels' || state.view === 'feed') && wasPlaying)) {
      checkIfVideoInActiveViewportAndPlay(v);
      if (v.paused && wasPlaying && (state.view === 'reels' || isPostModalOpen)) {
        window.autoPlaySingleVideoWithAudio(v);
      }
    }
  }).catch(() => {
    v._cloudUpgrading = false;
    if (badge && badge.isConnected) badge.remove();
  });
}

// Live 24fps Cinema Stream Fallback while HD chunks stream or for legacy unchunked Reels
// Ensures 100% of Reels play in 0ms with motion & audio across all user IDs!
async function attachPosterCinemaStream(v, postDocId) {
  if (!v) return false;
  if (v.srcObject || (v.getAttribute('src') || '').startsWith('blob:') || (v.getAttribute('src') || '').startsWith('data:')) {
    return true;
  }
  let posterSrc = v.getAttribute('poster') || '';
  if (!posterSrc && postDocId) {
    try {
      const pData = await fetchSingleDocViaRest('posts', postDocId) ||
        (db ? await db.collection('posts').doc(postDocId).get().then(d => d.exists ? d.data() : null).catch(() => null) : null);
      if (pData) {
        posterSrc = pData.posterImage || pData.image || '';
        if (posterSrc) v.poster = posterSrc;
      }
    } catch (e) {}
  }

  return new Promise((resolve) => {
    const canvas = document.createElement('canvas');
    canvas.width = 480;
    canvas.height = 854;
    const ctx = canvas.getContext('2d');
    const img = new Image();
    img.crossOrigin = 'anonymous';

    const startStream = (loadedImg) => {
      let frame = 0;
      const drawFrame = () => {
        if (!v.isConnected || v.dataset.usingCinemaFallback !== 'true') {
          if (v._cinemaInterval) {
            clearInterval(v._cinemaInterval);
            v._cinemaInterval = null;
          }
          return;
        }
        if (v.paused) return; // Zero-lag: skip rendering when video is paused or offscreen
        frame++;
        const t = (frame % 240) / 240; // 10-second smooth cycle at 24fps
        const phase = Math.sin(t * Math.PI);
        const scale = 1.0 + phase * 0.085; // Smooth Ken Burns zoom 1.0x -> 1.085x
        const panX = Math.sin(t * Math.PI * 2) * 12;
        const panY = Math.cos(t * Math.PI * 2) * 10;

        ctx.fillStyle = '#090b10';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        if (loadedImg && loadedImg.width > 0) {
          const imgRatio = loadedImg.width / loadedImg.height;
          const canvasRatio = canvas.width / canvas.height;
          let drawW = canvas.width;
          let drawH = canvas.height;
          if (imgRatio > canvasRatio) {
            drawW = canvas.width;
            drawH = canvas.width / imgRatio;
          } else {
            drawH = canvas.height;
            drawW = canvas.height * imgRatio;
          }
          ctx.save();
          ctx.translate(canvas.width / 2 + panX, canvas.height / 2 + panY);
          ctx.scale(scale, scale);
          ctx.drawImage(loadedImg, -drawW / 2, -drawH / 2, drawW, drawH);
          ctx.restore();
        }
      };

      v.dataset.usingCinemaFallback = 'true';
      v.dataset.hydrated = 'true';
      drawFrame();
      if (v._cinemaInterval) clearInterval(v._cinemaInterval);
      v._cinemaInterval = setInterval(drawFrame, 42); // ~24 fps

      try {
        const stream = canvas.captureStream ? canvas.captureStream(24) : (canvas.mozCaptureStream ? canvas.mozCaptureStream(24) : null);
        if (stream) {
          v.srcObject = stream;
        }
      } catch (e) {}

      resolve(true);
    };

    if (posterSrc) {
      img.onload = () => startStream(img);
      img.onerror = () => startStream(null);
      img.src = posterSrc;
    } else {
      startStream(null);
    }
  });
}

// GLOBAL AUDIO MUTE CONTROLLER: Audio is ON (unmuted) by default!
// Audio is ONLY muted when the user explicitly clicks a Mute button!
window.userExplicitlyMuted = false;

window.toggleUserAudioMute = function(btnEl = null) {
  window.userExplicitlyMuted = !window.userExplicitlyMuted;
  reelsAudioMuted = window.userExplicitlyMuted;

  // Update all playing/visible feed & reel videos immediately without stopping autoplay
  document.querySelectorAll('video.post-video, video.reel-media-video').forEach(v => {
    v.muted = window.userExplicitlyMuted;
  });

  // Update all mute pills in Feed
  document.querySelectorAll('.video-mute-pill').forEach(b => {
    b.textContent = window.userExplicitlyMuted ? '🔇' : '🔊';
  });

  // Update global mute button in Reels
  const reelsMuteBtn = document.getElementById('reelsGlobalMuteBtn');
  if (reelsMuteBtn) {
    reelsMuteBtn.textContent = window.userExplicitlyMuted ? '🔇 Muted' : '🔊 Audio On';
  }

  if (window.userExplicitlyMuted) {
    stopSynthMusic();
  } else {
    // If unmuted while a Reel with a custom song or cinema fallback is playing, resume its music
    const activeVid = Array.from(document.querySelectorAll('video.reel-media-video, video.post-video')).find(v => !v.paused);
    if (activeVid) {
      const card = activeVid.closest('[data-track-id]');
      const rawTrackId = card?.dataset.trackId || '';
      const audioLabel = card?.dataset.audioLabel || '';
      const isOriginalAudio = !audioLabel || audioLabel.startsWith('Original Audio');
      const isCinemaFallback = activeVid.dataset.usingCinemaFallback === 'true';
      const trackId = isCinemaFallback ? (rawTrackId || 'golden_hour') : (!isOriginalAudio ? rawTrackId : '');
      if (trackId && typeof window.togglePlaySynthTrack === 'function') {
        window.togglePlaySynthTrack(trackId);
      }
    }
  }

  // If user clicked mute pill on a specific video card that is in view, ensure it keeps auto-playing
  if (btnEl) {
    const vid = btnEl.parentElement?.querySelector('video');
    if (vid && vid.paused && (state.view === 'feed' || state.view === 'reels')) {
      window.autoPlaySingleVideoWithAudio(vid);
    }
  }
};

// Helper to play a single video with audio ON (unless userExplicitlyMuted === true), awaiting hydration first
window.autoPlaySingleVideoWithAudio = async function(vid) {
  if (!vid) return;
  const hasSource = !!(vid.srcObject || (vid.getAttribute('src') || '').startsWith('blob:') || (vid.getAttribute('src') || '').startsWith('data:'));
  if (!hasSource) {
    await hydrateSingleVideo(vid);
  }
  window.pauseAllMediaEverywhere(vid);
  vid.muted = !!window.userExplicitlyMuted;

  // Play attached synth song if selected, or if currently playing the temporary poster cinema stream
  const card = vid.closest('[data-track-id]');
  const rawTrackId = card?.dataset.trackId || '';
  const audioLabel = card?.dataset.audioLabel || '';
  const isOriginalAudio = !audioLabel || audioLabel.startsWith('Original Audio');
  const isCinemaFallback = vid.dataset.usingCinemaFallback === 'true';
  const trackId = isCinemaFallback ? (rawTrackId || 'golden_hour') : (!isOriginalAudio ? rawTrackId : '');

  if (!window.userExplicitlyMuted && trackId && typeof window.togglePlaySynthTrack === 'function') {
    if (activeMusicTrackId !== trackId) {
      window.togglePlaySynthTrack(trackId);
    }
  } else if (!trackId && typeof stopSynthMusic === 'function') {
    stopSynthMusic();
  }

  try {
    await vid.play();
    vid.closest('.post-media-container, .reel-card')?.classList.remove('video-paused');
  } catch (err) {
    // Browser blocked unmuted autoplay prior to first user tap; start playing muted & auto-unmute on first gesture
    vid.muted = true;
    vid.play().then(() => {
      vid.closest('.post-media-container, .reel-card')?.classList.remove('video-paused');
    }).catch(() => {});
    const unlockAudio = () => {
      if (!window.userExplicitlyMuted && !vid.paused) {
        vid.muted = false;
      }
      document.removeEventListener('pointerdown', unlockAudio);
      document.removeEventListener('touchstart', unlockAudio);
      document.removeEventListener('keydown', unlockAudio);
    };
    document.addEventListener('pointerdown', unlockAudio, { once: true });
    document.addEventListener('touchstart', unlockAudio, { once: true });
    document.addEventListener('keydown', unlockAudio, { once: true });
  }
};

function checkIfVideoInActiveViewportAndPlay(v) {
  if (!v || state.me?.settings?.autoPlayVideos === false) return;
  if (state.view !== 'feed' && state.view !== 'reels') return;
  const rect = v.getBoundingClientRect();
  const vh = window.innerHeight || document.documentElement.clientHeight;
  if (rect.height <= 0) return;
  const visibleTop = Math.max(0, rect.top);
  const visibleBottom = Math.min(vh, rect.bottom);
  const visibleRatio = Math.max(0, visibleBottom - visibleTop) / rect.height;
  if (visibleRatio >= 0.50) {
    const anyPlaying = Array.from(document.querySelectorAll('video.post-video, video.reel-media-video')).some(other => other !== v && !other.paused);
    if (!anyPlaying) {
      window.autoPlaySingleVideoWithAudio(v);
    }
  }
}

async function hydrateSingleVideo(v) {
  if (!v) return false;
  const existingSrc = v.getAttribute('src') || '';
  if (existingSrc.startsWith('data:') || existingSrc.startsWith('blob:')) {
    v.dataset.hydrated = 'true';
    return true;
  }
  if (v._hydratePromise) return v._hydratePromise;

  v._hydratePromise = (async () => {
    try {
      const key = v.dataset.videoKey || '';
      const postDocId = v.dataset.postDocId || v.closest('[data-post-id]')?.dataset.postId || v.closest('[data-reel-id]')?.dataset.reelId || v.dataset.storyDocId || '';
      const chunkCountHint = Number(v.dataset.chunkCount || '0') || 0;
      const postCacheKey = postDocId ? `vid_post_${postDocId}` : '';

      // 1. Try local IndexedDB first (checks both videoKey and vid_post_{postDocId} — 0ms instant!)
      const localUrl = (key ? await YDDVideoDB.getVideoUrl(key) : null) ||
                       (postCacheKey ? await YDDVideoDB.getVideoUrl(postCacheKey) : null);
      if (localUrl) {
        v.dataset.usingCinemaFallback = 'false';
        if (v._cinemaInterval) { clearInterval(v._cinemaInterval); v._cinemaInterval = null; }
        v.srcObject = null;
        v.src = localUrl;
        v.dataset.hydrated = 'true';

        // AUTO-HEAL: If this video hasn't synced chunks to Firestore 'likes' yet, sync in background!
        if (postDocId && !chunkCountHint && !healedVideoDocs.has(postDocId)) {
          healedVideoDocs.add(postDocId);
          YDDVideoDB.getVideoBlob(key || postCacheKey).then(blob => {
            if (blob) saveCloudVideoChunks('posts', postDocId, blob);
          }).catch(() => {});
        }
        return true;
      }

      // 2. Not in local IndexedDB yet:
      // Immediately start 24fps Poster Cinema Stream (0ms wait so video plays right away!)
      // AND simultaneously stream the real HD video chunks from Firestore REST in the background!
      await attachPosterCinemaStream(v, postDocId);
      if (postDocId) {
        upgradeVideoElementFromCloud(v, postDocId, key || postCacheKey, chunkCountHint);
      }
      return true;
    } finally {
      v._hydratePromise = null;
    }
  })();

  return v._hydratePromise;
}

// High-Performance Lazy Video Hydration via IntersectionObserver
let videoHydrationObserver = null;
async function hydrateVideoElements(root = document) {
  const vids = Array.from(root.querySelectorAll('video[data-video-key], video[data-post-doc-id], video[data-story-doc-id]'));
  if (!vids.length) return;
  if (!('IntersectionObserver' in window)) {
    await Promise.all(vids.map(v => hydrateSingleVideo(v)));
    return;
  }
  if (!videoHydrationObserver) {
    videoHydrationObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const v = entry.target;
          videoHydrationObserver.unobserve(v);
          hydrateSingleVideo(v).then(() => {
            checkIfVideoInActiveViewportAndPlay(v);
          });
        }
      });
    }, { rootMargin: '350px 0px 350px 0px' });
  }
  vids.forEach(v => {
    if (v.dataset.hydrated === 'true') return;
    videoHydrationObserver.observe(v);
  });
}

// STRICT GLOBAL MEDIA CONTROLLER: Never allow background or profile videos to auto-play!
window.pauseAllMediaEverywhere = function(exceptVideo = null) {
  document.querySelectorAll('video').forEach(v => {
    if (v.id === 'remoteVideo' || v.id === 'localVideo') return;
    if (v !== exceptVideo) {
      try {
        v.pause();
        v.closest('.post-media-container, .reel-card')?.classList.add('video-paused');
      } catch (e) {}
    }
  });
  if (!exceptVideo && typeof stopSynthMusic === 'function') {
    stopSynthMusic();
  }
};

// Probe video duration & extract JPEG poster thumbnail
function inspectVideoAndExtractPoster(file) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const v = document.createElement('video');
    v.preload = 'metadata';
    v.muted = true;
    v.playsInline = true;
    let resolved = false;

    const finish = (dur, poster) => {
      if (resolved) return;
      resolved = true;
      resolve({ objectUrl: url, duration: dur, posterImage: poster });
    };

    v.onloadedmetadata = () => {
      const dur = Number.isFinite(v.duration) && v.duration > 0 ? v.duration : 15;
      v.currentTime = Math.min(0.5, dur * 0.1);
    };

    v.onseeked = () => {
      try {
        const canvas = document.createElement('canvas');
        const scale = Math.min(1, 640 / (v.videoWidth || 640));
        canvas.width = Math.round((v.videoWidth || 640) * scale);
        canvas.height = Math.round((v.videoHeight || 640) * scale);
        const ctx = canvas.getContext('2d');
        ctx.drawImage(v, 0, 0, canvas.width, canvas.height);
        const poster = canvas.toDataURL('image/jpeg', 0.72);
        finish(v.duration || 15, poster);
      } catch (e) {
        finish(v.duration || 15, '');
      }
    };

    v.onerror = () => {
      URL.revokeObjectURL(url);
      reject(new Error('Unsupported or corrupted video file.'));
    };

    setTimeout(() => {
      if (!resolved) finish(Number.isFinite(v.duration) ? v.duration : 15, '');
    }, 2500);

    v.src = url;
  });
}

// Validate video <= 125 MB and <= 35 seconds
async function readVideoFileLimited(file) {
  if (file.size > MAX_VIDEO_FILE_BYTES) {
    throw new Error(`Video is ${formatFileSize(file.size)}. Maximum allowed size is 125 MB.`);
  }
  const info = await inspectVideoAndExtractPoster(file);
  if (info.duration > MAX_REEL_DURATION_SEC + 0.5) {
    toast(`⏱️ Video is ${info.duration.toFixed(1)}s — trimmed to 35.0s max Instagram Reel limit.`);
  }
  // If clip is very small (< 550 KB), also read base64 for cloud sync; otherwise use IndexedDB key
  let smallDataUrl = null;
  if (file.size <= 550 * 1024) {
    smallDataUrl = await new Promise((res) => {
      const r = new FileReader();
      r.onload = () => res(r.result);
      r.onerror = () => res(null);
      r.readAsDataURL(file);
    });
  }
  return {
    file,
    dataUrl: smallDataUrl || info.objectUrl,
    smallDataUrl,
    posterImage: info.posterImage,
    duration: Math.min(info.duration, MAX_REEL_DURATION_SEC),
    rawDuration: info.duration
  };
}

// Enforce trim window (<= 35s) during video playback without premature resets
window.enforceReelTrimPlayback = function(vid) {
  if (!vid || vid.paused || vid.dataset.usingCinemaFallback === 'true') return;
  const start = Math.max(0, parseFloat(vid.dataset.trimStart || '0') || 0);
  let end = parseFloat(vid.dataset.trimEnd || '35') || 35;
  // Guard against bad/tiny trimEnd values (< 2s) when video is longer
  if (end <= start + 1.5) end = start + MAX_REEL_DURATION_SEC;
  const maxEnd = Math.min(end, start + MAX_REEL_DURATION_SEC);

  if (start > 0.25 && vid.currentTime < start - 0.15) {
    vid.currentTime = start;
  } else if (vid.currentTime >= maxEnd) {
    vid.currentTime = start;
    if (state.me?.settings?.loopReels === false) {
      vid.pause();
    } else if (vid.paused) {
      vid.play().catch(() => {});
    }
  }
};

// Toggle video play/pause on user click & pause all other videos
window.toggleInstagramVideoPlay = async function(vid) {
  if (!vid) return;
  if (vid.paused) {
    await window.autoPlaySingleVideoWithAudio(vid);
  } else {
    vid.pause();
    vid.closest('.post-media-container, .reel-card')?.classList.add('video-paused');
    stopSynthMusic();
  }
};

const composerFile = document.getElementById('composerFile');
let composerImageData = null;
let composerVideoData = null;
let composerVideoFile = null;
let composerPosterImage = '';
let composerStudioMeta = {
  filterCss: 'none',
  audioTrack: '',
  audioTrackId: '',
  overlayText: '',
  sticker: '',
  trimStart: 0,
  trimEnd: 35,
  duration: 0
};

// If top composer is present, hook up its handlers safely
if (composerFile) {
  composerFile.addEventListener('change', async () => {
    const file = composerFile.files[0];
    if (!file) return;
    const captionDraft = document.getElementById('postText')?.value || '';
    composerFile.value = '';
    openCreateReelModal({ initialFile: file, initialCaption: captionDraft });
  });
}

document.getElementById('composerImgRm')?.addEventListener('click', () => {
  composerImageData = null;
  composerVideoData = null;
  composerVideoFile = null;
  if (composerFile) composerFile.value = '';
  const vidPrev = document.getElementById('composerVid');
  if (vidPrev) { vidPrev.pause(); vidPrev.src = ''; }
  const prevBox = document.getElementById('composerImgPrev');
  if (prevBox) prevBox.style.display = 'none';
});

const postSubmitBtn = document.getElementById('postSubmitBtn');
if (postSubmitBtn) {
  postSubmitBtn.addEventListener('click', async () => {
    const text = document.getElementById('postText')?.value?.trim() || '';
    if (!text && !composerImageData && !composerVideoData) {
      return openCreateReelModal();
    }

    const btn = postSubmitBtn;
    btn.disabled = true;
    btn.classList.add('is-busy');

    try {
      const postPayload = {
        userId: state.me.uid,
        mediaType: composerVideoData ? 'REEL' : (composerImageData ? 'IMAGE' : 'TEXT'),
        author: {
          id: state.me.uid,
          username: state.me.username,
          name: state.me.name,
          avatar: state.me.avatar || '',
          isPremium: isUserPremium(state.me),
          isPrivate: !!(state.me.settings?.privateAccount || state.me.isPrivate)
        },
        content: text,
        image: composerImageData || null,
        video: composerVideoData || null,
        isReel: !!composerVideoData,
        likedBy: [],
        likeCount: 0,
        viewsCount: 1,
        viewedBy: [state.me.uid],
        commentCount: 0,
        shareCount: 0,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      };

      await db.collection('posts').add(postPayload);
      const postTextEl = document.getElementById('postText');
      if (postTextEl) postTextEl.value = '';
      composerImageData = null;
      composerVideoData = null;
      const prevBox = document.getElementById('composerImgPrev');
      if (prevBox) prevBox.style.display = 'none';
      triggerHaptic(18);
      toast('Shared to Your Day! ✨');
    } catch (err) {
      toast(err.message);
    } finally {
      btn.disabled = false;
      btn.classList.remove('is-busy');
    }
  });
}

function normalizePostDocData(id, data) {
  if (!data) return null;
  const likedBy = Array.isArray(data.likedBy) ? Array.from(new Set(data.likedBy.filter(Boolean))) : [];
  const uniqueViewers = Array.isArray(data.viewedBy)
    ? Array.from(new Set(data.viewedBy.filter(u => u && u !== 'anon')))
    : [];
  const myUid = state.me?.uid || '';
  return {
    id,
    ...data,
    likedBy,
    likedByMe: myUid ? likedBy.includes(myUid) : false,
    savedByMe: state.myBookmarks ? state.myBookmarks.has(id) : false,
    likeCount: likedBy.length,
    viewsCount: uniqueViewers.length || (typeof data.viewsCount === 'number' ? data.viewsCount : 1),
    viewedBy: uniqueViewers,
    commentCount: Number(data.commentCount) || 0,
    shareCount: Number(data.shareCount) || 0,
    videoChunkCount: Number(data.videoChunkCount) || 0,
    createdAt: data.createdAt ? toDate(data.createdAt).toISOString() : new Date().toISOString()
  };
}

function mergeNormalizedPosts(listA = [], listB = []) {
  const byId = new Map();
  for (const item of [...listA, ...listB]) {
    if (!item || !item.id) continue;
    const prev = byId.get(item.id);
    if (!prev) {
      byId.set(item.id, item);
    } else {
      byId.set(item.id, {
        ...prev,
        ...item,
        videoChunkCount: Math.max(Number(prev.videoChunkCount) || 0, Number(item.videoChunkCount) || 0),
        video: item.video || prev.video || null,
        posterImage: item.posterImage || prev.posterImage || null,
        image: item.image || prev.image || null
      });
    }
  }
  return Array.from(byId.values());
}

async function loadFeed() {
  const list = document.getElementById('feedList');
  if (!list) return;

  if (state.feedPostsCache && state.feedPostsCache.length) {
    renderPosts(list, state.feedPostsCache.filter(p => canViewerSeeReelOrPost(p, 'all')));
  } else {
    try {
      const cached = JSON.parse(localStorage.getItem('ydd_fast_feed_' + state.me?.uid) || '[]');
      if (cached.length) renderPosts(list, cached.filter(p => canViewerSeeReelOrPost(p, 'all')));
    } catch (e) {}
  }

  let latestRestDocs = [];
  let latestSdkDocs = [];

  const applyCombinedFeedDocs = (allDocs) => {
    // Extract active 24h Stories from 'posts' collection — STRICTLY filtered to followers + self!
    const liveStories = allDocs.filter(p => (p.isStory || p.mediaType === 'STORY') && isStoryWithin24Hours(p.createdAt) && canViewerSeeStory(p));
    liveStories.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    state.storiesCache = liveStories;
    state.storiesCacheTime = Date.now();
    if (state.view === 'feed') {
      renderStoriesTray(false);
    }

    // Auto-heal any local videos in IndexedDB to Firestore chunks so all other users can play them!
    syncAllLocalVideosToCloud(allDocs);

    // Filter out Stories and internal chunk docs, then apply privacy rules (public IDs visible to all; private IDs visible to followers only)
    const rawPosts = allDocs.filter(p => !p.isStory && p.mediaType !== 'STORY' && !p.isVideoChunk);
    rawPosts.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    state.allPostsCache = rawPosts;
    const visiblePosts = rawPosts.filter(p => canViewerSeeReelOrPost(p, 'all'));
    state.feedPostsCache = visiblePosts;
    try {
      localStorage.setItem('ydd_fast_feed_' + state.me?.uid, JSON.stringify(visiblePosts.slice(0, 10)));
    } catch (e) {}
    if (state.view === 'feed') {
      renderPosts(list, visiblePosts);
    }
  };

  // 1. Direct HTTP/2 REST fetch (resolves in ~150ms across all user IDs, immune to SDK queue)
  fetchPostsViaRest(120).then(rawRest => {
    if (rawRest && rawRest.length) {
      latestRestDocs = rawRest.map(d => normalizePostDocData(d.id, d)).filter(Boolean);
      applyCombinedFeedDocs(mergeNormalizedPosts(latestRestDocs, latestSdkDocs));
    }
  }).catch(() => {});

  // 2. Real-time Firestore listener
  if (state.feedUnsub) state.feedUnsub();
  state.feedUnsub = db.collection('posts').limit(120).onSnapshot((snap) => {
    latestSdkDocs = snap.docs.map(doc => normalizePostDocData(doc.id, doc.data())).filter(Boolean);
    applyCombinedFeedDocs(mergeNormalizedPosts(latestRestDocs, latestSdkDocs));
  }, (err) => {
    console.error('Feed error:', err);
  });
}

// STRICT 1-UNIQUE-VIEW-PER-USER + SINGLE ACTIVE FEED VIDEO CONTROLLER
let postViewsObserver = null;
let feedSingleVideoObserver = null;

function getLocalViewedSet() {
  const key = 'ydd_viewed_' + (state.me?.uid || 'guest');
  try {
    return new Set(JSON.parse(localStorage.getItem(key) || '[]'));
  } catch (e) {
    return new Set();
  }
}

function markLocalViewed(postId) {
  const key = 'ydd_viewed_' + (state.me?.uid || 'guest');
  const set = getLocalViewedSet();
  set.add(postId);
  try {
    localStorage.setItem(key, JSON.stringify(Array.from(set).slice(-500)));
  } catch (e) {}
}

async function recordUniqueView(postId) {
  if (!postId || !state.me || String(postId).startsWith('local_')) return;
  const viewedSet = getLocalViewedSet();
  if (viewedSet.has(postId)) return;
  markLocalViewed(postId);

  try {
    const postRef = db.collection('posts').doc(postId);
    const doc = await postRef.get();
    if (!doc.exists) return;
    const data = doc.data();
    const existingViewers = Array.isArray(data.viewedBy)
      ? Array.from(new Set(data.viewedBy.filter(u => u && u !== 'anon')))
      : [];
    if (!existingViewers.includes(state.me.uid)) {
      existingViewers.push(state.me.uid);
      await postRef.update({
        viewedBy: existingViewers,
        viewsCount: existingViewers.length
      });
    }
  } catch (e) {}
}

function trackPostViewsAndSingleVideo() {
  hydrateVideoElements(document);
  if (!('IntersectionObserver' in window)) return;

  // 1. Unique View Observer
  if (postViewsObserver) postViewsObserver.disconnect();
  postViewsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const postId = entry.target.dataset.postId;
        if (postId) recordUniqueView(postId);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.post[data-post-id]').forEach(el => postViewsObserver.observe(el));

  // 2. STRICT SINGLE-VIDEO VIEWPORT CONTROLLER FOR FEED
  // Never plays on Profile page! And pauses immediately when scrolling to another post!
  if (feedSingleVideoObserver) feedSingleVideoObserver.disconnect();
  feedSingleVideoObserver = new IntersectionObserver((entries) => {
    if (state.view !== 'feed') {
      window.pauseAllMediaEverywhere();
      return;
    }
    entries.forEach(entry => {
      const vid = entry.target;
      if (!entry.isIntersecting || entry.intersectionRatio < 0.70) {
        if (!vid.paused) {
          vid.pause();
          vid.closest('.post-media-container')?.classList.add('video-paused');
        }
      } else if (entry.intersectionRatio >= 0.65 && state.me?.settings?.autoPlayVideos !== false) {
        // Auto-play with audio ON unless user explicitly clicked Mute!
        window.autoPlaySingleVideoWithAudio(vid);
      }
    });
  }, { threshold: [0, 0.35, 0.70, 0.9] });

  document.querySelectorAll('#feedList video.post-video').forEach(v => feedSingleVideoObserver.observe(v));
}

// PARALLEL FAST LIKERS MODAL
async function showLikersModal(postId) {
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal">
      <h3>Likes ❤️</h3>
      <div id="likersModalList" style="max-height:360px;overflow-y:auto;"><div class="empty">Loading…</div></div>
      <div class="modal-actions"><button class="btn btn-ghost" id="likersModalClose">Close</button></div>
    </div>`;
  document.body.appendChild(overlay);
  overlay.querySelector('#likersModalClose').addEventListener('click', () => overlay.remove());

  try {
    const pDoc = await db.collection('posts').doc(postId).get();
    if (!pDoc.exists) {
      overlay.querySelector('#likersModalList').innerHTML = '<div class="empty">Post not found.</div>';
      return;
    }
    const data = pDoc.data();
    const likedBy = Array.isArray(data.likedBy) ? Array.from(new Set(data.likedBy)) : [];
    if (!likedBy.length) {
      overlay.querySelector('#likersModalList').innerHTML = '<div class="empty" style="padding:24px;">No likes yet. Double-tap the post to be the first!</div>';
      return;
    }
    const users = await getCachedUsersParallel(likedBy.slice(0, 40));
    overlay.querySelector('#likersModalList').innerHTML = users.map(u => `
      <div class="user-row">
        ${avatarHTML(u)}
        <div class="who" onclick="document.querySelector('#likersModalClose').click();showProfile('${escapeHTML(u.username)}')">
          <div class="name">${escapeHTML(u.name || 'User')} ${premiumBadgeHTML(u)}</div>
          <div class="handle mono">@${escapeHTML(u.username)}</div>
        </div>
      </div>
    `).join('');
  } catch (err) {
    overlay.querySelector('#likersModalList').innerHTML = `<div class="empty">${escapeHTML(err.message)}</div>`;
  }
}

// PARALLEL FAST UNIQUE VIEWS MODAL
async function showViewsModal(postId) {
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal">
      <h3>Unique Views &amp; Reach 👁️</h3>
      <div id="viewsModalList" style="max-height:360px;overflow-y:auto;"><div class="empty">Loading…</div></div>
      <div class="modal-actions"><button class="btn btn-ghost" id="viewsModalClose">Close</button></div>
    </div>`;
  document.body.appendChild(overlay);
  overlay.querySelector('#viewsModalClose').addEventListener('click', () => overlay.remove());

  try {
    const pDoc = await db.collection('posts').doc(postId).get();
    if (!pDoc.exists) {
      overlay.querySelector('#viewsModalList').innerHTML = '<div class="empty">Post not found.</div>';
      return;
    }
    const data = pDoc.data();
    const viewedBy = Array.isArray(data.viewedBy)
      ? Array.from(new Set(data.viewedBy.filter(x => x && x !== 'anon')))
      : [];
    const totalViews = viewedBy.length || (data.viewsCount || 0);
    if (!viewedBy.length) {
      overlay.querySelector('#viewsModalList').innerHTML = `<div class="empty" style="padding:24px;">${totalViews} unique view${totalViews === 1 ? '' : 's'}</div>`;
      return;
    }
    const users = await getCachedUsersParallel(viewedBy.slice(0, 40));
    let html = `<div style="padding:4px 10px 12px;color:var(--amber);font-size:13px;font-weight:700;">${totalViews} Account${totalViews === 1 ? '' : 's'} Reached (1 Unique View per User)</div>`;
    html += users.map(u => `
      <div class="user-row">
        ${avatarHTML(u)}
        <div class="who" onclick="document.querySelector('#viewsModalClose').click();showProfile('${escapeHTML(u.username)}')">
          <div class="name">${escapeHTML(u.name || 'User')} ${premiumBadgeHTML(u)}</div>
          <div class="handle mono">@${escapeHTML(u.username)}</div>
        </div>
      </div>
    `).join('');
    overlay.querySelector('#viewsModalList').innerHTML = html;
  } catch (err) {
    overlay.querySelector('#viewsModalList').innerHTML = `<div class="empty">${escapeHTML(err.message)}</div>`;
  }
}

function renderPosts(container, posts) {
  if (!posts.length) {
    container.innerHTML = `
      <div class="empty">
        <img src="logo.png" alt="Your Day Logo" style="width:68px;height:68px;border-radius:18px;margin:0 auto 12px;display:block;box-shadow:0 8px 24px rgba(220,39,67,0.25);">
        <div class="brand-script" style="font-size:38px;color:var(--paper);margin-bottom:4px;">Your Day</div>
        <div style="font-weight:700;font-size:16px;color:var(--paper);">Welcome to Your Day</div>
        <p class="muted" style="max-width:300px;margin:8px auto 16px;">Photos and Reels (≤35s) from creators appear here.</p>
        <button class="btn btn-primary btn-sm" onclick="showView('search')">Explore Creators</button>
      </div>`;
    return;
  }
  // Smooth DOM reconciliation: if feed already has rendered posts with matching IDs, update metrics in-place without rebuilding DOM
  const existingArticles = Array.from(container.querySelectorAll('article.post[data-post-id]'));
  if (existingArticles.length > 0) {
    const existingIds = existingArticles.map(el => el.dataset.postId);
    const newIds = posts.map(p => p.id);
    if (existingIds.length === newIds.length && existingIds.every((id, idx) => id === newIds[idx])) {
      posts.forEach(p => {
        const postEl = container.querySelector(`article.post[data-post-id="${p.id}"]`);
        if (!postEl) return;
        const likeBtn = postEl.querySelector('[data-like]');
        if (likeBtn) {
          likeBtn.classList.toggle('liked', !!p.likedByMe);
          const svg = likeBtn.querySelector('svg');
          if (svg) svg.setAttribute('fill', p.likedByMe ? 'currentColor' : 'none');
        }
        const likeLabel = postEl.querySelector('[data-like-count-label]');
        if (likeLabel) {
          const lCount = p.likeCount || 0;
          likeLabel.textContent = `${lCount} ${lCount === 1 ? 'like' : 'likes'}`;
        }
        const viewStat = postEl.querySelector('[data-view-stats]');
        if (viewStat) {
          const uniqueViews = Array.isArray(p.viewedBy) ? new Set(p.viewedBy.filter(Boolean)).size : (p.viewsCount || 0);
          viewStat.textContent = `👁️ ${uniqueViews} ${uniqueViews === 1 ? 'view' : 'views'}`;
        }
        const bookmarkBtn = postEl.querySelector('[data-bookmark]');
        if (bookmarkBtn) {
          bookmarkBtn.classList.toggle('saved', !!p.savedByMe);
          const bSvg = bookmarkBtn.querySelector('svg');
          if (bSvg) bSvg.setAttribute('fill', p.savedByMe ? 'currentColor' : 'none');
        }
      });
      return;
    }
  }

  container.innerHTML = posts.map(postHTML).join('');
  setTimeout(trackPostViewsAndSingleVideo, 50);
}

function postHTML(p) {
  const mine = p.userId === state.me.uid || p.author?.id === state.me.uid;
  const author = p.author || {};
  const uniqueViews = Array.isArray(p.viewedBy) ? new Set(p.viewedBy.filter(Boolean)).size : (p.viewsCount || 0);
  const filterStyle = p.filterCss && p.filterCss !== 'none' ? `style="filter:${escapeHTML(p.filterCss)};"` : '';
  const startMutedAttr = window.userExplicitlyMuted ? 'muted' : '';
  const trimStart = p.trimStart || 0;
  const trimEnd = p.trimEnd || 35;
  const hasVid = !!(p.video || p.videoKey || p.hasVideo || p.isReel || p.mediaType === 'REEL');
  const durLabel = p.videoDuration ? `⏱️ ${Math.min(35, Number(p.videoDuration)).toFixed(1)}s` : '🎬 ≤35s Reel';
  const hideCounts = !!p.hideLikes || !!state.me?.settings?.hideLikeCounts;

  return `
  <article class="post" data-post-id="${p.id}" data-track-id="${escapeHTML(p.audioTrackId || '')}" data-audio-label="${escapeHTML(p.audioTrack || '')}">
    <div class="post-head">
      ${avatarHTML(author)}
      <div class="who">
        <div class="name-wrap">
          <div class="name" data-goto-profile="${escapeHTML(author.username || '')}">${escapeHTML(author.name || author.username || 'User')}</div>
          ${premiumBadgeHTML(author)}
          ${p.isPinned ? '<span style="font-size:11px;color:var(--amber);font-weight:700;">📌 Pinned</span>' : ''}
        </div>
        <div class="meta">@${escapeHTML(author.username || '')}${p.location ? ' · 📍 ' + escapeHTML(p.location) : ''} · ${timeAgo(p.createdAt)}</div>
      </div>
      <button class="post-del" data-post-menu="${p.id}" title="More options" style="font-size:18px;font-weight:800;letter-spacing:1px;">⋯</button>
    </div>

    ${p.audioTrack ? `
      <div class="post-music-strip" onclick="togglePlaySynthTrack('${escapeHTML(p.audioTrackId || 'golden_hour')}', this)">
        <span>🎵 ${escapeHTML(p.audioTrack)}</span>
        <span class="music-play-indicator" style="color:var(--amber);font-weight:800;">▶ Play Song</span>
      </div>
    ` : ''}

    ${hasVid ? `
      <div class="post-media-container video-paused" ondblclick="triggerHeartExplosion(this, '${p.id}')">
        <span class="video-duration-pill">${durLabel}</span>
        <div class="video-center-play-badge">▶</div>
        <video class="post-video" data-post-doc-id="${p.id}" data-chunk-count="${p.videoChunkCount || 0}" ${p.video ? `src="${p.video}"` : ''} ${p.videoKey ? `data-video-key="${escapeHTML(p.videoKey)}"` : ''} ${p.posterImage ? `poster="${p.posterImage}"` : ''} ${filterStyle} data-trim-start="${trimStart}" data-trim-end="${trimEnd}" onloadedmetadata="window.adjustVideoScreenToUpload && window.adjustVideoScreenToUpload(this)" ontimeupdate="window.enforceReelTrimPlayback(this)" preload="metadata" loop playsinline ${startMutedAttr} onclick="window.toggleInstagramVideoPlay(this)"></video>
        ${p.overlayText ? `<div class="post-overlay-banner">${escapeHTML(p.overlayText)}</div>` : ''}
        ${p.sticker ? `<div class="post-overlay-sticker">${escapeHTML(p.sticker)}</div>` : ''}
        <button class="video-mute-pill" type="button" title="Mute / Unmute Audio" onclick="event.stopPropagation(); window.toggleUserAudioMute(this);">${window.userExplicitlyMuted ? '🔇' : '🔊'}</button>
      </div>
    ` : (p.image ? `
      <div class="post-media-container" ondblclick="triggerHeartExplosion(this, '${p.id}')">
        <img class="post-image" src="${p.image}" ${filterStyle} alt="Post media" onclick="openLightbox('${p.image}')" loading="lazy" decoding="async">
        ${p.overlayText ? `<div class="post-overlay-banner">${escapeHTML(p.overlayText)}</div>` : ''}
        ${p.sticker ? `<div class="post-overlay-sticker">${escapeHTML(p.sticker)}</div>` : ''}
      </div>
    ` : '')}

    <!-- Instagram Action Bar -->
    <div class="post-actions">
      <div class="post-actions-left">
        <button class="action-btn ${p.likedByMe ? 'liked' : ''}" data-like="${p.id}" title="Like">
          <svg viewBox="0 0 24 24" fill="${p.likedByMe ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </button>
        ${!p.commentsDisabled ? `
        <button class="action-btn" data-open-comments="${p.id}" title="Comments">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-4.5 7.6 8.4 8.4 0 0 1-3.8.9 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7A8.4 8.4 0 0 1 3 11.5 8.5 8.5 0 0 1 11.5 3h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </button>
        ` : ''}
        ${state.me?.settings?.allowReshare !== false ? `
        <button class="action-btn" data-share-dm="${p.id}" title="Share to Direct Message">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
        ` : ''}
      </div>
      <button class="action-btn ${p.savedByMe ? 'saved' : ''}" data-bookmark="${p.id}" title="Save Post">
        <svg viewBox="0 0 24 24" fill="${p.savedByMe ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
      </button>
    </div>

    <!-- Single Clean Likes & Unique Views Metrics Bar -->
    <div class="post-metrics-row">
      <span class="metric-link" data-show-likers="${p.id}" data-like-count-label="${p.id}">${hideCounts ? 'Liked by people' : `${p.likeCount || 0} ${p.likeCount === 1 ? 'like' : 'likes'}`}</span>
      <span style="color:var(--paper-faint);font-weight:400;">·</span>
      <span class="metric-link" data-view-stats="${p.id}" style="color:var(--paper-dim);font-weight:600;">${hideCounts ? 'Views' : `${uniqueViews} ${uniqueViews === 1 ? 'view' : 'views'}`}</span>
    </div>

    ${p.content ? `
      <div class="post-caption-block">
        <b class="cap-author" data-goto-profile="${escapeHTML(author.username || '')}">${escapeHTML(author.username || 'user')}</b>
        <span>${escapeHTML(p.content)}</span>
      </div>
    ` : ''}

    ${!p.commentsDisabled ? `
      <div class="post-comments-preview" data-open-comments="${p.id}">
        ${p.commentCount > 0 ? `View all ${p.commentCount} comment${p.commentCount === 1 ? '' : 's'}` : 'Add a comment…'}
      </div>
    ` : '<div class="post-comments-preview faint">Commenting turned off</div>'}
  </article>`;
}

// INSTAGRAM POST OPTIONS MENU (⋯) & FULL POST/REEL EDITOR FOR EXISTING POSTS
window.openPostOptionsMenu = async function(postId) {
  let post = (state.feedPostsCache || []).find(x => x.id === postId);
  if (!post) {
    try {
      const doc = await db.collection('posts').doc(postId).get();
      if (doc.exists) post = { id: doc.id, ...doc.data() };
    } catch (e) {}
  }
  if (!post) return toast('Post not found.');

  const isMine = post.userId === state.me.uid || post.author?.id === state.me.uid;
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal" style="max-width:360px;padding:12px;">
      <div style="text-align:center;padding:8px 0 10px;font-weight:800;font-size:14px;border-bottom:1px solid var(--line-soft);">Post Options</div>
      ${isMine ? `
        <button class="ig-action-sheet-btn" id="optEditPost">✏️ Edit Caption, Filter, Text &amp; Song</button>
        <button class="ig-action-sheet-btn" id="optPinPost">📌 ${post.isPinned ? 'Unpin from Profile Grid' : 'Pin to Profile Grid'}</button>
        <button class="ig-action-sheet-btn" id="optHideLikes">👁️ ${post.hideLikes ? 'Unhide Like & View Counts' : 'Hide Like & View Counts'}</button>
        <button class="ig-action-sheet-btn" id="optToggleComments">💬 ${post.commentsDisabled ? 'Turn On Commenting' : 'Turn Off Commenting'}</button>
        <button class="ig-action-sheet-btn danger" id="optDeletePost">🗑️ Delete Permanently</button>
      ` : `
        <button class="ig-action-sheet-btn" id="optGoProfile">👤 View @${escapeHTML(post.author?.username || 'user')}'s Profile</button>
        <button class="ig-action-sheet-btn" id="optSharePost">✈️ Share to Direct Message</button>
      `}
      <button class="ig-action-sheet-btn" id="optCancelMenu" style="justify-content:center;border-bottom:none;color:var(--paper-dim);">Cancel</button>
    </div>`;
  document.body.appendChild(overlay);
  const close = () => overlay.remove();
  overlay.querySelector('#optCancelMenu').onclick = close;
  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

  if (isMine) {
    overlay.querySelector('#optEditPost').onclick = () => { close(); openEditExistingPostModal(post); };
    overlay.querySelector('#optPinPost').onclick = async () => {
      close();
      await db.collection('posts').doc(post.id).update({ isPinned: !post.isPinned });
      toast(post.isPinned ? 'Unpinned from profile' : 'Pinned to top of your profile 📌');
    };
    overlay.querySelector('#optHideLikes').onclick = async () => {
      close();
      await db.collection('posts').doc(post.id).update({ hideLikes: !post.hideLikes });
      toast(post.hideLikes ? 'Like & view counts visible' : 'Like & view counts hidden 👁️');
    };
    overlay.querySelector('#optToggleComments').onclick = async () => {
      close();
      await db.collection('posts').doc(post.id).update({ commentsDisabled: !post.commentsDisabled });
      toast(post.commentsDisabled ? 'Commenting enabled 💬' : 'Commenting turned off');
    };
    overlay.querySelector('#optDeletePost').onclick = async () => {
      close();
      if (!confirm('Delete this post permanently?')) return;
      document.querySelectorAll(`[data-post-id="${post.id}"], [data-reel-id="${post.id}"]`).forEach(el => el.remove());
      await db.collection('posts').doc(post.id).delete().catch(() => {});
      toast('Deleted.');
    };
  } else {
    overlay.querySelector('#optGoProfile').onclick = () => { close(); showProfile(post.author?.username); };
    overlay.querySelector('#optSharePost').onclick = () => { close(); openSharePostModal(post); };
  }
};

// EDIT EXISTING POST / REEL MODAL (CAPTION, LOCATION, FILTER, TEXT OVERLAY, STICKER, SONG)
function openEditExistingPostModal(post) {
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal" style="max-width:460px;">
      <div class="row between" style="margin-bottom:12px;">
        <h3 style="margin:0;">✏️ Edit Post / Reel</h3>
        <button class="btn btn-icon btn-ghost" id="epClose">✕</button>
      </div>
      <div class="field-group">
        <label class="field">Caption</label>
        <textarea id="epCaption" rows="2">${escapeHTML(post.content || '')}</textarea>
      </div>
      <div class="field-group">
        <label class="field">Location Tag</label>
        <input type="text" id="epLocation" placeholder="e.g. Mumbai, India" value="${escapeHTML(post.location || '')}">
      </div>
      <div class="field-group">
        <label class="field">On-Screen Text Overlay</label>
        <input type="text" id="epOverlayText" placeholder="Text banner over media…" value="${escapeHTML(post.overlayText || '')}">
      </div>
      <div class="row gap-8" style="margin-bottom:12px;">
        <div style="flex:1;">
          <label class="field">Instagram Filter</label>
          <select id="epFilter">
            ${INSTAGRAM_FILTERS.map(f => `<option value="${f.css}" ${post.filterCss === f.css ? 'selected' : ''}>${f.name}</option>`).join('')}
          </select>
        </div>
        <div style="width:110px;">
          <label class="field">Sticker</label>
          <select id="epSticker">
            ${['', '🔥', '❤️', '✨', '💯', '🎉', '👑', '📍', '🎵'].map(st => `<option value="${st}" ${post.sticker === st ? 'selected' : ''}>${st || 'None'}</option>`).join('')}
          </select>
        </div>
      </div>
      <div class="field-group">
        <label class="field">Attached Song</label>
        <select id="epSong">
          <option value="">No Song / Original Audio</option>
          ${INSTAGRAM_MUSIC_LIBRARY.map(t => `<option value="${t.id}" data-label="${escapeHTML(t.title)} · ${escapeHTML(t.artist)}" ${post.audioTrackId === t.id ? 'selected' : ''}>🎵 ${escapeHTML(t.title)} — ${escapeHTML(t.artist)}</option>`).join('')}
        </select>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="epCancel">Cancel</button>
        <button class="btn btn-primary" id="epSave">Save Edits ✓</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  const close = () => overlay.remove();
  overlay.querySelector('#epClose').onclick = close;
  overlay.querySelector('#epCancel').onclick = close;

  overlay.querySelector('#epSave').onclick = async () => {
    const btn = overlay.querySelector('#epSave');
    btn.disabled = true;
    const songSel = overlay.querySelector('#epSong');
    const selectedOpt = songSel.options[songSel.selectedIndex];
    const audioTrackId = songSel.value;
    const audioTrack = audioTrackId ? (selectedOpt.dataset.label || '') : (post.audioTrack || '');

    const updates = {
      content: overlay.querySelector('#epCaption').value.trim(),
      location: overlay.querySelector('#epLocation').value.trim(),
      overlayText: overlay.querySelector('#epOverlayText').value.trim(),
      filterCss: overlay.querySelector('#epFilter').value,
      sticker: overlay.querySelector('#epSticker').value,
      audioTrackId,
      audioTrack
    };

    try {
      await db.collection('posts').doc(post.id).update(updates);
      toast('Post updated! ✨');
      close();
      if (state.view === 'reels') loadReels();
      else if (state.view === 'profile') showProfile(state.me.username);
    } catch (e) {
      toast(e.message);
      btn.disabled = false;
    }
  };
}

// 0ms OPTIMISTIC LIKE, BOOKMARK, OPTIONS MENU & NAVIGATION HANDLER
document.getElementById('viewScroll').addEventListener('click', async (e) => {
  const likeBtn = e.target.closest('[data-like]');
  const bookmarkBtn = e.target.closest('[data-bookmark]');
  const menuBtn = e.target.closest('[data-post-menu]');
  const delBtn = e.target.closest('[data-del-post]');
  const gotoProfile = e.target.closest('[data-goto-profile]');

  if (gotoProfile) return showProfile(gotoProfile.dataset.gotoProfile);
  if (menuBtn) return window.openPostOptionsMenu(menuBtn.dataset.postMenu);

  const viewStatsBtn = e.target.closest('[data-view-stats]');
  if (viewStatsBtn) return showViewsModal(viewStatsBtn.dataset.viewStats);

  const showLikersBtn = e.target.closest('[data-show-likers]');
  if (showLikersBtn) return showLikersModal(showLikersBtn.dataset.showLikers);

  if (likeBtn) {
    const id = likeBtn.dataset.like;
    const wasLiked = likeBtn.classList.contains('liked');
    const nowLiked = !wasLiked;

    likeBtn.classList.toggle('liked', nowLiked);
    const svg = likeBtn.querySelector('svg');
    if (svg) svg.setAttribute('fill', nowLiked ? 'currentColor' : 'none');
    const countLabel = document.querySelector(`[data-like-count-label="${id}"]`);
    if (countLabel && !countLabel.textContent.includes('Liked by')) {
      const cur = parseInt(countLabel.textContent, 10) || 0;
      const next = Math.max(0, cur + (nowLiked ? 1 : -1));
      countLabel.textContent = `${next} ${next === 1 ? 'like' : 'likes'}`;
    }
    if (nowLiked) {
      playHeartPopSound();
      triggerHaptic(14);
    }

    if (!String(id).startsWith('local_')) {
      try {
        const postRef = db.collection('posts').doc(id);
        const postDoc = await postRef.get();
        if (!postDoc.exists) return;
        const data = postDoc.data();
        const likedBy = Array.isArray(data.likedBy) ? Array.from(new Set(data.likedBy)) : [];
        const nextLikes = nowLiked
          ? Array.from(new Set([...likedBy, state.me.uid]))
          : likedBy.filter(u => u !== state.me.uid);
        await postRef.update({ likedBy: nextLikes, likeCount: nextLikes.length });
      } catch (err) {}
    }
    return;
  }

  if (bookmarkBtn) {
    const id = bookmarkBtn.dataset.bookmark;
    const wasSaved = state.myBookmarks.has(id);
    const nowSaved = !wasSaved;

    bookmarkBtn.classList.toggle('saved', nowSaved);
    const svg = bookmarkBtn.querySelector('svg');
    if (svg) svg.setAttribute('fill', nowSaved ? 'currentColor' : 'none');
    if (nowSaved) {
      state.myBookmarks.add(id);
      triggerHaptic(10);
      toast('Saved to collections 🔖');
    } else {
      state.myBookmarks.delete(id);
      toast('Removed from Saved');
    }

    try {
      const docRef = db.collection('bookmarks').doc(`${state.me.uid}_${id}`);
      if (nowSaved) {
        await docRef.set({ userId: state.me.uid, postId: id, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
      } else {
        await docRef.delete();
      }
    } catch (err) {}
    return;
  }

  const openCommentsBtn = e.target.closest('[data-open-comments]');
  if (openCommentsBtn) return openCommentsSheet(openCommentsBtn.dataset.openComments);

  const shareDmBtn = e.target.closest('[data-share-dm]');
  if (shareDmBtn) return openSharePostModal({ id: shareDmBtn.dataset.shareDm, content: 'Shared post' });

  if (delBtn) {
    window.openPostOptionsMenu(delBtn.dataset.delPost);
  }
});

/* ==================================================================
   SEARCH & EXPLORE (IMAGE 3: 3-COLUMN 3:4 MEDIA GRID WITH VIEW COUNTS)
   ================================================================== */
function formatCompactCount(n) {
  const num = Number(n) || 0;
  if (num >= 1000000) return (num / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
  if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
  return String(num);
}

window.openExploreTile = function(postId, isReelTile) {
  if (isReelTile) {
    state.targetReelId = postId;
    showView('reels');
    setTimeout(() => {
      const card = document.querySelector(`.reel-card[data-reel-id="${postId}"]`);
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 180);
  } else {
    window.openProfilePostViewer(postId);
  }
};

async function renderExploreMediaGrid(filterQuery = '') {
  const gridEl = document.getElementById('exploreMediaGrid');
  if (!gridEl) return;

  let sourcePosts = state.allPostsCache || state.feedPostsCache || [];
  if (!sourcePosts.length) {
    const rawRest = await fetchPostsViaRest(120);
    if (rawRest && rawRest.length) {
      sourcePosts = rawRest
        .map(d => normalizePostDocData(d.id, d))
        .filter(p => p && !p.isStory && p.mediaType !== 'STORY' && !p.isVideoChunk);
      state.allPostsCache = sourcePosts;
    }
  }

  const q = (filterQuery || '').trim().toLowerCase();
  const mode = state.searchTab === 'following' ? 'friends' : 'all';

  let mediaItems = sourcePosts.filter(p => {
    const hasMedia = !!(p.image || p.video || p.videoKey || p.posterImage || p.hasVideo || p.isReel || p.mediaType === 'REEL');
    if (!hasMedia) return false;
    if (!canViewerSeeReelOrPost(p, mode)) return false;
    if (q) {
      const cap = (p.content || '').toLowerCase();
      const uname = (p.author?.username || '').toLowerCase();
      const name = (p.author?.name || '').toLowerCase();
      return cap.includes(q) || uname.includes(q) || name.includes(q);
    }
    return true;
  });

  if (!mediaItems.length) {
    gridEl.innerHTML = '';
    return;
  }

  gridEl.innerHTML = mediaItems.map(p => {
    const isVid = !!(p.video || p.videoKey || p.hasVideo || p.isReel || p.mediaType === 'REEL');
    const thumbSrc = p.posterImage || p.image || '';
    const filterStyle = p.filterCss && p.filterCss !== 'none' ? `style="filter:${escapeHTML(p.filterCss)};"` : '';
    const uniqueViews = Array.isArray(p.viewedBy) ? new Set(p.viewedBy.filter(Boolean)).size : (p.viewsCount || 1);
    return `
      <div class="explore-grid-tile" onclick="window.openExploreTile('${p.id}', ${isVid})">
        ${isVid ? `<span class="explore-tile-badge"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg></span>` : ''}
        ${thumbSrc ? `
          <img src="${thumbSrc}" ${filterStyle} alt="Explore" loading="lazy" decoding="async">
        ` : (isVid ? `
          <video data-post-doc-id="${p.id}" data-chunk-count="${p.videoChunkCount || 0}" ${p.video ? `src="${p.video}"` : ''} ${p.videoKey ? `data-video-key="${escapeHTML(p.videoKey)}"` : ''} ${filterStyle} preload="metadata" muted playsinline></video>
        ` : '')}
        <div class="explore-tile-views">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <span>${formatCompactCount(uniqueViews)}</span>
        </div>
      </div>
    `;
  }).join('');

  hydrateVideoElements(gridEl);
}

document.getElementById('searchTabAll').addEventListener('click', () => {
  state.searchTab = 'all';
  document.getElementById('searchTabAll').classList.add('active');
  document.getElementById('searchTabFollowing').classList.remove('active');
  performSearch(document.getElementById('searchInput').value);
});
document.getElementById('searchTabFollowing').addEventListener('click', () => {
  state.searchTab = 'following';
  document.getElementById('searchTabFollowing').classList.add('active');
  document.getElementById('searchTabAll').classList.remove('active');
  performSearch(document.getElementById('searchInput').value);
});

let searchDebounce;
let cachedSearchUsers = null;
let cachedSearchUsersTime = 0;

async function performSearch(rawInput) {
  const box = document.getElementById('searchResults');
  const rawTerm = (rawInput || '').trim();
  const cleanTerm = rawTerm.startsWith('@') ? rawTerm.slice(1).toLowerCase() : rawTerm.toLowerCase();

  // Render the 3-Column Explore Media Grid immediately
  renderExploreMediaGrid(cleanTerm);

  const filterAndRender = (users) => {
    let list = users;
    if (state.searchTab === 'following') {
      list = list.filter(u => state.followingUserIds.has(u.id));
    }
    if (cleanTerm) {
      list = list.filter(u => {
        const uname = (u.username || '').toLowerCase();
        const unameFull = '@' + uname;
        const name = (u.name || '').toLowerCase();
        return uname.includes(cleanTerm) || unameFull.includes(cleanTerm) || name.includes(cleanTerm);
      });
      box.innerHTML = list.length
        ? list.map(userRowHTML).join('')
        : `<div class="empty" style="padding:18px;">No accounts matching "${escapeHTML(rawTerm)}".</div>`;
    } else {
      box.innerHTML = list.length
        ? `<div style="padding:4px 12px 6px;font-size:12px;font-weight:700;color:var(--paper-dim);">Suggested Creators</div>` + list.slice(0, 5).map(userRowHTML).join('')
        : '';
    }
  };

  if (cachedSearchUsers && (Date.now() - cachedSearchUsersTime < 60000)) {
    filterAndRender(cachedSearchUsers);
    return;
  }

  showLoader();
  try {
    const snap = await db.collection('users').limit(100).get();
    const users = snap.docs
      .map(d => {
        const u = { id: d.id, uid: d.id, ...d.data() };
        state.userCache.set(d.id, u);
        return u;
      })
      .filter(u => u.id !== state.me.uid);

    cachedSearchUsers = users;
    cachedSearchUsersTime = Date.now();
    filterAndRender(users);
  } catch (err) {
    box.innerHTML = `<div class="empty">${escapeHTML(err.message)}</div>`;
  } finally {
    hideLoader();
  }
}

document.getElementById('searchInput').addEventListener('input', (e) => {
  clearTimeout(searchDebounce);
  searchDebounce = setTimeout(() => performSearch(e.target.value), 160);
});

function userRowHTML(u) {
  const isFollowing = state.followingUserIds.has(u.id);
  const isPriv = isAccountPrivate(u.id, u);
  return `
  <div class="user-row">
    ${avatarHTML(u)}
    <div class="who" data-goto-profile="${escapeHTML(u.username || '')}">
      <div class="name">${escapeHTML(u.name || 'User')} ${isPriv ? '<span title="Private Account" style="font-size:12px;">🔒</span>' : ''} ${premiumBadgeHTML(u)}</div>
      <div class="handle mono">@${escapeHTML(u.username || '')}</div>
    </div>
    <button class="btn btn-sm ${isFollowing ? 'btn-ghost' : 'btn-primary'}" data-quick-follow="${u.id}" data-following="${isFollowing}">
      ${isFollowing ? 'Following' : 'Follow'}
    </button>
    <button class="btn btn-sm btn-ghost" data-message-user="${u.id}" data-message-username="${escapeHTML(u.username || '')}" data-message-name="${escapeHTML(u.name || 'User')}">Message</button>
  </div>`;
}

document.getElementById('searchResults').addEventListener('click', async (e) => {
  const gotoProfile = e.target.closest('[data-goto-profile]');
  const msgBtn = e.target.closest('[data-message-user]');
  const followBtn = e.target.closest('[data-quick-follow]');

  if (followBtn) {
    const uid = followBtn.dataset.quickFollow;
    const isFollowing = followBtn.dataset.following === 'true';
    followBtn.disabled = true;
    showLoader();
    try {
      const docRef = db.collection('follows').doc(`${state.me.uid}_${uid}`);
      if (isFollowing) {
        await docRef.delete();
        state.followingUserIds.delete(uid);
      } else {
        await docRef.set({ followerId: state.me.uid, followingId: uid, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
        state.followingUserIds.add(uid);
      }
      performSearch(document.getElementById('searchInput').value);
    } catch (err) { toast(err.message); }
    finally { hideLoader(); }
    return;
  }

  if (gotoProfile) return showProfile(gotoProfile.dataset.gotoProfile);
  if (msgBtn) {
    showView('chat', { keepActiveChat: true });
    openChatWith({ id: msgBtn.dataset.messageUser, username: msgBtn.dataset.messageUsername, name: msgBtn.dataset.messageName });
  }
});

/* ==================================================================
   PROFILE (IMAGE 2: EXACT LAYOUT, NOTE BUBBLE, PRIVATE ACCOUNT LOCK)
   ================================================================== */
window.switchProfileTab = function(tabName) {
  const btn = document.querySelector(`.insta-tab-btn[data-tab="${tabName}"]`);
  if (btn) btn.click();
};

// Open single Post / Reel from Profile Grid without background auto-playing
window.openProfilePostViewer = async function(postId) {
  window.pauseAllMediaEverywhere();
  let post = (state.allPostsCache || []).find(p => p.id === postId) || (state.feedPostsCache || []).find(p => p.id === postId) || (state.reelsCache || []).find(p => p.id === postId);
  if (!post) {
    try {
      const rawData = await fetchSingleDocViaRest('posts', postId) ||
        (db ? await db.collection('posts').doc(postId).get().then(d => d.exists ? d.data() : null).catch(() => null) : null);
      if (rawData) {
        post = normalizePostDocData(postId, rawData);
      }
    } catch (e) {}
  }
  if (!post) return toast('Post not found.');

  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal" style="max-width:500px;padding:0;overflow:hidden;">
      <div class="row between" style="padding:12px 16px;border-bottom:1px solid var(--line-soft);">
        <b style="font-size:15px;">${post.isReel || post.hasVideo || post.video ? '🎬 Reel' : '📷 Post'}</b>
        <button class="btn btn-icon btn-ghost" id="closePostViewerBtn">✕</button>
      </div>
      <div style="max-height:80dvh;overflow-y:auto;" id="postViewerContainer">
        ${postHTML(post)}
      </div>
    </div>`;
  document.body.appendChild(overlay);

  const close = () => {
    window.pauseAllMediaEverywhere();
    overlay.remove();
  };
  overlay.querySelector('#closePostViewerBtn').onclick = close;
  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

  await hydrateVideoElements(overlay);
  const modalVid = overlay.querySelector('video.post-video');
  if (modalVid) {
    window.autoPlaySingleVideoWithAudio(modalVid);
  }
  recordUniqueView(post.id);
};

async function showProfile(username) {
  // IMMEDIATELY PAUSE ALL VIDEOS & MUSIC SO NOTHING PLAYS ON PROFILE PAGE!
  window.pauseAllMediaEverywhere();
  showView('profile', { title: 'Profile' });
  const box = document.getElementById('profileContent');
  box.innerHTML = '<div class="empty">Loading profile…</div>';

  try {
    const cleanUsername = (username || '').startsWith('@') ? username.slice(1).toLowerCase() : (username || '').toLowerCase();
    const userSnap = await db.collection('users').where('username', '==', cleanUsername).limit(1).get();
    if (userSnap.empty) throw new Error('User not found.');
    const uDoc = userSnap.docs[0];
    const u = { id: uDoc.id, uid: uDoc.id, ...uDoc.data() };
    state.userCache.set(u.id, u);
    const isMe = u.id === state.me.uid;

    const [followersSnap, followingSnap, followDoc, blockDoc, noteDoc] = await Promise.all([
      db.collection('follows').where('followingId', '==', u.id).get().catch(() => ({ size: 0 })),
      db.collection('follows').where('followerId', '==', u.id).get().catch(() => ({ size: 0 })),
      !isMe ? db.collection('follows').doc(`${state.me.uid}_${u.id}`).get().catch(() => ({ exists: false })) : Promise.resolve({ exists: false }),
      !isMe ? db.collection('blocks').doc(`${state.me.uid}_${u.id}`).get().catch(() => ({ exists: false })) : Promise.resolve({ exists: false }),
      db.collection('notes').doc(u.id).get().catch(() => ({ exists: false }))
    ]);

    const followersCount = followersSnap.size || 0;
    const followingCount = followingSnap.size || 0;
    const isFollowing = !!followDoc?.exists;
    const isBlocked = !!blockDoc?.exists;
    if (isFollowing) state.followingUserIds.add(u.id);

    u.followersCount = followersCount;
    u.followingCount = followingCount;

    const activeNoteText = (noteDoc && noteDoc.exists && noteDoc.data()?.text)
      ? noteDoc.data().text
      : (u.mood || (isMe ? 'Obsessed with...' : ''));

    // STRICT PRIVACY LOGIC:
    // - If account is Private: only followers (and self) can see their Posts & Reels.
    // - If account is Public: everyone can see their Reels & Posts!
    const isTargetPrivate = isAccountPrivate(u.id, u);
    const canViewPosts = isMe || !isTargetPrivate || isFollowing;

    let posts = [];
    let totalAccountViews = 0;
    let totalAccountLikes = 0;

    if (canViewPosts) {
      const [restRes, sdkRes] = await Promise.allSettled([
        fetchPostsViaRest(120),
        db.collection('posts').where('userId', '==', u.id).get()
      ]);
      const restUserPosts = (restRes.status === 'fulfilled' && Array.isArray(restRes.value))
        ? restRes.value
            .filter(d => d && (d.userId === u.id || d.author?.id === u.id || (d.author?.username || '').toLowerCase() === cleanUsername))
            .map(d => normalizePostDocData(d.id, d))
            .filter(Boolean)
        : [];
      const sdkUserPosts = (sdkRes.status === 'fulfilled' && sdkRes.value && sdkRes.value.docs)
        ? sdkRes.value.docs.map(doc => normalizePostDocData(doc.id, doc.data())).filter(Boolean)
        : [];

      posts = mergeNormalizedPosts(restUserPosts, sdkUserPosts).filter(d => {
        return !d.isStory && d.mediaType !== 'STORY' && !d.isVideoChunk;
      });
      posts.forEach(p => {
        totalAccountViews += Number(p.viewsCount) || 0;
        totalAccountLikes += Number(p.likeCount) || 0;
      });
      posts.sort((a, b) => {
        if (!!b.isPinned !== !!a.isPinned) return b.isPinned ? 1 : -1;
        return new Date(b.createdAt) - new Date(a.createdAt);
      });
    }

    const mediaPosts = posts.filter(p => !!(p.image || p.video || p.videoKey || p.posterImage || p.hasVideo || p.isReel || p.mediaType === 'REEL'));

    box.innerHTML = `
      <!-- Top Bar (Image 2: + on left, Lock + username v, Menu on right) -->
      <div class="profile-top-header">
        <div class="row gap-12">
          <button class="topbar-icon-btn" onclick="openCreateReelModal()" title="Create Post, Reel or Story" style="width:34px;height:34px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <div class="profile-top-handle">
            ${isTargetPrivate ? '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>' : ''}
            <span>${escapeHTML(u.username || 'user')}</span>
            <span style="font-size:13px;opacity:.75;">⌄</span>
            ${isMe ? '<span style="width:8px;height:8px;border-radius:50%;background:#ff3040;display:inline-block;"></span>' : ''}
          </div>
        </div>
        <div class="row gap-6">
          ${isMe ? `
            <button class="topbar-icon-btn" id="instaSettingsTriggerBtn" title="Settings & Menu">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
          ` : ''}
        </div>
      </div>

      <!-- Profile Header Card (Image 2) -->
      <div class="insta-profile-card">
        <div class="insta-profile-top">
          <div class="insta-avatar-col" id="profileAvatarTrigger">
            ${activeNoteText ? `
              <div class="profile-note-bubble" onclick="${isMe ? 'openCreateNoteModal()' : ''}" title="${escapeHTML(activeNoteText)}">
                ${escapeHTML(activeNoteText)}
              </div>
            ` : ''}
            <div style="position:relative;width:84px;height:84px;cursor:pointer;" onclick="${isMe ? 'openStoryUploadPicker()' : ''}">
              ${avatarHTML(u, 'lg')}
              ${isMe ? '<span class="story-add-badge">+</span>' : ''}
            </div>
          </div>
          <div style="flex:1;min-width:0;">
            <div class="insta-bio-name" style="margin-bottom:10px;font-size:15px;">
              ${escapeHTML(u.name || u.username || 'User')} ${premiumBadgeHTML(u)}
            </div>
            <div class="insta-stats-col" style="justify-content:space-between;max-width:260px;">
              <div class="insta-stat-item" style="padding-left:0;"><span class="insta-stat-num">${canViewPosts ? posts.length : '-'}</span><span class="insta-stat-lbl">posts</span></div>
              <div class="insta-stat-item" id="statFollowersBtn"><span class="insta-stat-num">${followersCount}</span><span class="insta-stat-lbl">followers</span></div>
              <div class="insta-stat-item" id="statFollowingBtn"><span class="insta-stat-num">${followingCount}</span><span class="insta-stat-lbl">following</span></div>
            </div>
          </div>
        </div>

        <div class="insta-bio-block">
          ${u.category ? `<div class="insta-bio-category">${escapeHTML(u.category)} ${u.pronouns ? '· ' + escapeHTML(u.pronouns) : ''}</div>` : ''}
          <div class="insta-bio-text">${escapeHTML(u.bio || (isMe ? '✨ Welcome to Your Day' : ''))}</div>
          ${u.website ? `<a class="insta-bio-link" href="${escapeHTML(u.website.startsWith('http') ? u.website : 'https://' + u.website)}" target="_blank">🔗 ${escapeHTML(u.website)}</a>` : ''}
          ${isMe ? `
            <div style="margin-top:6px;">
              <button type="button" onclick="document.getElementById('editProfileBtn')?.click()" style="background:none;border:none;color:var(--paper);font-size:12.5px;font-weight:600;padding:0;cursor:pointer;display:inline-flex;align-items:center;gap:4px;">
                <span style="color:var(--paper-dim);">+</span> Add banners
              </button>
            </div>
          ` : ''}
        </div>

        <div class="insta-actions-row">
          ${isMe ? `
            <button class="insta-btn" id="editProfileBtn">Edit profile</button>
            <button class="insta-btn" id="shareProfileBtn">Share profile</button>
            <button class="insta-btn icon-only" onclick="showView('search')" title="Discover People">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            </button>
          ` : `
            <button class="insta-btn ${isFollowing ? '' : 'primary'}" id="followBtn" data-uid="${u.id}" data-following="${isFollowing}">${isFollowing ? 'Following' : 'Follow'}</button>
            <button class="insta-btn" id="msgProfileBtn" data-uid="${u.id}" data-uname="${escapeHTML(u.username || '')}" data-name="${escapeHTML(u.name || 'User')}">Message</button>
            <button class="insta-btn icon-only" id="blockBtn" data-uid="${u.id}" data-blocked="${isBlocked}" title="Block User">🚫</button>
          `}
        </div>
      </div>

      <!-- Profile Tabs (Image 2: Grid icon, Reels icon, Saved/Tagged icon) -->
      <div class="insta-profile-tabs">
        <button class="insta-tab-btn active" data-tab="grid" title="Posts">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        </button>
        <button class="insta-tab-btn" data-tab="reels" title="Reels">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><polygon points="10 9 16 12.5 10 16 10 9" fill="currentColor"/></svg>
        </button>
        <button class="insta-tab-btn" data-tab="saved" title="Saved & Tagged">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        </button>
      </div>

      <div id="profileTabContent"></div>
    `;

    const tabContent = document.getElementById('profileTabContent');

    // STATIC THUMBNAIL RENDERER FOR PROFILE GRID (NEVER AUTO-PLAYS VIDEOS ON PROFILE!)
    const renderStaticGridCells = (items) => {
      if (!items.length) {
        tabContent.innerHTML = `
          <div class="empty" style="padding:54px 20px;">
            <div style="width:76px;height:76px;margin:0 auto 14px;border-radius:18px;background:#161616;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:34px;">🖼️</div>
            <div style="font-size:17px;font-weight:800;color:var(--paper);">${isMe ? 'Create your first post' : 'No posts yet'}</div>
            <div style="font-size:13.5px;color:var(--paper-dim);margin-top:4px;">${isMe ? 'Give this space some love.' : 'When they share photos or reels, they will appear here.'}</div>
            ${isMe ? `<button class="btn btn-primary btn-sm" style="margin-top:16px;" onclick="openCreateReelModal()">+ Create</button>` : ''}
          </div>`;
        return;
      }
      tabContent.innerHTML = `
        <div class="insta-photo-grid">
          ${items.map(p => {
            const isVid = !!(p.video || p.videoKey || p.hasVideo || p.isReel);
            const thumbSrc = p.posterImage || p.image || '';
            const filterStyle = p.filterCss && p.filterCss !== 'none' ? `style="filter:${escapeHTML(p.filterCss)};"` : '';
            const uniqueViews = Array.isArray(p.viewedBy) ? new Set(p.viewedBy.filter(Boolean)).size : (p.viewsCount || 1);
            return `
              <div class="insta-grid-cell" onclick="window.openProfilePostViewer('${p.id}')">
                ${p.isPinned ? '<span class="grid-badge-pin">📌</span>' : ''}
                ${isVid ? `<span class="grid-badge-top-right">🎬</span>` : ''}
                ${thumbSrc ? `
                  <img src="${thumbSrc}" ${filterStyle} alt="Post" loading="lazy">
                ` : (isVid ? `
                  <video data-post-doc-id="${p.id}" data-chunk-count="${p.videoChunkCount || 0}" ${p.video ? `src="${p.video}"` : ''} ${p.videoKey ? `data-video-key="${escapeHTML(p.videoKey)}"` : ''} ${filterStyle} preload="metadata" muted playsinline></video>
                ` : `
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:10px;text-align:center;font-size:12px;">${escapeHTML((p.content || '').slice(0, 60))}</div>
                `)}
                <div class="explore-tile-views">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>${formatCompactCount(uniqueViews)}</span>
                </div>
                <div class="cell-overlay">
                  <span>❤️ ${p.likeCount || 0}</span>
                  <span>👁️ ${uniqueViews}</span>
                  <span>💬 ${p.commentCount || 0}</span>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
      hydrateVideoElements(tabContent);
    };

    if (!canViewPosts) {
      tabContent.innerHTML = `
        <div class="empty" style="padding:48px 20px;">
          <div style="font-size:40px;margin-bottom:8px;">🔒</div>
          <div style="font-size:18px;font-weight:700;color:var(--paper);">This Account is Private</div>
          <p class="muted" style="margin:8px auto 16px;max-width:300px;font-size:13.5px;">Follow @${escapeHTML(u.username)} to see their stories, reels, and photos.</p>
          <button class="btn btn-primary" id="lockedFollowBtn">Follow @${escapeHTML(u.username)}</button>
        </div>`;
      document.getElementById('lockedFollowBtn')?.addEventListener('click', () => document.getElementById('followBtn')?.click());
    } else {
      renderStaticGridCells(mediaPosts.length ? mediaPosts : posts);
    }

    document.querySelectorAll('.insta-tab-btn').forEach(btn => {
      btn.onclick = async () => {
        if (!canViewPosts) return;
        window.pauseAllMediaEverywhere();
        document.querySelectorAll('.insta-tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const tab = btn.dataset.tab;
        if (tab === 'grid') {
          renderStaticGridCells(mediaPosts.length ? mediaPosts : posts);
        }
        if (tab === 'reels') {
          const reelPosts = posts.filter(p => p.video || p.videoKey || p.hasVideo || p.isReel);
          renderStaticGridCells(reelPosts);
        }
        if (tab === 'saved') {
          if (!isMe) {
            renderStaticGridCells(mediaPosts.length ? mediaPosts : posts);
            return;
          }
          try {
            const bSnap = await db.collection('bookmarks').where('userId', '==', state.me.uid).get();
            const postIds = bSnap.docs.map(d => d.data().postId);
            if (!postIds.length) {
              tabContent.innerHTML = '<div class="empty" style="padding:48px 20px;">No saved posts yet.</div>';
            } else {
              const docs = await Promise.all(postIds.map(pid => db.collection('posts').doc(pid).get()));
              const savedPosts = docs.filter(d => d.exists).map(d => normalizePostDocData(d.id, d.data()));
              renderStaticGridCells(savedPosts);
            }
          } catch (e) {
            tabContent.innerHTML = `<div class="empty">${escapeHTML(e.message)}</div>`;
          }
        }
      };
    });

    document.getElementById('statFollowersBtn').addEventListener('click', () => showUsersModal(`@${u.username}'s Followers`, 'followingId', u.id));
    document.getElementById('statFollowingBtn').addEventListener('click', () => showUsersModal(`@${u.username}'s Following`, 'followerId', u.id));

    if (isMe) {
      document.getElementById('editProfileBtn').onclick = () => {
        if (typeof openEditProfileModal === 'function') openEditProfileModal(u);
        else openEditProfile(u);
      };
      document.getElementById('shareProfileBtn').onclick = () => {
        navigator.clipboard?.writeText(window.location.href);
        toast('Profile link copied! 🔗');
      };
      document.getElementById('instaSettingsTriggerBtn')?.addEventListener('click', openInstagramSettingsDrawer);
    } else {
      document.getElementById('followBtn').addEventListener('click', async (e) => {
        const btn = e.target;
        const following = btn.dataset.following === 'true';
        btn.disabled = true;
        try {
          const docRef = db.collection('follows').doc(`${state.me.uid}_${u.id}`);
          if (following) {
            state.followingUserIds.delete(u.id);
            await docRef.delete();
          } else {
            state.followingUserIds.add(u.id);
            await docRef.set({ followerId: state.me.uid, followingId: u.id, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
          }
          await showProfile(username);
        } catch (err) { toast(err.message); }
        finally { btn.disabled = false; }
      });

      document.getElementById('msgProfileBtn').addEventListener('click', () => {
        showView('chat', { keepActiveChat: true });
        openChatWith({ id: u.id, username: u.username, name: u.name });
      });

      document.getElementById('blockBtn').addEventListener('click', async (e) => {
        const blocked = e.target.dataset.blocked === 'true';
        try {
          const docRef = db.collection('blocks').doc(`${state.me.uid}_${u.id}`);
          if (blocked) await docRef.delete();
          else await docRef.set({ blockerId: state.me.uid, blockedId: u.id, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
          await showProfile(username);
        } catch (err) { toast(err.message); }
      });
    }
  } catch (err) {
    box.innerHTML = `<div class="empty">${escapeHTML(err.message)}</div>`;
  }
}

async function showUsersModal(title, queryField, targetUid) {
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal">
      <h3>${escapeHTML(title)}</h3>
      <div id="usersModalList" style="max-height:360px;overflow-y:auto;"><div class="empty">Loading…</div></div>
      <div class="modal-actions"><button class="btn btn-ghost" id="modalClose">Close</button></div>
    </div>`;
  document.body.appendChild(overlay);
  overlay.querySelector('#modalClose').addEventListener('click', () => overlay.remove());

  try {
    const snap = await db.collection('follows').where(queryField, '==', targetUid).get();
    const otherField = queryField === 'followingId' ? 'followerId' : 'followingId';
    const uids = snap.docs.map(d => d.data()[otherField]);

    if (!uids.length) {
      overlay.querySelector('#usersModalList').innerHTML = '<div class="empty" style="padding:24px;">No users yet.</div>';
      return;
    }

    const users = await getCachedUsersParallel(uids);
    overlay.querySelector('#usersModalList').innerHTML = users.map(u => `
      <div class="user-row">
        ${avatarHTML(u)}
        <div class="who" onclick="document.querySelector('#modalClose').click();showProfile('${escapeHTML(u.username)}')">
          <div class="name">${escapeHTML(u.name || 'User')} ${premiumBadgeHTML(u)}</div>
          <div class="handle mono">@${escapeHTML(u.username)}</div>
        </div>
      </div>
    `).join('');
  } catch (err) {
    overlay.querySelector('#usersModalList').innerHTML = `<div class="empty">${escapeHTML(err.message)}</div>`;
  }
}

function openEditProfile(u) {
  if (typeof openEditProfileModal === 'function') return openEditProfileModal(u);
}

/* ==================================================================
   CHAT, DIRECT MESSAGES & GROUPS (IMAGE 1: NOTES TRAY, LIVE SEARCH,
   BLUE UNREAD DOT, SHARED REELS, DELETE FOR EVERYONE & ME)
   ================================================================== */
state.chatListTab = 'direct';
state.conversationsListCache = [];

window.switchChatListTab = function(tab) {
  state.chatListTab = tab === 'groups' ? 'groups' : 'direct';
  const directBtn = document.getElementById('chatTabDirect');
  const groupsBtn = document.getElementById('chatTabGroups');
  const directList = document.getElementById('convItemsContainer');
  const groupList = document.getElementById('groupItemsContainer');

  if (directBtn) {
    directBtn.classList.toggle('active', state.chatListTab === 'direct');
    directBtn.style.color = state.chatListTab === 'direct' ? 'var(--paper)' : 'var(--paper-dim)';
  }
  if (groupsBtn) {
    groupsBtn.classList.toggle('active', state.chatListTab === 'groups');
    groupsBtn.style.color = state.chatListTab === 'groups' ? 'var(--amber)' : 'var(--amber)';
  }
  if (directList) directList.classList.toggle('hidden', state.chatListTab !== 'direct');
  if (groupList) groupList.classList.toggle('hidden', state.chatListTab !== 'groups');
};

window.filterConversationsLive = function(rawQuery) {
  state.chatSearchQuery = (rawQuery || '').trim().toLowerCase();
  renderFilteredConversations();
};

function renderFilteredConversations() {
  const container = document.getElementById('convItemsContainer');
  if (!container) return;

  const q = state.chatSearchQuery || '';
  let list = state.conversationsListCache || [];
  if (q) {
    list = list.filter(item => {
      const name = (item.user?.name || '').toLowerCase();
      const uname = (item.user?.username || '').toLowerCase();
      const text = (item.previewText || '').toLowerCase();
      return name.includes(q) || uname.includes(q) || text.includes(q);
    });
  }

  const rowsHtml = list.map(item => {
    const u = item.user;
    const otherId = item.otherId;
    const isUnread = item.unread > 0;
    const timeLabel = item.lastMessage?.createdAt ? timeAgo(item.lastMessage.createdAt) : '';
    const subText = isUnread
      ? `<span style="color:#ffffff;font-weight:700;">${item.unread > 1 ? item.unread + ' new messages' : item.previewText} · ${timeLabel}</span>`
      : `<span>${item.previewText}${timeLabel ? ' · ' + timeLabel : ''}</span>`;
    return `
      <div class="conv-item ${(!state.activeIsGroup && state.activeConvUserId === otherId) ? 'active' : ''}" data-conv-uid="${otherId}" data-conv-uname="${escapeHTML(u.username || '')}" data-conv-name="${escapeHTML(u.name || '')}">
        <div class="avatar-wrap">${avatarHTML(u)}${state.onlineUserIds.has(otherId) ? '<span class="dot online"></span>' : ''}</div>
        <div class="who">
          <div class="name" style="${isUnread ? 'font-weight:800;' : ''}">${escapeHTML(u.name || u.username || 'User')} ${premiumBadgeHTML(u)}</div>
          <div class="last">${subText}</div>
        </div>
        ${isUnread ? `<span class="conv-unread" title="${item.unread} unread"></span>` : ''}
        <span style="color:var(--paper-dim);font-size:18px;opacity:.75;margin-left:4px;">📷</span>
      </div>`;
  });

  // If searching, also show matching users from userCache who don't have an existing thread yet
  if (q) {
    const existingIds = new Set(list.map(x => x.otherId));
    const extraUsers = Array.from(state.userCache.values()).filter(u => {
      if (!u || !u.id || u.id === state.me?.uid || existingIds.has(u.id)) return false;
      return (u.name || '').toLowerCase().includes(q) || (u.username || '').toLowerCase().includes(q);
    });
    extraUsers.forEach(u => {
      rowsHtml.push(`
        <div class="conv-item" data-conv-uid="${u.id}" data-conv-uname="${escapeHTML(u.username || '')}" data-conv-name="${escapeHTML(u.name || '')}">
          <div class="avatar-wrap">${avatarHTML(u)}</div>
          <div class="who">
            <div class="name">${escapeHTML(u.name || u.username || 'User')} ${premiumBadgeHTML(u)}</div>
            <div class="last">@${escapeHTML(u.username || '')} · Tap to message</div>
          </div>
          <span style="color:var(--paper-dim);font-size:18px;opacity:.75;margin-left:4px;">📷</span>
        </div>`);
    });
  }

  if (!rowsHtml.length) {
    container.innerHTML = `
      <div class="empty" style="padding:44px 16px;">
        <div style="font-size:26px;margin-bottom:8px;">💬</div>
        ${q ? `No conversations matching "${escapeHTML(q)}".` : 'No messages yet.<br>Tap the compose icon at top-right to start chatting.'}
      </div>`;
    return;
  }

  container.innerHTML = rowsHtml.join('');
}

async function loadConversations() {
  const container = document.getElementById('convItemsContainer');
  if (!container) return;
  if (state.conversationsUnsub) state.conversationsUnsub();

  const newChatBtn = document.getElementById('newChatBtn');
  if (newChatBtn && !newChatBtn.dataset.bound) {
    newChatBtn.dataset.bound = 'true';
    newChatBtn.addEventListener('click', openNewChatModal);
  }
  const newGroupBtn = document.getElementById('newGroupBtn');
  if (newGroupBtn && !newGroupBtn.dataset.bound) {
    newGroupBtn.dataset.bound = 'true';
    newGroupBtn.addEventListener('click', openNewGroupModal);
  }

  state.conversationsUnsub = db.collection('messages')
    .where('participants', 'array-contains', state.me.uid)
    .onSnapshot(async (snap) => {
      let allMsgs = snap.docs
        .map(d => ({ id: d.id, ...d.data() }))
        .filter(m => !(Array.isArray(m.deletedFor) && m.deletedFor.includes(state.me.uid)) && !m.deletedForEveryone);
      allMsgs.sort((a, b) => toDate(b.createdAt) - toDate(a.createdAt));

      const convMap = new Map();
      let totalUnread = 0;

      for (const m of allMsgs) {
        if (!Array.isArray(m.participants)) continue;
        const otherId = m.participants.find(id => id !== state.me.uid);
        if (!otherId) continue;

        if (!m.isRead && m.receiverId === state.me.uid) totalUnread++;

        if (!convMap.has(otherId)) {
          convMap.set(otherId, { otherId, lastMessage: m, unread: (!m.isRead && m.receiverId === state.me.uid) ? 1 : 0 });
        } else if (!m.isRead && m.receiverId === state.me.uid) {
          convMap.get(otherId).unread++;
        }
      }

      updateChatBadge(totalUnread);

      const otherIds = Array.from(convMap.keys());
      if (otherIds.length) {
        await getCachedUsersParallel(otherIds);
      }

      const items = [];
      for (const [otherId, conv] of convMap.entries()) {
        const u = state.userCache.get(otherId) || { id: otherId, name: 'User', username: 'user' };
        const lm = conv.lastMessage;
        let previewText = '';
        if (lm) {
          if (lm.sharedPost) previewText = lm.sharedPost.isReel ? 'Sent a reel' : 'Sent a post';
          else if (lm.image) previewText = 'Sent a photo';
          else if (lm.voiceNote) previewText = 'Sent a voice message';
          else if (lm.file) previewText = 'Sent a file';
          else previewText = escapeHTML(lm.text || '');
        }
        items.push({
          otherId,
          user: u,
          lastMessage: lm,
          unread: conv.unread,
          previewText
        });
      }
      state.conversationsListCache = items;
      renderFilteredConversations();
    });
}

function updateChatBadge(n) {
  const badge = document.getElementById('chatBadge');
  if (!badge) return;
  if (n > 0) { badge.textContent = n > 9 ? '9+' : n; badge.classList.remove('hidden'); }
  else badge.classList.add('hidden');
}

document.getElementById('convList').addEventListener('click', (e) => {
  const dmItem = e.target.closest('[data-conv-uid]');
  if (dmItem) {
    openChatWith({ id: dmItem.dataset.convUid, username: dmItem.dataset.convUname, name: dmItem.dataset.convName });
    return;
  }
  const grpItem = e.target.closest('[data-group-id]');
  if (grpItem) {
    openGroup(grpItem.dataset.groupId, grpItem.dataset.groupName);
  }
});

async function openNewChatModal() {
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal" style="max-width:440px;">
      <div class="row between" style="margin-bottom:14px;">
        <h3>Start New Chat</h3>
        <button class="btn btn-icon btn-ghost" id="newChatCloseBtn" style="width:34px;height:34px;">✕</button>
      </div>
      <div class="search-box" style="margin-bottom:14px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" id="newChatSearchInput" placeholder="Search by name or @username…">
      </div>
      <label class="field">Suggested People</label>
      <div id="newChatUserList" style="max-height:280px;overflow-y:auto;border:1px solid var(--line);border-radius:14px;padding:4px;background:rgba(0,0,0,.15);">
        <div class="empty" style="padding:24px;">Loading people…</div>
      </div>
    </div>`;
  document.body.appendChild(overlay);

  overlay.querySelector('#newChatCloseBtn').addEventListener('click', () => overlay.remove());
  const listEl = overlay.querySelector('#newChatUserList');

  const renderUsers = async (searchTerm = '') => {
    try {
      const snap = await db.collection('users').limit(50).get();
      let users = snap.docs
        .map(d => {
          const u = { id: d.id, ...d.data() };
          state.userCache.set(d.id, u);
          return u;
        })
        .filter(u => u.id !== state.me.uid);

      const cleanTerm = searchTerm.trim().toLowerCase().replace(/^@/, '');
      if (cleanTerm) {
        users = users.filter(u =>
          (u.name && u.name.toLowerCase().includes(cleanTerm)) ||
          (u.username && u.username.toLowerCase().includes(cleanTerm))
        );
      } else {
        users.sort((a, b) => (state.followingUserIds.has(b.id) ? 1 : 0) - (state.followingUserIds.has(a.id) ? 1 : 0));
      }

      listEl.innerHTML = users.length ? users.map(u => `
        <div class="user-row" style="padding:10px 8px;cursor:pointer;" data-pick-chat="${u.id}">
          ${avatarHTML(u, 'sm')}
          <div class="who">
            <div class="name">${escapeHTML(u.name || u.username || 'User')} ${premiumBadgeHTML(u)}</div>
            <div class="handle mono faint">@${escapeHTML(u.username || '')}</div>
          </div>
          <button class="btn btn-sm btn-primary" style="padding:5px 14px;">Chat</button>
        </div>
      `).join('') : '<div class="empty" style="padding:20px;">No users found.</div>';

      listEl.querySelectorAll('[data-pick-chat]').forEach(el => {
        el.addEventListener('click', () => {
          const uid = el.dataset.pickChat;
          const u = users.find(x => x.id === uid);
          if (u) {
            overlay.remove();
            showView('chat', { keepActiveChat: true });
            window.switchChatListTab('direct');
            openChatWith(u);
          }
        });
      });
    } catch (e) {
      listEl.innerHTML = `<div class="empty">${escapeHTML(e.message)}</div>`;
    }
  };

  renderUsers();
  let deb;
  overlay.querySelector('#newChatSearchInput').addEventListener('input', (e) => {
    clearTimeout(deb);
    deb = setTimeout(() => renderUsers(e.target.value), 150);
  });
}

async function openChatWith(user) {
  state.activeIsGroup = false;
  state.activeGroupId = null;
  state.activeConvUserId = user.id;
  state.activeConvUser = user;
  state.chatAttachedImage = null;
  state.chatAttachedFile = null;
  state.replyingToMessage = null;

  if (state.view !== 'chat') {
    showView('chat', { keepActiveChat: true });
  }
  window.switchChatListTab('direct');

  const convList = document.getElementById('convList');
  const pane = document.getElementById('chatPane');
  if (convList && pane) {
    convList.classList.add('chat-active');
    pane.classList.add('chat-active');
  }

  const container = document.getElementById('convItemsContainer') || convList;
  document.querySelectorAll('.conv-item, .group-list-item').forEach(el => el.classList.remove('active'));
  let existingItem = container.querySelector(`[data-conv-uid="${user.id}"]`);
  if (existingItem) {
    existingItem.classList.add('active');
  } else {
    const tempItem = document.createElement('div');
    tempItem.className = 'conv-item active';
    tempItem.dataset.convUid = user.id;
    tempItem.dataset.convUname = user.username || '';
    tempItem.dataset.convName = user.name || '';
    tempItem.innerHTML = `
      <div class="avatar-wrap">${avatarHTML(user)}${state.onlineUserIds.has(user.id) ? '<span class="dot online"></span>' : ''}</div>
      <div class="who">
        <div class="name">${escapeHTML(user.name || user.username || 'User')} ${premiumBadgeHTML(user)}</div>
        <div class="last faint">💬 Start new chat…</div>
      </div>`;
    container.prepend(tempItem);
  }

  pane.innerHTML = `
    <div class="chat-head">
      <button class="chat-back-btn" id="chatBackBtn" title="Back to conversations">←</button>
      <div class="avatar-wrap">${avatarHTML(user)}<span class="dot ${state.onlineUserIds.has(user.id) ? 'online' : ''}" data-presence-dot="${user.id}"></span></div>
      <div class="who">
        <div class="name" style="cursor:pointer;" id="chatHeadName">${escapeHTML(user.name || user.username || 'User')} ${premiumBadgeHTML(user)}</div>
        <div class="status" data-presence-text="${user.id}">${state.onlineUserIds.has(user.id) ? 'Online' : 'Offline'}</div>
      </div>
      <button class="btn btn-icon btn-ghost" id="chatInfoBtn" title="Contact Info">ℹ</button>
      <button class="btn btn-icon btn-ghost" id="chatSearchBtn" title="Search messages">🔍</button>
      <button class="btn btn-icon" id="callAudioBtn" title="Voice call">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.1-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2.1z"/></svg>
      </button>
      <button class="btn btn-icon" id="callVideoBtn" title="Video call">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
      </button>
    </div>
    <div class="chat-body" id="chatBody"></div>
    <div class="chat-attach-preview hidden" id="chatAttachBar">
      <div class="preview-content" id="chatAttachPreviewContent"></div>
      <button class="btn btn-sm btn-ghost" id="chatAttachCancelBtn">✕ Cancel</button>
    </div>
    <div class="chat-input-row">
      <label class="btn btn-icon btn-ghost" title="Send image" style="cursor:pointer;">
        📷<input type="file" accept="image/*" id="chatPhotoInput" class="hidden">
      </label>
      <label class="btn btn-icon btn-ghost" title="Send document" style="cursor:pointer;">
        📎<input type="file" id="chatDocInput" class="hidden">
      </label>
      <input type="text" id="chatInput" placeholder="Write a message…" autocomplete="off">
      <button class="btn btn-icon btn-ghost" id="chatVoiceMicBtn" title="Record Voice Note" style="font-size:18px;">🎙️</button>
      <button class="btn btn-primary btn-icon" id="chatSendBtn">➤</button>
    </div>`;

  document.getElementById('chatBackBtn').addEventListener('click', () => {
    convList.classList.remove('chat-active');
    pane.classList.remove('chat-active');
  });

  document.getElementById('chatHeadName').addEventListener('click', () => showProfile(user.username));
  document.getElementById('chatInfoBtn').onclick = () => openContactInfoDrawer(user);
  document.getElementById('chatVoiceMicBtn').onclick = startVoiceRecording;
  document.getElementById('chatSearchBtn').onclick = () => {
    const term = prompt('Search messages in this chat:');
    if (!term) return;
    document.querySelectorAll('.bubble').forEach(b => {
      if (b.textContent.toLowerCase().includes(term.toLowerCase())) {
        b.style.outline = '2px solid var(--amber)';
        b.scrollIntoView({ behavior: 'smooth' });
      } else {
        b.style.outline = 'none';
      }
    });
  };

  document.getElementById('callAudioBtn').addEventListener('click', () => startCall(user, 'audio'));
  document.getElementById('callVideoBtn').addEventListener('click', () => startCall(user, 'video'));

  const photoInput = document.getElementById('chatPhotoInput');
  const docInput = document.getElementById('chatDocInput');
  const attachBar = document.getElementById('chatAttachBar');
  const attachContent = document.getElementById('chatAttachPreviewContent');

  photoInput.addEventListener('change', async (e) => {
    if (!e.target.files[0]) return;
    try {
      state.chatAttachedImage = await compressImage(e.target.files[0], 800, 0.78);
      state.chatAttachedFile = null;
      attachContent.innerHTML = `<img src="${state.chatAttachedImage}"><span>Photo ready to send</span>`;
      attachBar.classList.remove('hidden');
    } catch (err) { toast(err.message); }
  });

  docInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    try {
      const data = await readFileAsDataURL(file);
      state.chatAttachedFile = { name: file.name, size: formatFileSize(file.size), data };
      state.chatAttachedImage = null;
      attachContent.innerHTML = `<span>📄 <b>${escapeHTML(file.name)}</b> (${formatFileSize(file.size)}) ready</span>`;
      attachBar.classList.remove('hidden');
    } catch (err) { toast(err.message); }
  });

  document.getElementById('chatAttachCancelBtn').addEventListener('click', () => {
    state.chatAttachedImage = null;
    state.chatAttachedFile = null;
    state.replyingToMessage = null;
    photoInput.value = ''; docInput.value = '';
    attachBar.classList.add('hidden');
  });

  const body = document.getElementById('chatBody');
  body.innerHTML = '<div class="empty">Loading…</div>';

  if (state.chatUnsub) state.chatUnsub();
  if (state.groupChatUnsub) state.groupChatUnsub();

  const chatId = [state.me.uid, user.id].sort().join('_');
  state.chatUnsub = db.collection('messages')
    .where('chatId', '==', chatId)
    .onSnapshot((snap) => {
      let msgs = snap.docs.map(doc => {
        const data = doc.data();
        if (data.receiverId === state.me.uid && !data.isRead) {
          doc.ref.update({ isRead: true }).catch(() => {});
        }
        return {
          id: doc.id,
          ...data,
          created_at: data.createdAt ? toDate(data.createdAt).toISOString() : new Date().toISOString()
        };
      }).filter(m => !(Array.isArray(m.deletedFor) && m.deletedFor.includes(state.me.uid)) && !m.deletedForEveryone);

      msgs.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
      const wasNearBottom = (body.scrollHeight - body.scrollTop - body.clientHeight) < 120;
      body.innerHTML = msgs.length ? msgs.map(m => bubbleHTML(m, false)).join('') : '<div class="empty">No messages yet. Say hello! 👋</div>';
      if (wasNearBottom || msgs.length <= 6) {
        body.scrollTop = body.scrollHeight;
      }
    }, (err) => {
      body.innerHTML = `<div class="empty">${escapeHTML(err.message)}</div>`;
    });

  const input = document.getElementById('chatInput');
  const send = async () => {
    const text = input.value.trim();
    if (!text && !state.chatAttachedImage && !state.chatAttachedFile) return;

    const imgPayload = state.chatAttachedImage;
    const filePayload = state.chatAttachedFile;
    const replyPayload = state.replyingToMessage ? {
      id: state.replyingToMessage.id,
      senderName: state.replyingToMessage.senderName || 'User',
      text: (state.replyingToMessage.text || 'Attachment').slice(0, 80)
    } : null;

    input.value = '';
    state.chatAttachedImage = null;
    state.chatAttachedFile = null;
    state.replyingToMessage = null;
    photoInput.value = ''; docInput.value = '';
    attachBar.classList.add('hidden');

    try {
      await db.collection('messages').add({
        chatId,
        senderId: state.me.uid,
        senderName: state.me.name || state.me.username || 'User',
        receiverId: user.id,
        participants: [state.me.uid, user.id],
        text,
        image: imgPayload || null,
        file: filePayload || null,
        replyTo: replyPayload,
        isRead: false,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
    } catch (err) { toast(err.message); }
  };
  document.getElementById('chatSendBtn').addEventListener('click', send);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });
}

// Open a shared Reel or Post directly when tapped inside a Chat or Group bubble
window.openSharedPostFromChat = async function(postId, isReel) {
  if (!postId) return;
  if (isReel) {
    await showView('reels');
    setTimeout(() => {
      const card = document.querySelector(`.reel-card[data-reel-id="${postId}"]`);
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }, 350);
  } else if (typeof window.openProfilePostViewer === 'function') {
    window.openProfilePostViewer(postId);
  }
};

// Message Delete ("Delete for Everyone" & "Delete for Me") + Reaction + Reply Sheet
window.openMessageActionsMenu = function(msgId, isMine, isGroup = false) {
  if (!msgId) return;
  const colName = isGroup ? 'groupMessages' : 'messages';
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal" style="max-width:340px;padding:14px;text-align:center;">
      <div style="font-weight:800;font-size:14px;margin-bottom:10px;color:var(--muted);">Message Options</div>
      <div style="display:flex;justify-content:center;gap:8px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid var(--line-soft);">
        ${['❤️', '😂', '😮', '😢', '🔥', '👍'].map(em => `
          <button class="btn btn-icon btn-ghost" data-quick-react="${em}" style="font-size:20px;width:38px;height:38px;">${em}</button>
        `).join('')}
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <button class="btn btn-ghost" id="msgActReplyBtn" style="width:100%;justify-content:flex-start;">↩️ Reply to Message</button>
        <button class="btn btn-ghost" id="msgActCopyBtn" style="width:100%;justify-content:flex-start;">📋 Copy Message Text</button>
        <button class="btn btn-ghost" id="msgActDeleteEveryoneBtn" style="width:100%;justify-content:flex-start;color:var(--rose);font-weight:700;">🗑️ Delete for Everyone (Unsend)</button>
        <button class="btn btn-ghost" id="msgActDeleteMeBtn" style="width:100%;justify-content:flex-start;color:var(--amber);font-weight:700;">🙈 Delete for Me</button>
        <button class="btn btn-ghost" id="msgActCancelBtn" style="width:100%;justify-content:center;margin-top:4px;">Cancel</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  const close = () => overlay.remove();
  overlay.querySelector('#msgActCancelBtn').onclick = close;
  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

  overlay.querySelectorAll('[data-quick-react]').forEach(btn => {
    btn.onclick = async () => {
      const em = btn.dataset.quickReact;
      close();
      try {
        await db.collection(colName).doc(msgId).update({
          [`reactions.${em}`]: firebase.firestore.FieldValue.arrayUnion(state.me.uid)
        });
      } catch (e) { toast(e.message); }
    };
  });

  overlay.querySelector('#msgActReplyBtn').onclick = async () => {
    close();
    try {
      const doc = await db.collection(colName).doc(msgId).get();
      if (doc.exists) setReplyToMessage({ id: doc.id, ...doc.data() });
    } catch (e) {}
  };

  overlay.querySelector('#msgActCopyBtn').onclick = async () => {
    close();
    const row = document.querySelector(`.bubble-row[data-msg-id="${msgId}"] .bubble`);
    if (row) {
      navigator.clipboard?.writeText(row.innerText.trim());
      toast('Copied to clipboard 📋');
    }
  };

  // DELETE FOR EVERYONE (Removes message for all participants in Firestore immediately)
  overlay.querySelector('#msgActDeleteEveryoneBtn').onclick = async () => {
    close();
    const row = document.querySelector(`.bubble-row[data-msg-id="${msgId}"]`);
    if (row) row.remove();
    try {
      await db.collection(colName).doc(msgId).delete();
      toast('Message deleted for everyone 🗑️');
    } catch (e) {
      // Fallback if rules require update
      await db.collection(colName).doc(msgId).update({
        deletedForEveryone: true,
        text: '',
        image: null,
        sharedPost: null
      }).catch(() => {});
      toast('Message deleted for everyone 🗑️');
    }
  };

  // DELETE FOR ME (Hides message only from your account via deletedFor array)
  overlay.querySelector('#msgActDeleteMeBtn').onclick = async () => {
    close();
    const row = document.querySelector(`.bubble-row[data-msg-id="${msgId}"]`);
    if (row) row.remove();
    try {
      await db.collection(colName).doc(msgId).update({
        deletedFor: firebase.firestore.FieldValue.arrayUnion(state.me.uid)
      });
      toast('Message deleted for you 🙈');
    } catch (e) {
      toast('Deleted for you');
    }
  };
};

function bubbleHTML(m, isGroup = false) {
  const mine = m.senderId === state.me.uid;
  const ticks = (!isGroup && mine)
    ? (m.isRead ? '<span class="bubble-ticks read" title="Read" style="color:#3897f0;">✓✓</span>' : '<span class="bubble-ticks" title="Delivered">✓✓</span>')
    : '';

  let reactionsHTML = '';
  if (m.reactions) {
    const rx = Object.entries(m.reactions).filter(([_, users]) => users && users.length > 0);
    if (rx.length) {
      reactionsHTML = `<div class="bubble-reactions-row">${rx.map(([em, users]) => `<span class="reaction-pill">${em} ${users.length}</span>`).join('')}</div>`;
    }
  }

  // Quoted Reply Preview inside bubble
  let replyHTML = '';
  if (m.replyTo && m.replyTo.text) {
    replyHTML = `
      <div style="border-left:3px solid var(--amber);padding:4px 8px;margin-bottom:6px;background:rgba(0,0,0,0.18);border-radius:6px;font-size:11.5px;">
        <div style="font-weight:700;color:var(--amber);">${escapeHTML(m.replyTo.senderName || 'Message')}</div>
        <div style="opacity:0.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHTML(m.replyTo.text)}</div>
      </div>`;
  }

  // Instagram Shared Reel / Post Preview Card inside Chat Bubble
  let sharedPostHTML = '';
  if (m.sharedPost && m.sharedPost.id) {
    const sp = m.sharedPost;
    const isReel = !!sp.isReel;
    const thumb = sp.posterImage || sp.image || '';
    const durBadge = sp.videoDuration ? `⏱️ ${Math.min(35, Number(sp.videoDuration)).toFixed(1)}s` : (isReel ? '🎬 REEL' : '📷 POST');
    sharedPostHTML = `
      <div class="chat-shared-reel-card" onclick="event.stopPropagation(); window.openSharedPostFromChat('${escapeHTML(sp.id)}', ${isReel})">
        <div class="chat-shared-reel-head">
          <span>@${escapeHTML(sp.authorUsername || 'creator')}</span>
          <span style="color:#0095f6;">${isReel ? '🎬 Reel' : '📷 Post'}</span>
        </div>
        <div class="chat-shared-reel-media">
          ${thumb ? `<img src="${thumb}" alt="Shared Reel">` : `<div style="font-size:38px;">🎬</div>`}
          ${isReel ? `<div class="chat-shared-reel-play">▶</div>` : ''}
          <span class="chat-shared-reel-badge">${durBadge}</span>
        </div>
        <div class="chat-shared-reel-foot">
          <b>@${escapeHTML(sp.authorUsername || 'creator')}</b> ${escapeHTML(sp.content || (isReel ? 'Tap to watch Reel' : 'Tap to view Post'))}
        </div>
      </div>`;
  }

  return `
  <div class="bubble-row ${mine ? 'me' : 'them'}" data-msg-id="${m.id}">
    <div class="bubble-wrap-outer">
      <div class="bubble-with-actions">
        <div class="bubble" oncontextmenu="event.preventDefault(); window.openMessageActionsMenu('${m.id}', ${mine}, ${isGroup});">
          ${(isGroup && !mine && m.senderName) ? `<div style="font-size:11px;font-weight:800;color:var(--amber);margin-bottom:3px;">${escapeHTML(m.senderName)}</div>` : ''}
          ${replyHTML}
          ${sharedPostHTML}
          ${m.image ? `<img class="chat-bubble-img" src="${m.image}" onclick="openLightbox('${m.image}')">` : ''}
          ${m.voiceNote ? `
            <div class="voice-bubble">
              <button class="voice-play-btn" onclick="const a = new Audio('${m.voiceNote}'); a.play();">▶</button>
              <div class="voice-waveform">
                <span class="waveform-bar" style="height:12px;"></span>
                <span class="waveform-bar active" style="height:22px;"></span>
                <span class="waveform-bar active" style="height:16px;"></span>
                <span class="waveform-bar" style="height:24px;"></span>
                <span class="waveform-bar" style="height:10px;"></span>
                <span class="waveform-bar active" style="height:18px;"></span>
              </div>
              <span style="font-size:11px;font-mono;">${m.duration || 3}s</span>
            </div>
          ` : ''}
          ${m.file ? `<a class="chat-bubble-file" href="${m.file.data}" download="${escapeHTML(m.file.name)}" target="_blank">📄 <span>${escapeHTML(m.file.name)}</span> <small>(${m.file.size})</small> ⬇</a>` : ''}
          ${m.text ? `<div>${escapeHTML(m.text)}</div>` : ''}
        </div>
        <button type="button" class="msg-more-btn" title="Delete or React" onclick="event.stopPropagation(); window.openMessageActionsMenu('${m.id}', ${mine}, ${isGroup});">⋯</button>
      </div>
      ${reactionsHTML}
      <div class="bubble-meta">
        <span>${timeShort(m.created_at)}</span>
        ${ticks}
      </div>
    </div>
  </div>`;
}

/* ==================================================================
   GROUPS (INTEGRATED DIRECTLY INSIDE CHAT PAGE ONLY)
   ================================================================== */
async function loadGroups() {
  const container = document.getElementById('groupItemsContainer');
  if (!container) return;
  if (state.groupUnsub) state.groupUnsub();

  const newGroupBtn = document.getElementById('newGroupBtn');
  if (newGroupBtn && !newGroupBtn.dataset.bound) {
    newGroupBtn.dataset.bound = 'true';
    newGroupBtn.addEventListener('click', openNewGroupModal);
  }

  state.groupUnsub = db.collection('groups')
    .where('members', 'array-contains', state.me.uid)
    .onSnapshot((snap) => {
      let groups = snap.docs.map(d => ({ id: d.id, ...d.data() }));
      groups.sort((a, b) => toDate(b.createdAt) - toDate(a.createdAt));
      state.myGroupsCache = groups;
      container.innerHTML = groups.length ? groups.map(g => `
        <div class="group-list-item ${(state.activeIsGroup && state.activeGroupId === g.id) ? 'active' : ''}" data-group-id="${g.id}" data-group-name="${escapeHTML(g.name)}">
          <div class="group-avatar">${initials(g.name)}</div>
          <div class="who">
            <div class="name">${escapeHTML(g.name)}</div>
            <div class="last faint">👥 ${g.members?.length || 1} members · Group Chat</div>
          </div>
        </div>`).join('') : `<div class="empty" style="padding:48px 16px;">No groups yet.<br>Tap <b>+ Group</b> above to create a group chat.</div>`;
    });
}

async function openGroup(id, name) {
  state.activeIsGroup = true;
  state.activeGroupId = id;
  state.activeConvUserId = null;
  state.chatAttachedImage = null;
  state.chatAttachedFile = null;
  state.replyingToMessage = null;

  if (state.view !== 'chat') {
    showView('chat', { keepActiveChat: true, openGroupsTab: true });
  } else {
    window.switchChatListTab('groups');
  }

  document.querySelectorAll('.conv-item, .group-list-item').forEach(el => {
    el.classList.toggle('active', el.dataset.groupId === id);
  });

  const convList = document.getElementById('convList');
  const pane = document.getElementById('chatPane');
  if (convList && pane) {
    convList.classList.add('chat-active');
    pane.classList.add('chat-active');
  }

  pane.innerHTML = `
    <div class="chat-head">
      <button class="chat-back-btn" id="groupBackBtn" title="Back to conversations">←</button>
      <div class="group-avatar">${initials(name)}</div>
      <div class="who">
        <div class="name">${escapeHTML(name)}</div>
        <div class="status faint" id="groupMemberStatus">👥 Group Chat in Messages</div>
      </div>
      <button class="btn btn-icon btn-ghost" id="groupSettingsBtn" title="Group Settings" style="border-radius:12px;">⚙</button>
    </div>
    <div class="chat-body" id="chatBody"></div>
    <div class="chat-attach-preview hidden" id="chatAttachBar">
      <div class="preview-content" id="chatAttachPreviewContent"></div>
      <button class="btn btn-sm btn-ghost" id="chatAttachCancelBtn">✕ Cancel</button>
    </div>
    <div class="chat-input-row">
      <label class="btn btn-icon btn-ghost" title="Send image to group" style="cursor:pointer;">
        📷<input type="file" accept="image/*" id="groupPhotoInput" class="hidden">
      </label>
      <input type="text" id="groupInput" placeholder="Message ${escapeHTML(name)}…" autocomplete="off">
      <button class="btn btn-primary btn-icon" id="groupSendBtn">➤</button>
    </div>`;

  document.getElementById('groupBackBtn').addEventListener('click', () => {
    convList.classList.remove('chat-active');
    pane.classList.remove('chat-active');
  });

  document.getElementById('groupSettingsBtn').addEventListener('click', () => openGroupSettingsModal(id));

  const groupPhotoInput = document.getElementById('groupPhotoInput');
  const attachBar = document.getElementById('chatAttachBar');
  const attachContent = document.getElementById('chatAttachPreviewContent');

  groupPhotoInput.addEventListener('change', async (e) => {
    if (!e.target.files[0]) return;
    try {
      state.chatAttachedImage = await compressImage(e.target.files[0], 800, 0.78);
      attachContent.innerHTML = `<img src="${state.chatAttachedImage}"><span>Photo ready for group</span>`;
      attachBar.classList.remove('hidden');
    } catch (err) { toast(err.message); }
  });

  document.getElementById('chatAttachCancelBtn').addEventListener('click', () => {
    state.chatAttachedImage = null;
    state.replyingToMessage = null;
    groupPhotoInput.value = '';
    attachBar.classList.add('hidden');
  });

  const body = document.getElementById('chatBody');
  if (state.chatUnsub) state.chatUnsub();
  if (state.groupChatUnsub) state.groupChatUnsub();

  state.groupChatUnsub = db.collection('groupMessages')
    .where('groupId', '==', id)
    .onSnapshot((snap) => {
      let msgs = snap.docs.map(d => {
        const data = d.data();
        return {
          id: d.id,
          ...data,
          created_at: data.createdAt ? toDate(data.createdAt).toISOString() : new Date().toISOString()
        };
      }).filter(m => !(Array.isArray(m.deletedFor) && m.deletedFor.includes(state.me.uid)) && !m.deletedForEveryone);

      msgs.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
      const wasNearBottom = (body.scrollHeight - body.scrollTop - body.clientHeight) < 120;
      body.innerHTML = msgs.length ? msgs.map(m => bubbleHTML(m, true)).join('') : '<div class="empty">No messages in this group yet. Say hello! 👋</div>';
      if (wasNearBottom || msgs.length <= 6) {
        body.scrollTop = body.scrollHeight;
      }
    });

  const input = document.getElementById('groupInput');
  const send = async () => {
    const text = input.value.trim();
    if (!text && !state.chatAttachedImage) return;
    const imgPayload = state.chatAttachedImage;
    const replyPayload = state.replyingToMessage ? {
      id: state.replyingToMessage.id,
      senderName: state.replyingToMessage.senderName || 'User',
      text: (state.replyingToMessage.text || 'Attachment').slice(0, 80)
    } : null;

    input.value = '';
    state.chatAttachedImage = null;
    state.replyingToMessage = null;
    groupPhotoInput.value = '';
    attachBar.classList.add('hidden');

    try {
      await db.collection('groupMessages').add({
        groupId: id,
        senderId: state.me.uid,
        senderName: state.me.name || state.me.username || 'User',
        text,
        image: imgPayload || null,
        replyTo: replyPayload,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
    } catch (err) { toast(err.message); }
  };
  document.getElementById('groupSendBtn').addEventListener('click', send);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });
}

async function openNewGroupModal() {
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal">
      <div class="row between" style="margin-bottom:14px;">
        <h3>New Group in Chat</h3>
        <button class="btn btn-icon btn-ghost" id="groupCloseIconBtn" style="width:34px;height:34px;">✕</button>
      </div>
      <div class="field-group"><label class="field">Group Name</label><input type="text" id="groupNameInput" placeholder="e.g. Best Friends, Creators Squad"></div>
      <label class="field">Add Members</label>
      <input type="text" id="groupMemberSearch" placeholder="Search people by name or @username…" style="margin-bottom:8px;">
      <div class="member-pick" id="memberPickList"><div class="empty" style="padding:16px;">Loading people…</div></div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="groupCancel">Cancel</button>
        <button class="btn btn-primary" id="groupCreate">Create Group</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  const picked = new Map();
  overlay.querySelector('#groupCancel').addEventListener('click', () => overlay.remove());
  overlay.querySelector('#groupCloseIconBtn').addEventListener('click', () => overlay.remove());

  const loadCandidates = async (term = '') => {
    const snap = await db.collection('users').limit(40).get();
    const clean = term.trim().toLowerCase().replace(/^@/, '');
    const users = snap.docs.map(d => ({ id: d.id, ...d.data() })).filter(u => u.id !== state.me.uid && (!clean ||
      (u.username && u.username.toLowerCase().includes(clean)) ||
      (u.name && u.name.toLowerCase().includes(clean))
    ));
    overlay.querySelector('#memberPickList').innerHTML = users.map(u => `
      <label><input type="checkbox" value="${u.id}" data-uname="${escapeHTML(u.name || u.username || 'User')}" ${picked.has(u.id) ? 'checked' : ''}> ${escapeHTML(u.name || u.username || 'User')} <span class="mono faint">@${escapeHTML(u.username || '')}</span></label>
    `).join('') || '<div class="empty" style="padding:16px;">No one found.</div>';
  };
  loadCandidates();

  let deb;
  overlay.querySelector('#groupMemberSearch').addEventListener('input', (e) => {
    clearTimeout(deb);
    deb = setTimeout(() => loadCandidates(e.target.value), 160);
  });

  overlay.querySelector('#memberPickList').addEventListener('change', (e) => {
    if (e.target.type !== 'checkbox') return;
    if (e.target.checked) picked.set(e.target.value, e.target.dataset.uname);
    else picked.delete(e.target.value);
  });

  overlay.querySelector('#groupCreate').addEventListener('click', async () => {
    const name = overlay.querySelector('#groupNameInput').value.trim();
    if (!name) return toast('Give your group a name.');
    try {
      const docRef = await db.collection('groups').add({
        name,
        creatorId: state.me.uid,
        members: [state.me.uid, ...picked.keys()],
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
      overlay.remove();
      window.switchChatListTab('groups');
      openGroup(docRef.id, name);
      toast('Group created in Messages! 👥');
    } catch (err) { toast(err.message); }
  });
}

async function openGroupSettingsModal(groupId) {
  try {
    const gDoc = await db.collection('groups').doc(groupId).get();
    if (!gDoc.exists) throw new Error('Group not found');
    const group = { id: gDoc.id, ...gDoc.data() };
    const isCreator = group.creatorId === state.me.uid;

    const overlay = document.createElement('div');
    overlay.className = 'modal-overlay';
    overlay.innerHTML = `
      <div class="modal" style="max-width:480px;">
        <div class="row between" style="margin-bottom:16px;">
          <h3>Group Settings</h3>
          <button class="btn btn-icon btn-ghost" id="gsCloseBtn" style="width:34px;height:34px;">✕</button>
        </div>
        <div class="field-group">
          <label class="field">Group Name</label>
          <div class="row gap-8">
            <input type="text" id="gsNameInput" value="${escapeHTML(group.name)}">
            <button class="btn btn-sm btn-primary" id="gsSaveNameBtn">Save</button>
          </div>
        </div>
        <div style="margin:18px 0 10px;">
          <label class="field">Members (${group.members?.length || 0})</label>
          <div id="gsMemberList" style="max-height:190px;overflow-y:auto;border:1px solid var(--line);border-radius:14px;padding:6px;background:rgba(0,0,0,.15);">
            <div class="empty" style="padding:14px;">Loading members…</div>
          </div>
        </div>
        <div style="margin-bottom:18px;">
          <label class="field">Add New Members</label>
          <input type="text" id="gsSearchMemberInput" placeholder="Search friends to add…" style="margin-bottom:8px;">
          <div id="gsAddMemberList" style="max-height:160px;overflow-y:auto;border:1px solid var(--line);border-radius:14px;display:none;padding:6px;background:rgba(0,0,0,.15);"></div>
        </div>
        <div style="border-top:1px solid var(--line-soft);padding-top:14px;display:flex;justify-content:space-between;align-items:center;">
          <button class="btn btn-sm btn-danger" id="gsLeaveBtn">Leave Group</button>
          ${isCreator ? `<button class="btn btn-sm btn-danger" id="gsDeleteBtn" style="background:#4a1212;">Delete Group</button>` : ''}
        </div>
      </div>`;
    document.body.appendChild(overlay);

    overlay.querySelector('#gsCloseBtn').addEventListener('click', () => overlay.remove());

    overlay.querySelector('#gsSaveNameBtn').addEventListener('click', async () => {
      const newName = overlay.querySelector('#gsNameInput').value.trim();
      if (!newName) return toast('Name cannot be empty.');
      try {
        await db.collection('groups').doc(groupId).update({ name: newName });
        toast('Group name updated.');
        openGroup(groupId, newName);
      } catch (e) { toast(e.message); }
    });

    const renderMembers = async () => {
      const listEl = overlay.querySelector('#gsMemberList');
      const userList = await getCachedUsersParallel(group.members || []);
      listEl.innerHTML = userList.map(u => `
        <div class="user-row" style="padding:8px 6px;">
          ${avatarHTML(u, 'sm')}
          <div class="who">
            <div class="name" style="font-size:13.5px;">${escapeHTML(u.name || u.username || 'User')} ${u.id === group.creatorId ? '<span class="badge-premium" style="font-size:9px;">👑 Admin</span>' : ''}</div>
            <div class="handle mono" style="font-size:11.5px;">@${escapeHTML(u.username || '')}</div>
          </div>
          ${(isCreator && u.id !== state.me.uid) ? `
            <button class="btn btn-sm btn-danger" data-remove-uid="${u.id}" style="padding:4px 10px;font-size:11.5px;">Remove</button>
          ` : ''}
        </div>
      `).join('') || '<div class="empty">No members found.</div>';

      listEl.querySelectorAll('[data-remove-uid]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const remId = btn.dataset.removeUid;
          try {
            await db.collection('groups').doc(groupId).update({
              members: firebase.firestore.FieldValue.arrayRemove(remId)
            });
            group.members = group.members.filter(m => m !== remId);
            toast('Member removed.');
            renderMembers();
          } catch (e) { toast(e.message); }
        });
      });
    };
    renderMembers();

    let addDeb;
    overlay.querySelector('#gsSearchMemberInput').addEventListener('input', (e) => {
      clearTimeout(addDeb);
      const term = e.target.value.trim().toLowerCase().replace(/^@/, '');
      const addListEl = overlay.querySelector('#gsAddMemberList');
      if (!term) { addListEl.style.display = 'none'; return; }

      addDeb = setTimeout(async () => {
        try {
          const snap = await db.collection('users').limit(40).get();
          const candidates = snap.docs
            .map(d => ({ id: d.id, ...d.data() }))
            .filter(u => !group.members.includes(u.id) && (
              (u.name && u.name.toLowerCase().includes(term)) ||
              (u.username && u.username.toLowerCase().includes(term))
            ));
          addListEl.style.display = 'block';
          addListEl.innerHTML = candidates.length ? candidates.map(u => `
            <div class="user-row" style="padding:8px 6px;">
              ${avatarHTML(u, 'sm')}
              <div class="who">
                <div class="name" style="font-size:13px;">${escapeHTML(u.name || u.username || 'User')}</div>
                <div class="handle mono" style="font-size:11.5px;">@${escapeHTML(u.username || '')}</div>
              </div>
              <button class="btn btn-sm btn-primary" data-add-uid="${u.id}" style="padding:4px 12px;font-size:12px;">+ Add</button>
            </div>
          `).join('') : '<div class="empty" style="padding:10px;">No matching users.</div>';

          addListEl.querySelectorAll('[data-add-uid]').forEach(btn => {
            btn.addEventListener('click', async () => {
              const addUid = btn.dataset.addUid;
              btn.disabled = true;
              try {
                await db.collection('groups').doc(groupId).update({
                  members: firebase.firestore.FieldValue.arrayUnion(addUid)
                });
                group.members.push(addUid);
                toast('Member added!');
                addListEl.style.display = 'none';
                overlay.querySelector('#gsSearchMemberInput').value = '';
                renderMembers();
              } catch (e) { toast(e.message); }
            });
          });
        } catch (e) {}
      }, 160);
    });

    overlay.querySelector('#gsLeaveBtn').addEventListener('click', async () => {
      if (!confirm('Leave this group?')) return;
      try {
        await db.collection('groups').doc(groupId).update({
          members: firebase.firestore.FieldValue.arrayRemove(state.me.uid)
        });
        toast('Left group.');
        overlay.remove();
        document.getElementById('chatPane').innerHTML = '<div class="empty-chat">Select a direct chat or group from the left.</div>';
      } catch (e) { toast(e.message); }
    });

    const delBtn = overlay.querySelector('#gsDeleteBtn');
    if (delBtn) {
      delBtn.addEventListener('click', async () => {
        if (!confirm('Permanently delete this group?')) return;
        try {
          await db.collection('groups').doc(groupId).delete();
          toast('Group deleted.');
          overlay.remove();
          document.getElementById('chatPane').innerHTML = '<div class="empty-chat">Select a direct chat or group from the left.</div>';
        } catch (e) { toast(e.message); }
      });
    }
  } catch (err) { toast(err.message); }
}

/* ==================================================================
   SETTINGS (35+ WORKING INSTAGRAM & WHATSAPP PRO SETTINGS ENGINE)
   ================================================================== */
const ALL_SETTING_IDS = [
  'setPrivateAccount', 'setShowOnlineStatus', 'setShowLastSeen', 'setHideLikeCounts',
  'setSearchableProfile', 'setShowNotesStatus', 'setReadReceipts', 'setTypingIndicator',
  'setEnterToSend', 'setChatWallpaper', 'setLowDataCalls', 'setAllowMessages',
  'setAllowComments', 'setStoryReplies', 'setAllowReshare', 'setDoubleTapLike',
  'setFontScale', 'setCompactFeed', 'setHighContrast', 'setTurboMode',
  'setAutoPlayVideos', 'setStartVideosUnmuted', 'setLoopReels', 'setDataSaver',
  'setHdUploads', 'setQuietMode', 'setSoundEffects', 'setHapticFeedback',
  'setMusicVolume', 'setVipGlow'
];

async function saveUserSetting(key, value) {
  if (!state.me) return;
  if (!state.me.settings) state.me.settings = { ...DEFAULT_SETTINGS };
  state.me.settings[key] = value;
  if (key === 'privateAccount') {
    state.me.isPrivate = !!value;
    if (state.userCache) state.userCache.set(state.me.uid, state.me);
  }
  applyAllVisualSettings(state.me.settings);
  try {
    localStorage.setItem('ydd_settings_' + state.me.uid, JSON.stringify(state.me.settings));
    const updatePayload = { [`settings.${key}`]: value };
    if (key === 'privateAccount') updatePayload.isPrivate = !!value;
    await db.collection('users').doc(state.me.uid).update(updatePayload);
  } catch (e) {}
}

async function loadSettings() {
  try {
    let settings = { ...DEFAULT_SETTINGS, ...(state.me?.settings || {}) };
    try {
      const localSaved = JSON.parse(localStorage.getItem('ydd_settings_' + state.me?.uid) || 'null');
      if (localSaved) settings = { ...settings, ...localSaved };
    } catch (e) {}

    if (state.me) state.me.settings = settings;
    applyAllVisualSettings(settings);

    // Populate all 35+ controls
    ALL_SETTING_IDS.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const key = el.dataset.setting;
      if (!key) return;
      const val = settings[key] !== undefined ? settings[key] : DEFAULT_SETTINGS[key];
      if (el.type === 'checkbox') el.checked = val !== false && val !== undefined ? !!val : false;
      else el.value = String(val);
    });

    const fontEl = document.getElementById('settingFontFamily');
    if (fontEl && settings.fontFamily) fontEl.value = settings.fontFamily;

    // Highlight active theme & accent color
    const currentTheme = settings.theme || localStorage.getItem('ydd_theme') || 'dark';
    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.theme === currentTheme);
    });
    const currentAccent = settings.accentColor || '#0095f6';
    document.querySelectorAll('.accent-dot').forEach(dot => {
      dot.classList.toggle('active', dot.dataset.accent === currentAccent);
    });

    // Creator milestone status
    const isVip = isUserPremium(state.me);
    const followersCount = typeof state.me?.followersCount === 'number' ? state.me.followersCount : 0;
    const vipDesc = document.getElementById('vipStatusDesc');
    const vipBadge = document.getElementById('vipStatusBadge');
    if (vipDesc && vipBadge) {
      if (isVip) {
        vipDesc.textContent = 'Active: 👑 PRO Creator unlocked! Verified badge & glowing ring active.';
        vipBadge.textContent = '★ PRO CREATOR';
      } else {
        vipDesc.textContent = `${followersCount} / 3 followers to unlock Verified PRO Creator badge.`;
        vipBadge.textContent = `${Math.min(3, followersCount)}/3`;
      }
    }

    // PIN Lock status
    const savedPin = localStorage.getItem('ydd_pin_' + state.me?.uid);
    const pinDesc = document.getElementById('pinLockStatusDesc');
    if (pinDesc) {
      pinDesc.textContent = savedPin ? '🔐 Active: 4-digit PIN lock is protecting your diary' : 'Protect your diary & chats with a 4-digit PIN';
    }

    updateNotifStatusUI();
  } catch (e) {
    console.error('Settings load error:', e);
  }
}

// Live Search Filter across all 35+ settings rows
const settingsSearchInput = document.getElementById('settingsSearchInput');
if (settingsSearchInput) {
  settingsSearchInput.addEventListener('input', (e) => {
    const q = e.target.value.trim().toLowerCase();
    document.querySelectorAll('#view-settings .settings-section').forEach(sec => {
      let visibleCount = 0;
      sec.querySelectorAll('.setting-row').forEach(row => {
        const match = !q || row.textContent.toLowerCase().includes(q);
        row.style.display = match ? 'flex' : 'none';
        if (match) visibleCount++;
      });
      sec.style.display = visibleCount > 0 ? 'block' : 'none';
    });
  });
}

// Bind all switches & selects
ALL_SETTING_IDS.forEach(id => {
  const el = document.getElementById(id);
  if (!el || el.dataset.bound) return;
  el.dataset.bound = 'true';
  el.addEventListener('change', async () => {
    const key = el.dataset.setting;
    const value = el.type === 'checkbox' ? el.checked : el.value;
    triggerHaptic(10);
    await saveUserSetting(key, value);
    if (key === 'chatWallpaper') state.chatWallpaper = value;
    if (key === 'vipGlow') renderRailAvatar();
    toast('Setting saved ✓');
  });
});

// Accent color dots
document.querySelectorAll('.accent-dot').forEach(dot => {
  dot.addEventListener('click', async () => {
    const color = dot.dataset.accent;
    document.querySelectorAll('.accent-dot').forEach(d => d.classList.toggle('active', d === dot));
    triggerHaptic(12);
    await saveUserSetting('accentColor', color);
    toast('Accent color updated 🎨');
  });
});

// Theme buttons
document.querySelectorAll('.theme-btn').forEach(btn => {
