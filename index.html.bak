<!-- Firebase SDKs (v10 compat) -->
<script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js"></script>
<script src="firebase-config.js"></script>

<script>
/* ==================================================================
   GLOBAL THEME & TYPOGRAPHY INIT
   ================================================================== */
const savedTheme = localStorage.getItem('ydd_theme') || 'dark';
applyTheme(savedTheme);

const savedFont = localStorage.getItem('ydd_font');
if (savedFont) {
  document.documentElement.style.setProperty('--diary-font', savedFont);
}

function applyTheme(t) {
  document.body.classList.remove('light-mode', 'gold-mode');
  if (t === 'light') document.body.classList.add('light-mode');
  if (t === 'gold') document.body.classList.add('gold-mode');
  localStorage.setItem('ydd_theme', t);
  document.querySelectorAll('.theme-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.theme === t);
  });
}

/* ==================================================================
   TOP LOADER HELPER
   ================================================================== */
let loaderCount = 0;
function showLoader() {
  loaderCount++;
  const bar = document.getElementById('topProgressBar');
  if (bar) bar.classList.add('loading');
}
function hideLoader() {
  loaderCount = Math.max(0, loaderCount - 1);
  if (loaderCount === 0) {
    const bar = document.getElementById('topProgressBar');
    if (bar) bar.classList.remove('loading');
  }
}

/* ==================================================================
   AUDIO SYNTHESIZER & WHATSAPP NOTIFICATIONS (MOBILE APK / PWA)
   ================================================================== */
// Register Service Worker for Mobile APK / PWA
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js').then((reg) => {
    console.log('Service Worker registered for Mobile APK Notifications:', reg.scope);
  }).catch((err) => {
    console.warn('Service Worker registration note:', err);
  });

  navigator.serviceWorker.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'OPEN_CHAT' && event.data.user) {
      showView('chat');
      openChatWith(event.data.user);
    }
  });
}

/* ==================================================================
   PWA INSTALL TO PHONE CONTROLLER (FIRST-TIME OPEN & INSTALL TO PHONE)
   ================================================================== */
window.deferredPwaPrompt = null;

// Capture beforeinstallprompt event (Chromium, Android, Edge, Samsung Internet)
window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  window.deferredPwaPrompt = e;
  checkAndShowFirstTimeInstall();
});

// App installed successfully event
window.addEventListener('appinstalled', () => {
  localStorage.setItem('ydd_pwa_installed', 'true');
  hideInstallModal();
  toast('Your Day is now installed on your phone! 📱🎉');
});

function isAppStandalone() {
  return window.matchMedia('(display-mode: standalone)').matches ||
         window.navigator.standalone === true ||
         document.referrer.includes('android-app://');
}

function checkAndShowFirstTimeInstall() {
  // If already running as standalone installed phone app, never show prompt
  if (isAppStandalone()) {
    localStorage.setItem('ydd_pwa_installed', 'true');
    return;
  }

  const alreadyInstalled = localStorage.getItem('ydd_pwa_installed') === 'true';
  const dismissedTime = Number(localStorage.getItem('ydd_install_dismissed') || '0');

  if (alreadyInstalled) return;

  // If dismissed within the last 3 days, don't nag
  if (dismissedTime && (Date.now() - dismissedTime < 3 * 24 * 60 * 60 * 1000)) {
    return;
  }

  // Show first-time install modal after smooth 1.2s delay
  setTimeout(() => {
    if (!isAppStandalone()) {
      showInstallModal();
    }
  }, 1200);
}

function showInstallModal() {
  const overlay = document.getElementById('installModalOverlay');
  if (overlay) overlay.classList.remove('hidden');
}

function hideInstallModal() {
  const overlay = document.getElementById('installModalOverlay');
  if (overlay) overlay.classList.add('hidden');
}

async function triggerInstallToPhone() {
  // 1. Android / Chromium with deferred prompt
  if (window.deferredPwaPrompt) {
    try {
      window.deferredPwaPrompt.prompt();
      const choice = await window.deferredPwaPrompt.userChoice;
      if (choice && choice.outcome === 'accepted') {
        localStorage.setItem('ydd_pwa_installed', 'true');
        toast('Installing Your Day to your phone! 📱✨');
        hideInstallModal();
      }
      window.deferredPwaPrompt = null;
      return;
    } catch (e) {
      console.warn('Install prompt error:', e);
    }
  }

  // 2. iOS Safari detection
  const isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
  if (isIos) {
    hideInstallModal();
    const iosOverlay = document.getElementById('iosInstallModalOverlay');
    if (iosOverlay) iosOverlay.classList.remove('hidden');
    return;
  }

  // 3. Fallback for desktop / other browsers
  hideInstallModal();
  toast('📱 In your browser menu (⋮ or Share), tap "Install App" or "Add to Home Screen"');
}

function initPwaInstallHandlers() {
  const installAppBtn = document.getElementById('installAppBtn');
  if (installAppBtn && !installAppBtn.dataset.bound) {
    installAppBtn.dataset.bound = 'true';
    installAppBtn.addEventListener('click', triggerInstallToPhone);
  }

  const installCloseBtn = document.getElementById('installCloseBtn');
  if (installCloseBtn && !installCloseBtn.dataset.bound) {
    installCloseBtn.dataset.bound = 'true';
    installCloseBtn.addEventListener('click', () => {
      localStorage.setItem('ydd_install_dismissed', String(Date.now()));
      hideInstallModal();
    });
  }

  const installDismissBtn = document.getElementById('installDismissBtn');
  if (installDismissBtn && !installDismissBtn.dataset.bound) {
    installDismissBtn.dataset.bound = 'true';
    installDismissBtn.addEventListener('click', () => {
      localStorage.setItem('ydd_install_dismissed', String(Date.now()));
      hideInstallModal();
    });
  }

  const iosCloseBtn = document.getElementById('iosInstallCloseBtn');
  if (iosCloseBtn && !iosCloseBtn.dataset.bound) {
    iosCloseBtn.dataset.bound = 'true';
    iosCloseBtn.addEventListener('click', () => {
      document.getElementById('iosInstallModalOverlay')?.classList.add('hidden');
    });
  }

  const iosGotItBtn = document.getElementById('iosInstallGotItBtn');
  if (iosGotItBtn && !iosGotItBtn.dataset.bound) {
    iosGotItBtn.dataset.bound = 'true';
    iosGotItBtn.addEventListener('click', () => {
      document.getElementById('iosInstallModalOverlay')?.classList.add('hidden');
      localStorage.setItem('ydd_install_dismissed', String(Date.now()));
    });
  }

  const settingsInstallBtn = document.getElementById('settingsInstallBtn');
  if (settingsInstallBtn && !settingsInstallBtn.dataset.bound) {
    settingsInstallBtn.dataset.bound = 'true';
    settingsInstallBtn.addEventListener('click', triggerInstallToPhone);
  }
}

initPwaInstallHandlers();
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initPwaInstallHandlers);
}
setTimeout(checkAndShowFirstTimeInstall, 1200);

let audioCtx = null;
let ringInterval = null;

function getAudioContext() {
  if (!audioCtx) {
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    if (AudioContext) audioCtx = new AudioContext();
  }
  if (audioCtx && audioCtx.state === 'suspended') {
    audioCtx.resume().catch(() => {});
  }
  return audioCtx;
}

function playOutgoingRingTone() {
  if (state.me?.settings?.soundEffects === false) return;
  stopRingTone();
  const ctx = getAudioContext();
  if (!ctx) return;
  const playBeep = () => {
    try {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, ctx.currentTime);
      gain.gain.setValueAtTime(0.08, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 1.2);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 1.2);
    } catch (e) {}
  };
  playBeep();
  ringInterval = setInterval(playBeep, 2800);
}

function playIncomingMelody() {
  if (state.me?.settings?.soundEffects === false) return;
  stopRingTone();
  const ctx = getAudioContext();
  if (!ctx) return;
  const playChime = () => {
    try {
      [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, ctx.currentTime + i * 0.16);
        gain.gain.setValueAtTime(0.12, ctx.currentTime + i * 0.16);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.16 + 0.35);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + i * 0.16);
        osc.stop(ctx.currentTime + i * 0.16 + 0.4);
      });
    } catch (e) {}
  };
  playChime();
  ringInterval = setInterval(playChime, 2500);
}

// WhatsApp-style message arrival chime
function playMessageChime() {
  if (state.me?.settings?.soundEffects === false) return;
  const ctx = getAudioContext();
  if (!ctx) return;
  try {
    const osc1 = ctx.createOscillator();
    const osc2 = ctx.createOscillator();
    const gain = ctx.createGain();
    osc1.type = 'sine';
    osc1.frequency.setValueAtTime(880, ctx.currentTime);
    osc2.type = 'triangle';
    osc2.frequency.setValueAtTime(1318.5, ctx.currentTime + 0.08);
    gain.gain.setValueAtTime(0.12, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
    osc1.connect(gain);
    osc2.connect(gain);
    gain.connect(ctx.destination);
    osc1.start(ctx.currentTime);
    osc1.stop(ctx.currentTime + 0.1);
    osc2.start(ctx.currentTime + 0.08);
    osc2.stop(ctx.currentTime + 0.35);
  } catch (e) {}
}

function stopRingTone() {
  if (ringInterval) {
    clearInterval(ringInterval);
    ringInterval = null;
  }
}

async function requestNotificationPermission() {
  if (!('Notification' in window)) {
    toast('Notifications are not supported in this browser environment.');
    return false;
  }
  try {
    const res = await Notification.requestPermission();
    updateNotifStatusUI();
    if (res === 'granted') {
      toast('WhatsApp-style mobile notifications enabled!');
      playMessageChime();
      showPushNotification('Your Day Diary', {
        body: 'Notifications are active! You will be alerted for messages & calls.',
        tag: 'ydd-welcome'
      });
      return true;
    } else {
      toast('Notification permission was ' + res);
      return false;
    }
  } catch (e) {
    console.warn(e);
    return false;
  }
}

function updateNotifStatusUI() {
  const descEl = document.getElementById('notifStatusDesc');
  const btnEl = document.getElementById('enableNotifBtn');
  if (!descEl || !btnEl) return;
  if (!('Notification' in window)) {
    descEl.textContent = 'Not supported in current browser view.';
    btnEl.disabled = true;
    return;
  }
  if (Notification.permission === 'granted') {
    descEl.textContent = 'Active: Banners, sounds, and vibration alerts enabled.';
    btnEl.textContent = '✓ Active';
    btnEl.classList.remove('btn-primary');
    btnEl.classList.add('btn-ghost');
  } else if (Notification.permission === 'denied') {
    descEl.textContent = 'Blocked in browser/system settings. Please allow in app permissions.';
    btnEl.textContent = 'Blocked';
    btnEl.classList.remove('btn-primary');
    btnEl.classList.add('btn-danger');
  } else {
    descEl.textContent = 'Receive WhatsApp-style banners, chimes, and vibrations.';
    btnEl.textContent = 'Enable Push';
    btnEl.classList.add('btn-primary');
    btnEl.classList.remove('btn-ghost', 'btn-danger');
  }
}

function showPushNotification(title, options = {}) {
  if (!('Notification' in window) || Notification.permission !== 'granted') return;
  const opts = {
    icon: options.icon || './manifest.json',
    badge: options.badge || './manifest.json',
    vibrate: options.vibrate || [200, 100, 200],
    tag: options.tag || 'ydd-notif',
    renotify: true,
    ...options
  };

  if ('serviceWorker' in navigator && navigator.serviceWorker.controller) {
    navigator.serviceWorker.ready.then(reg => {
      reg.showNotification(title, opts).catch(() => {
        try { new Notification(title, opts); } catch (e) {}
      });
    }).catch(() => {
      try { new Notification(title, opts); } catch (e) {}
    });
  } else {
    try { new Notification(title, opts); } catch (e) {}
  }
}

/* ==================================================================
   IMAGE COMPRESSION & FILE HELPERS (UNLIMITED SIZES)
   ================================================================== */
function compressImage(file, maxDimension = 1200, quality = 0.78) {
  return new Promise((resolve, reject) => {
    if (!file || !file.type.startsWith('image/')) {
      return reject(new Error('Please select a valid image file.'));
    }
    const reader = new FileReader();
    reader.onerror = reject;
    reader.onload = (e) => {
      const img = new Image();
      img.onerror = reject;
      img.onload = () => {
        let width = img.width;
        let height = img.height;

        if (width > maxDimension || height > maxDimension) {
          if (width > height) {
            height = Math.round((height * maxDimension) / width);
            width = maxDimension;
          } else {
            width = Math.round((width * maxDimension) / height);
            height = maxDimension;
          }
        }

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        let dataUrl = canvas.toDataURL('image/jpeg', quality);
        if (dataUrl.length > 800000) {
          dataUrl = canvas.toDataURL('image/jpeg', 0.6);
        }
        resolve(dataUrl);
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  });
}

function readFileAsDataURL(file) {
  return new Promise((resolve, reject) => {
    if (file.size > 25 * 1024 * 1024) {
      return reject(new Error('File size should be under 25MB for direct transfer.'));
    }
    const reader = new FileReader();
    reader.onerror = reject;
    reader.onload = () => resolve(reader.result);
    reader.readAsDataURL(file);
  });
}

// Unlimited Blob/File -> Base64 DataURL reader for Cloud Video Chunks (up to 125MB)
function readBlobAsDataURLUnlimited(fileOrBlob) {
  return new Promise((resolve, reject) => {
    if (!fileOrBlob) return reject(new Error('Empty video blob'));
    const reader = new FileReader();
    reader.onerror = () => reject(new Error('Failed to read video blob'));
    reader.onload = () => resolve(reader.result);
    reader.readAsDataURL(fileOrBlob);
  });
}

function formatFileSize(bytes) {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / 1048576).toFixed(1) + ' MB';
}

/* ==================================================================
   LIGHTBOX
   ================================================================== */
function openLightbox(src) {
  const overlay = document.createElement('div');
  overlay.className = 'lightbox-overlay';
  overlay.innerHTML = `<img src="${src}" alt="Fullscreen View">`;
  overlay.addEventListener('click', () => overlay.remove());
  document.body.appendChild(overlay);
}

/* ==================================================================
   FIREBASE INITIALIZATION
   ================================================================== */
let auth = null;
let db = null;

function getFirebaseConfig() {
  if (window.firebaseConfig && window.firebaseConfig.apiKey && window.firebaseConfig.apiKey !== 'YOUR_API_KEY') {
    return window.firebaseConfig;
  }
  const saved = localStorage.getItem('ydd_firebase_config');
  if (saved) {
    try { return JSON.parse(saved); } catch (e) {}
  }
  return null;
}

function initFirebase() {
  const cfg = getFirebaseConfig();
  if (!cfg) return false;
  try {
    // Purge any wedged Firestore offline persistence database from prior multi-account sessions
    // so uncommitted write queues never stall cross-account Reads/Reels/Stories
    try {
      const pid = cfg.projectId || 'your-day-dairy';
      indexedDB.deleteDatabase(`firestore/[DEFAULT]/${pid}/main`);
    } catch (e) {}

    if (!firebase.apps.length) firebase.initializeApp(cfg);
    auth = firebase.auth();
    db = firebase.firestore();
    setupAuthObserver();
    return true;
  } catch (err) {
    console.error('Firebase initialization error:', err);
    toast('Firebase error: ' + err.message);
    return false;
  }
}

/* ==================================================================
   DIRECT FIRESTORE HTTP/2 REST ENGINE (BYPASSES SDK QUEUE BOTTLENECK)
   Guarantees 150ms cross-account Reels, Stories & Parallel Chunk I/O
   ================================================================== */
function getFirestoreRestBaseUrl() {
  const cfg = getFirebaseConfig() || DEFAULT_FIREBASE_CONFIG;
  const pid = cfg.projectId || 'your-day-dairy';
  return `https://firestore.googleapis.com/v1/projects/${pid}/databases/(default)/documents`;
}

function parseFirestoreRestValue(v) {
  if (!v || typeof v !== 'object') return null;
  if ('stringValue' in v) return v.stringValue;
  if ('booleanValue' in v) return Boolean(v.booleanValue);
  if ('integerValue' in v) return Number(v.integerValue);
  if ('doubleValue' in v) return Number(v.doubleValue);
  if ('timestampValue' in v) return v.timestampValue;
  if ('nullValue' in v) return null;
  if ('arrayValue' in v) {
    return Array.isArray(v.arrayValue.values)
      ? v.arrayValue.values.map(parseFirestoreRestValue)
      : [];
  }
  if ('mapValue' in v) {
    const out = {};
    const fields = v.mapValue.fields || {};
    for (const k of Object.keys(fields)) {
      out[k] = parseFirestoreRestValue(fields[k]);
    }
    return out;
  }
  return null;
}

function parseFirestoreRestDoc(docJson) {
  if (!docJson || !docJson.name) return null;
  const parts = docJson.name.split('/');
  const id = parts[parts.length - 1];
  const fields = docJson.fields || {};
  const obj = { id };
  for (const k of Object.keys(fields)) {
    obj[k] = parseFirestoreRestValue(fields[k]);
  }
  if (!obj.createdAt && docJson.createTime) {
    obj.createdAt = docJson.createTime;
  }
  return obj;
}

function toFirestoreRestValue(val) {
  if (val === null || val === undefined) return { nullValue: null };
  if (typeof val === 'boolean') return { booleanValue: val };
  if (typeof val === 'number') {
    return Number.isInteger(val) ? { integerValue: String(val) } : { doubleValue: val };
  }
  if (typeof val === 'string') return { stringValue: val };
  if (Array.isArray(val)) {
    return { arrayValue: { values: val.map(toFirestoreRestValue) } };
  }
  if (typeof val === 'object') {
    const fields = {};
    for (const k of Object.keys(val)) {
      if (val[k] !== undefined) fields[k] = toFirestoreRestValue(val[k]);
    }
    return { mapValue: { fields } };
  }
  return { stringValue: String(val) };
}

async function fetchPostsViaRest(pageSize = 120) {
  try {
    const url = `${getFirestoreRestBaseUrl()}/posts?pageSize=${pageSize}`;
    const res = await fetch(url, { cache: 'no-store' });
    if (!res.ok) return [];
    const data = await res.json();
    if (!Array.isArray(data.documents)) return [];
    return data.documents.map(parseFirestoreRestDoc).filter(Boolean);
  } catch (e) {
    return [];
  }
}

async function fetchSingleDocViaRest(collectionName, docId) {
  if (!collectionName || !docId) return null;
  try {
    const url = `${getFirestoreRestBaseUrl()}/${collectionName}/${encodeURIComponent(docId)}`;
    const res = await fetch(url, { cache: 'no-store' });
    if (!res.ok) return null;
    const data = await res.json();
    return parseFirestoreRestDoc(data);
  } catch (e) {
    return null;
  }
}

async function fetchUsersCacheViaRest(pageSize = 150) {
  try {
    const url = `${getFirestoreRestBaseUrl()}/users?pageSize=${pageSize}`;
    const res = await fetch(url, { cache: 'no-store' });
    if (!res.ok) return [];
    const data = await res.json();
    if (!Array.isArray(data.documents)) return [];
    const users = data.documents.map(parseFirestoreRestDoc).filter(Boolean);
    users.forEach(u => {
      const uid = u.uid || u.id;
      if (uid) state.userCache.set(uid, { ...u, id: uid, uid });
    });
    return users;
  } catch (e) {
    return [];
  }
}

/* ==================================================================
   PRIVACY RULES (STORIES = FOLLOWERS ONLY | REELS = PUBLIC ALL / PRIVATE FOLLOWERS ONLY)
   & AUTO-ADJUST VIDEO SCREEN TO UPLOADED VIDEO DIMENSIONS
   ================================================================== */
function isAccountPrivate(userId, authorObj = null) {
  if (!userId) return false;
  if (state.me && userId === state.me.uid) {
    return !!(state.me.settings?.privateAccount || state.me.isPrivate);
  }
  const cached = state.userCache.get(userId);
  if (cached) {
    if (typeof cached.isPrivate === 'boolean') return cached.isPrivate;
    if (cached.settings && typeof cached.settings.privateAccount === 'boolean') {
      return cached.settings.privateAccount;
    }
  }
  if (authorObj && typeof authorObj.isPrivate === 'boolean') {
    return authorObj.isPrivate;
  }
  return false;
}

// Strict Story Rule: ONLY followers (and the user themselves) can see a user's Story
function canViewerSeeStory(story) {
  if (!story || !state.me) return false;
  const ownerId = story.userId || story.author?.id;
  if (!ownerId) return false;
  if (ownerId === state.me.uid) return true;
  return state.followingUserIds.has(ownerId);
}

// Strict Reel & Post Rule:
// - If creator's ID is Private: ONLY followers (and self) can see their Reels & Posts.
// - If creator's ID is Public: ALL users can see their Reels!
// - If filterMode === 'friends': ONLY followed users' Reels are shown.
function canViewerSeeReelOrPost(post, filterMode = 'all') {
  if (!post || !state.me) return true;
  const ownerId = post.userId || post.author?.id;
  if (!ownerId) return true;
  if (ownerId === state.me.uid) return true;
  const isFollower = state.followingUserIds.has(ownerId);
  if (filterMode === 'friends') {
    return isFollower;
  }
  const isPriv = isAccountPrivate(ownerId, post.author);
  if (isPriv) {
    return isFollower;
  }
  return true;
}

// Adjust Reels & Feed video screen dynamically according to the uploaded video's aspect ratio
window.adjustVideoScreenToUpload = function(vid) {
  if (!vid) return;
  const vw = Number(vid.videoWidth) || 0;
  const vh = Number(vid.videoHeight) || 0;
  if (!vw || !vh) return;
  vid.style.objectFit = 'contain';
  vid.style.background = '#000000';
  const feedBox = vid.closest('.post-media-container');
  if (feedBox) {
    const ratio = vw / vh;
    const clampedRatio = Math.max(0.56, Math.min(1.91, ratio));
    feedBox.style.aspectRatio = `${vw} / ${vh}`;
    if (clampedRatio < 0.8) {
      vid.style.maxHeight = '74dvh';
    } else {
      vid.style.maxHeight = '640px';
    }
  }
  const reelCard = vid.closest('.reel-card');
  if (reelCard) {
    vid.style.width = '100%';
    vid.style.height = '100%';
    vid.style.maxWidth = '100%';
    vid.style.maxHeight = '100%';
    vid.style.objectFit = 'contain';
  }
};

