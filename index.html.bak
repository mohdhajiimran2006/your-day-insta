}

// Hidden Words Filter Modal
document.getElementById('manageHiddenWordsBtn')?.addEventListener('click', async () => {
  const current = state.me?.settings?.hiddenWords || '';
  const next = prompt('Enter comma-separated words or phrases to auto-hide from comments:', current);
