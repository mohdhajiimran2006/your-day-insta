const titles = { feed: 'Home', reels: 'Reels', search: 'Explore', profile: 'Profile', chat: 'Messages', groups: 'Groups', settings: 'Settings' };

document.querySelectorAll('.rail-btn[data-view]').forEach(btn => {
  btn.addEventListener('click', () => {
