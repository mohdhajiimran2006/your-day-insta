    const t = btn.dataset.theme;
    applyTheme(t);
    triggerHaptic(12);
    await saveUserSetting('theme', t);
    toast('Theme updated ✨');
  });
});

// Font Family selector
const settingFontFamilyEl = document.getElementById('settingFontFamily');
if (settingFontFamilyEl) {
